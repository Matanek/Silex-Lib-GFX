use GFX.Canvas
use GFX.Color
use STD.Math

func main() {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "Smoke",
            Math.Vec2(),
            Canvas.TextStyle(size:12.0, color:Color.white())
        )
    })
    let pixels = drawing.rasterize(48, 16).pixels()
    assert(pixels.count() == 48 * 16 * 4)
}
