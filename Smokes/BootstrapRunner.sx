use GFX.Bootstrap

func startup(application:Bootstrap.Application) {
    print("custom runner")
}

func run_once(application:Bootstrap.Application) int {
    application.run_schedule(Bootstrap.Schedule.startup)
    return 42
}

func verify_runner() {
    var application = Bootstrap.Application()
    application.add_system(Bootstrap.Schedule.startup, startup)
    application.with_runner(run_once)
    assert(application.run() == 42)
}

func main() {
    verify_runner()
}

test "replace the default runner" {
    verify_runner()
}
