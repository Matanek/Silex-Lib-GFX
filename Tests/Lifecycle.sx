use GFX.Window
use GFX.Input

test "share and reopen the SDL session" {
    if true {
        var window = Window(Window.Settings(
            title:"Shared runtime",
            hidden:true
        ))
        var input = Input()
        input.update()
        assert(window.id().value != 0)
    }

    if true {
        var input = Input()
        var window = Window(Window.Settings(
            title:"Reopened runtime",
            hidden:true
        ))
        input.update()
        assert(window.id().value != 0)
    }
}
