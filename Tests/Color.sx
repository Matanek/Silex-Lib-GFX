use GFX.Color

test "construct and transform RGBA colors" {
    assert(Color() == Color.rgba(1.0, 1.0, 1.0, 1.0))
    assert(Color(r:0.25, g:0.5, b:0.75) == Color.rgb(0.25, 0.5, 0.75))
    assert(Color.bytes(255, 127, 0) == Color.rgba(1.0, 127.0 / 255.0, 0.0, 1.0))
    assert(Color.bytes(51, 102, 204, 128) == Color.rgba(
        51.0 / 255.0,
        102.0 / 255.0,
        204.0 / 255.0,
        128.0 / 255.0
    ))

    var mutable = Color.black()
    mutable.r = 0.25
    mutable.g = 0.5
    mutable.b = 0.75
    mutable.a = 0.9
    assert(mutable == Color.rgba(0.25, 0.5, 0.75, 0.9))

    let source = Color.rgba(0.0, 0.25, 0.5, 0.75)
    assert(source.with_alpha(0.2) == Color.rgba(0.0, 0.25, 0.5, 0.2))
    assert(source.a == 0.75)

    let start = Color.rgba(0.0, 0.2, 0.4, 0.6)
    let end = Color.rgba(1.0, 0.6, 0.8, 1.0)
    let midpoint = Color.rgba(0.5, 0.4, 0.6, 0.8)
    assert(colors_nearly_equal(start.lerp(end, 0.5), midpoint))
    assert(colors_nearly_equal(start.mix(end, 0.5), midpoint))
    assert(colors_nearly_equal(
        start.lerp(end, 2.0),
        Color.rgba(2.0, 1.0, 1.2, 1.4)
    ))
}

func colors_nearly_equal(left:Color, right:Color) bool {
    return nearly_equal(left.r, right.r) &&
        nearly_equal(left.g, right.g) &&
        nearly_equal(left.b, right.b) &&
        nearly_equal(left.a, right.a)
}

func nearly_equal(left:float, right:float) bool {
    let difference = left - right
    return difference >= -0.000001 && difference <= 0.000001
}

