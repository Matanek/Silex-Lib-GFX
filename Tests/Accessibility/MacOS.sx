    assert(compare(cell, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityColumnIndexRange")) == 0 as uint8)
    assert(compare(root, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityColumnCount")) == 0 as uint8)
    let absent = native_span(cell, "accessibilityRowIndexRange")
    assert(absent[0] == 9223372036854775807 as uint && absent[1] == 0 as uint)
    let retained = object(cell, "retain")
    host.remove()
    let detached = native_span(cell, "accessibilityColumnIndexRange")
    assert(detached[0] == 9223372036854775807 as uint && detached[1] == 0 as uint)
    assert(compare(cell, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityColumnIndexRange")) == 0 as uint8)
    assert(source.requested == 2)
    send_void(retained, selector("release")); send_void(pool, selector("drain"))
}
