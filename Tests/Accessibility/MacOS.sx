use GFX.Accessibility as AX
use GFX.Accessibility.Presentation.Presentation
use Interop.C
use Interop.Boundary
use STD.Text
use STD.Math

class Source:AX.Source {
    var value:str = "Ada"
    var focus:bool = false
    var pressed:int = 0
    var requested:int = 0
    var button_y:float = 24.0
    var root_bounds:AX.Bounds = AX.Bounds(0.0, 0.0, 400.0, 200.0)
    var pending:AX.Change[] = []
    var checked:bool = false
    var second_radio:bool = false
    var amount:float = 12.0
    var enabled:bool = true
    var horizontal:bool = true
    var control_requests:int = 0
    var title_target:str? = "field"
    var field_title:str? = "label"
    var branch_selected:bool = false
    var branch_expanded:bool = false
    var reverse_actions:bool = true
    var branch_requests:int = 0
    var anchor:int = 0
    var cursor:int = 0
    var selection_allowed:bool = true
    var selection_requests:int = 0
    var multiline:bool = false
    var geometry_x:float = 0.0
    var geometry_y:float = 0.0
    var geometry_start:int = -1
    var geometry_length:int = -1
    func text_geometry(id:str) AX.TextGeometry? { if id == "field" { return Geometry(self) } return null }
    func root() str? { return "root" }
    func focused() str? { if self.focus { return "field" } return null }
    func read(id:str) AX.Element? {
        if id == "root" { return AX.Element(id:id, child_count:50000, bounds:self.root_bounds) }
        if id == "button" {
            return AX.Element(id:id, parent:"root", role:AX.Role.button, name:"Apply", actions:[AX.Action.activate],
                bounds:AX.Bounds(12.0, self.button_y, 80.0, 30.0))
        }
        if Text.starts_with(id, "row:") { return AX.Element(id:id, parent:"root", role:AX.Role.text) }
        if id == "field" {
            var actions:AX.Action[] = [AX.Action.focus, AX.Action.set_value]
            if self.selection_allowed { actions.append(AX.Action.set_text_selection) }
            var role = AX.Role.text_field
            if self.multiline { role = AX.Role.text_area }
            return AX.Element(id:id, parent:"root", role:role, name:"Name", value:self.value,
                focused:self.focus, editable:true, enabled:self.enabled, labelled_by:self.field_title,
                selection_anchor:self.anchor, selection_cursor:self.cursor, multiline:self.multiline, actions:actions)
        }
        if id == "label" { return AX.Element(id:id, parent:"root", role:AX.Role.text, name:"Name", labels:self.title_target) }
        if id == "branch" {
            var actions:AX.Action[] = [AX.Action.select, AX.Action.expand]
            if self.reverse_actions { actions.append(AX.Action.deselect); actions.append(AX.Action.collapse) }
            return AX.Element(id:id, parent:"root", role:AX.Role.tree_item, name:"Folder",
                selected:self.branch_selected, expanded:self.branch_expanded, enabled:self.enabled, actions:actions)
        }
        if id == "check" {
            return AX.Element(id:id, parent:"root", role:AX.Role.checkbox, checked:self.checked,
                enabled:self.enabled, actions:[AX.Action.activate])
        }
        if id == "radios" { return AX.Element(id:id, parent:"root", role:AX.Role.radio_group, child_count:2) }
        if id == "radio:0" || id == "radio:1" {
            let selected = (id == "radio:1") == self.second_radio
            return AX.Element(id:id, parent:"radios", role:AX.Role.radio, checked:selected,
                selected:selected, actions:[AX.Action.activate])
        }
        if id == "slider" {
            return AX.Element(id:id, parent:"root", role:AX.Role.slider, number:self.amount,
                minimum:10.0, maximum:20.0, horizontal:self.horizontal, enabled:self.enabled,
                actions:[AX.Action.set_value, AX.Action.increment, AX.Action.decrement])
        }
        return null
    }
    func child(id:str, index:int) str? {
        self.requested++
        if id == "root" && index == 0 { return "button" }
        if id == "root" && index == 49999 { return "field" }
        if id == "root" && index == 1 { return "check" }
        if id == "root" && index == 2 { return "radios" }
        if id == "root" && index == 3 { return "slider" }
        if id == "root" && index == 4 { return "label" }
        if id == "root" && index == 5 { return "branch" }
        if id == "radios" && index == 0 { return "radio:0" }
        if id == "radios" && index == 1 { return "radio:1" }
        if id == "root" && index > 0 && index < 49999 { return "row:$(index)" }
        return null
    }
    func perform(id:str, request:AX.Request) bool {
        // Deliberately permissive: the bridge itself must reject an unannounced
        // operation or a disabled control, even if the source could accept it.
        if id == "check" || id == "slider" || id == "radios" || Text.starts_with(id, "radio:") {
            self.control_requests++
            if id == "check" { self.checked = !self.checked; return true }
            if id == "radio:0" || id == "radio:1" { self.second_radio = id == "radio:1"; return true }
            if id == "slider" {
                var value = self.amount
                if request.action == AX.Action.increment { value += 0.1 }
                if request.action == AX.Action.decrement { value -= 0.1 }
                if let number = request.number { value = number }
                self.amount = Math.clamp(value, 10.0, 20.0)
                return true
            }
            return true
        }
        if id == "branch" {
            self.branch_requests++
            if request.action == AX.Action.select { self.branch_selected = true }
            if request.action == AX.Action.deselect { self.branch_selected = false }
            if request.action == AX.Action.expand { self.branch_expanded = true }
            if request.action == AX.Action.collapse { self.branch_expanded = false }
            return true
        }
        if id == "button" && request.action == AX.Action.activate { self.pressed++; return true }
        if id == "field" && request.action == AX.Action.focus { self.focus = true; return true }
        if id == "field" && request.action == AX.Action.set_text_selection {
            self.selection_requests++; self.anchor = request.anchor; self.cursor = request.cursor
            return true
        }
        if id == "field" && request.action == AX.Action.set_value {
            if let text = request.text { self.value = text; return true }
        }
        return false
    }
    func changes() AX.Change[] { let pending = self.pending; self.pending = []; return pending }
}

let get_class = C.function<func(C.Pointer<uint8>) uint>(library:Boundary.SystemMenu, name:"objc_getClass")
let get_selector = C.function<func(C.Pointer<uint8>) uint>(library:Boundary.SystemMenu, name:"sel_registerName")
let send = C.function<func(uint,uint) uint>(library:Boundary.SystemMenu, name:"objc_msgSend")
let send_cell = C.function<func(uint,uint,int,int) uint>(library:Boundary.SystemMenu, name:"objc_msgSend")
let send_arg = C.function<func(uint,uint,uint) uint>(library:Boundary.SystemMenu, name:"objc_msgSend")
let send_bool = C.function<func(uint,uint) uint8>(library:Boundary.SystemMenu, name:"objc_msgSend")
let set_bool = C.function<func(uint,uint,uint8) void>(library:Boundary.SystemMenu, name:"objc_msgSend")
let set_object = C.function<func(uint,uint,uint) void>(library:Boundary.SystemMenu, name:"objc_msgSend")
let send_void = C.function<func(uint,uint) void>(library:Boundary.SystemMenu, name:"objc_msgSend")
let compare = C.function<func(uint,uint,uint) uint8>(library:Boundary.SystemMenu, name:"objc_msgSend")
let read_double = C.function<func(uint,uint) float64>(library:Boundary.SystemMenu, name:"objc_msgSend")
let make_number = C.function<func(uint,uint,float64) uint>(library:Boundary.SystemMenu, name:"objc_msgSend")
let argument = C.function<func(uint,uint,uint,int) void>(library:Boundary.SystemMenu, name:"objc_msgSend")
func selector(name:str) uint { return get_selector(C.terminated_pointer(name)) }
func object(value:uint, method:str) uint { return send(value, selector(method)) }
func system_class(name:str) uint { return get_class(C.terminated_pointer(name)) }
func native_string(value:str) uint { return send_arg(system_class("NSString"), selector("stringWithUTF8String:"), C.address_bits(C.terminated_pointer(value))) }
func frame(element:uint) float64[4] {
    let method = selector("accessibilityFrameInParentSpace")
    let signature = send_arg(element, selector("methodSignatureForSelector:"), method)
    let invocation = send_arg(system_class("NSInvocation"), selector("invocationWithMethodSignature:"), signature)
    set_object(invocation, selector("setSelector:"), method)
    set_object(invocation, selector("setTarget:"), element)
    send_void(invocation, selector("invoke"))
    var rect:float64[4] = [0.0, 0.0, 0.0, 0.0]
    set_object(invocation, selector("getReturnValue:"), C.address_bits(C.mutable_pointer(rect)))
    return rect
}

func verify_appkit() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = Source()
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let root = host.root_handle()
    let children = object(root, "accessibilityChildren")
    assert(object(children, "count") == 50000 as uint)
    assert(source.requested == 0 && host.peer_count() == 1)
    let snapshot = object(children, "copy")
    assert(snapshot == children && source.requested == 0)
    send_void(snapshot, selector("release"))
    let button = send_arg(children, selector("objectAtIndex:"), 0 as uint)
    let field = send_arg(children, selector("objectAtIndex:"), 49999 as uint)
    assert(source.requested == 2 && host.peer_count() == 3)
    assert(send_arg(children, selector("objectAtIndex:"), 49999 as uint) == field)
    assert(compare(object(field, "accessibilityRole"), selector("isEqualToString:"), native_string("AXTextField")) != 0 as uint8)
    assert(compare(object(button, "accessibilityLabel"), selector("isEqualToString:"), native_string("Apply")) != 0 as uint8)
    assert(object(field, "accessibilityParent") == root)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilityValue:")) != 0 as uint8)
    assert(compare(button, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilityValue:")) == 0 as uint8)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityPerformDelete")) == 0 as uint8)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityFrame")) != 0 as uint8)
    let initial = frame(button)
    assert(initial[0] == 12.0 && initial[1] == 146.0 && initial[2] == 80.0 && initial[3] == 30.0)
    assert(send_bool(button, selector("accessibilityPerformPress")) != 0 as uint8)
    assert(source.pressed == 1)
    set_bool(field, selector("setAccessibilityFocused:"), 1 as uint8)
    assert(source.focus && send_bool(field, selector("isAccessibilityFocused")) != 0 as uint8)
    set_object(field, selector("setAccessibilityValue:"), native_string("Été 👋"))
    assert(source.value == "Été 👋")
    assert(compare(object(field, "accessibilityValue"), selector("isEqualToString:"), native_string("Été 👋")) != 0 as uint8)
    assert(host.synchronize(200.0) && !host.synchronize(200.0))
    source.button_y = 30.0
    source.pending = [AX.Change("button", AX.ChangeKind.bounds)]
    assert(!host.synchronize(200.0))
    let moved = frame(button)
    assert(moved[1] == 140.0)
    // Model an accessibility client retaining native objects past teardown.
    let retained_button = object(button, "retain")
    let retained_children = object(children, "retain")
    host.remove()
    assert(send_bool(button, selector("accessibilityPerformPress")) == 0 as uint8)
    assert(source.pressed == 1 && object(children, "count") == 0 as uint)
    send_void(retained_button, selector("release")); send_void(retained_children, selector("release"))
    send_void(pool, selector("drain"))
}

test "AppKit queries children lazily and invokes the same source without a window" { verify_appkit() }

func verify_attachment() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    // NSView is an unattached object: this creates no NSWindow or presenter.
    let view = object(system_class("NSView"), "new")
    let previous = object(view, "accessibilityChildren")
    let retained = object(previous, "retain")
    let previous_element = send_bool(view, selector("isAccessibilityElement"))
    var source = Source()
    var host = Presentation(source, view, 0 as uint, 200.0, false)
    let roots = object(view, "accessibilityChildren")
    assert(object(roots, "count") == 1 as uint)
    let root = send_arg(roots, selector("objectAtIndex:"), 0 as uint)
    assert(root == host.root_handle() && object(root, "accessibilityParent") == view)
    assert(source.requested == 0)
    host.remove()
    assert(object(object(view, "accessibilityChildren"), "count") == object(previous, "count"))
    assert(send_bool(view, selector("isAccessibilityElement")) == previous_element)
    send_void(retained, selector("release")); send_void(view, selector("release"))
    send_void(pool, selector("drain"))
}

test "AppKit attachment restores the view hierarchy without creating a window" { verify_attachment() }

func verify_controls() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = Source()
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let root = host.root_handle()
    let children = object(root, "accessibilityChildren")
    let check = send_arg(children, selector("objectAtIndex:"), 1 as uint)
    let radios = send_arg(children, selector("objectAtIndex:"), 2 as uint)
    let slider = send_arg(children, selector("objectAtIndex:"), 3 as uint)
    assert(compare(object(check, "accessibilityRole"), selector("isEqualToString:"), native_string("AXCheckBox")) != 0 as uint8)
    assert(read_double(object(check, "accessibilityValue"), selector("doubleValue")) == 0.0)
    assert(send_bool(check, selector("accessibilityPerformPress")) != 0 as uint8 && source.checked)
    assert(read_double(object(check, "accessibilityValue"), selector("doubleValue")) == 1.0)
    assert(compare(object(radios, "accessibilityRole"), selector("isEqualToString:"), native_string("AXRadioGroup")) != 0 as uint8)
    assert(object(radios, "accessibilityOrientation") == 1 as uint)
    let choices = object(radios, "accessibilityChildren")
    let first = send_arg(choices, selector("objectAtIndex:"), 0 as uint)
    let second = send_arg(choices, selector("objectAtIndex:"), 1 as uint)
    assert(object(first, "accessibilityParent") == radios && object(second, "accessibilityParent") == radios)
    assert(compare(object(second, "accessibilityRole"), selector("isEqualToString:"), native_string("AXRadioButton")) != 0 as uint8)
    assert(send_bool(first, selector("isAccessibilitySelected")) != 0 as uint8)
    assert(send_bool(second, selector("accessibilityPerformPress")) != 0 as uint8 && source.second_radio)
    assert(send_bool(second, selector("isAccessibilitySelected")) != 0 as uint8)
    assert(read_double(object(first, "accessibilityValue"), selector("doubleValue")) == 0.0)
    assert(read_double(object(second, "accessibilityValue"), selector("doubleValue")) == 1.0)
    assert(compare(object(slider, "accessibilityRole"), selector("isEqualToString:"), native_string("AXSlider")) != 0 as uint8)
    assert(read_double(object(slider, "accessibilityMinValue"), selector("doubleValue")) == 10.0)
    assert(read_double(object(slider, "accessibilityMaxValue"), selector("doubleValue")) == 20.0)
    assert(compare(slider, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityMinValue")) != 0 as uint8)
    assert(compare(check, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityMinValue")) == 0 as uint8)
    assert(object(check, "accessibilityMinValue") == 0 as uint)
    assert(object(slider, "accessibilityOrientation") == 2 as uint)
    source.horizontal = false
    assert(object(slider, "accessibilityOrientation") == 1 as uint)
    assert(send_bool(slider, selector("accessibilityPerformIncrement")) != 0 as uint8)
    assert(Math.abs(source.amount - 12.1) < 0.001)
    assert(send_bool(slider, selector("accessibilityPerformDecrement")) != 0 as uint8)
    assert(Math.abs(source.amount - 12.0) < 0.001)
    let native_decimal:float64 = 12.1
    set_object(slider, selector("setAccessibilityValue:"), make_number(system_class("NSNumber"), selector("numberWithDouble:"), native_decimal))
    assert(Math.abs(source.amount - 12.1) < 0.001)
    let before_invalid = source.control_requests; let huge:float64 = 1e300; let zero:float64 = 0.0
    set_object(slider, selector("setAccessibilityValue:"), make_number(system_class("NSNumber"), selector("numberWithDouble:"), huge))
    set_object(slider, selector("setAccessibilityValue:"), make_number(system_class("NSNumber"), selector("numberWithDouble:"), zero/zero))
    assert(source.control_requests == before_invalid && Math.abs(source.amount - 12.1) < 0.001)
    set_object(slider, selector("setAccessibilityValue:"), make_number(system_class("NSNumber"), selector("numberWithDouble:"), 100.0))
    assert(source.amount == 20.0)
    assert(read_double(object(slider, "accessibilityValue"), selector("doubleValue")) == 20.0)
    let requests = source.control_requests
    assert(send_bool(radios, selector("accessibilityPerformPress")) == 0 as uint8)
    set_bool(check, selector("setAccessibilityFocused:"), 1 as uint8)
    source.enabled = false
    assert(send_bool(check, selector("isAccessibilityEnabled")) == 0 as uint8)
    assert(compare(check, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityPerformPress")) == 0 as uint8)
    assert(send_bool(check, selector("accessibilityPerformPress")) == 0 as uint8)
    assert(send_bool(slider, selector("accessibilityPerformIncrement")) == 0 as uint8)
    set_object(slider, selector("setAccessibilityValue:"), make_number(system_class("NSNumber"), selector("numberWithDouble:"), 15.0))
    assert(source.control_requests == requests && source.checked && source.amount == 20.0)
    host.remove()
    send_void(pool, selector("drain"))
}

test "AppKit exposes checkbox radio and slider state and rejects disabled or unsupported actions" { verify_controls() }

func verify_relationships() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = Source()
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let children = object(host.root_handle(), "accessibilityChildren")
    let field = send_arg(children, selector("objectAtIndex:"), 49999 as uint)
    // A relation creates only its target peer, never enumerates the container.
    let label = object(field, "accessibilityTitleUIElement")
    assert(label != 0 as uint && source.requested == 1 && host.peer_count() == 3)
    assert(label == send_arg(children, selector("objectAtIndex:"), 4 as uint))
    let targets = object(label, "accessibilityServesAsTitleForUIElements")
    assert(object(targets, "count") == 1 as uint)
    assert(send_arg(targets, selector("objectAtIndex:"), 0 as uint) == field)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityTitleUIElement")) != 0 as uint8)
    source.field_title = "missing"; source.title_target = "missing"
    assert(object(field, "accessibilityTitleUIElement") == 0 as uint)
    assert(object(object(label, "accessibilityServesAsTitleForUIElements"), "count") == 0 as uint)
    assert(host.peer_count() == 3)
    source.field_title = null; source.title_target = null
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityTitleUIElement")) == 0 as uint8)
    source.field_title = "label"; source.title_target = "field"
    assert(object(field, "accessibilityTitleUIElement") == label)
    let retained = object(label, "retain")
    host.remove()
    assert(object(label, "accessibilityServesAsTitleForUIElements") == 0 as uint)
    send_void(retained, selector("release")); send_void(pool, selector("drain"))
}

test "AppKit label relationships preserve target identities and tolerate missing or detached peers" { verify_relationships() }

func verify_selection_expansion() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = Source()
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let children = object(host.root_handle(), "accessibilityChildren")
    let branch = send_arg(children, selector("objectAtIndex:"), 5 as uint)
    assert(compare(branch, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilitySelected:")) != 0 as uint8)
    assert(compare(branch, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilityExpanded:")) != 0 as uint8)
    set_bool(branch, selector("setAccessibilitySelected:"), 1 as uint8)
    set_bool(branch, selector("setAccessibilityExpanded:"), 1 as uint8)
    assert(source.branch_selected && source.branch_expanded && source.branch_requests == 2)
    assert(send_bool(branch, selector("isAccessibilitySelected")) != 0 as uint8)
    assert(send_bool(branch, selector("isAccessibilityExpanded")) != 0 as uint8)
    // Repeating an already reached state must not invoke a permissive source.
    set_bool(branch, selector("setAccessibilitySelected:"), 1 as uint8)
    set_bool(branch, selector("setAccessibilityExpanded:"), 1 as uint8)
    assert(source.branch_requests == 2 && host.synchronize(200.0) && !host.synchronize(200.0))
    source.reverse_actions = false
    set_bool(branch, selector("setAccessibilitySelected:"), 0 as uint8)
    set_bool(branch, selector("setAccessibilityExpanded:"), 0 as uint8)
    assert(source.branch_selected && source.branch_expanded && source.branch_requests == 2)
    source.reverse_actions = true; source.enabled = false
    assert(compare(branch, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilityExpanded:")) == 0 as uint8)
    set_bool(branch, selector("setAccessibilitySelected:"), 0 as uint8)
    set_bool(branch, selector("setAccessibilityExpanded:"), 0 as uint8)
    assert(source.branch_requests == 2)
    source.enabled = true
    set_bool(branch, selector("setAccessibilitySelected:"), 0 as uint8)
    set_bool(branch, selector("setAccessibilityExpanded:"), 0 as uint8)
    assert(!source.branch_selected && !source.branch_expanded && source.branch_requests == 4)
    let field = send_arg(children, selector("objectAtIndex:"), 49999 as uint)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilitySelected:")) == 0 as uint8)
    set_bool(field, selector("setAccessibilitySelected:"), 1 as uint8)
    let retained = object(branch, "retain")
    host.remove()
    set_bool(branch, selector("setAccessibilitySelected:"), 1 as uint8)
    set_bool(branch, selector("setAccessibilityExpanded:"), 1 as uint8)
    assert(source.branch_requests == 4)
    send_void(retained, selector("release")); send_void(pool, selector("drain"))
}

test "AppKit selection and expansion setters dispatch only advertised state transitions" { verify_selection_expansion() }

func native_span(element:uint, name:str) uint[2] {
    let method = selector(name)
    let signature = send_arg(element, selector("methodSignatureForSelector:"), method)
    let invocation = send_arg(system_class("NSInvocation"), selector("invocationWithMethodSignature:"), signature)
    set_object(invocation, selector("setSelector:"), method); set_object(invocation, selector("setTarget:"), element)
    send_void(invocation, selector("invoke"))
    var span:uint[2] = [0, 0]
    set_object(invocation, selector("getReturnValue:"), C.address_bits(C.mutable_pointer(span)))
    return span
}
func selection_span(element:uint) uint[2] { return native_span(element, "accessibilitySelectedTextRange") }
func select_span(element:uint, start:uint, length:uint) {
    let method = selector("setAccessibilitySelectedTextRange:")
    let signature = send_arg(element, selector("methodSignatureForSelector:"), method)
    let invocation = send_arg(system_class("NSInvocation"), selector("invocationWithMethodSignature:"), signature)
    set_object(invocation, selector("setSelector:"), method); set_object(invocation, selector("setTarget:"), element)
    var span:uint[2] = [start, length]
    argument(invocation, selector("setArgument:atIndex:"), C.address_bits(C.mutable_pointer(span)), 2)
    send_void(invocation, selector("invoke"))
}
func verify_text_selection() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = Source()
    source.value = "Aé👩‍💻中Z" // UTF-16 boundaries: 0, 1, 3, 8, 9, 10.
    source.anchor = 4; source.cursor = 1
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let field = send_arg(object(host.root_handle(), "accessibilityChildren"), selector("objectAtIndex:"), 49999 as uint)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilitySelectedTextRange:")) != 0 as uint8)
    assert(object(field, "accessibilityNumberOfCharacters") == 10 as uint)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilitySelectedText:")) == 0 as uint8)
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("accessibilitySelectedTextRanges")) == 0 as uint8)
    let initial = selection_span(field)
    assert(initial[0] == 1 as uint && initial[1] == 8 as uint)
    assert(compare(object(field, "accessibilitySelectedText"), selector("isEqualToString:"), native_string("é👩‍💻中")) != 0 as uint8)
    // Reading and repeating a range preserve an application's reversed anchor.
    select_span(field, 1 as uint, 8 as uint)
    assert(source.anchor == 4 && source.cursor == 1 && source.selection_requests == 0)
    // A partial combining mark / surrogate / ZWJ sequence selects whole graphemes.
    select_span(field, 2 as uint, 3 as uint)
    assert(source.anchor == 1 && source.cursor == 3)
    let whole = selection_span(field)
    assert(whole[0] == 1 as uint && whole[1] == 7 as uint)
    select_span(field, 5 as uint, 0 as uint)
    assert(source.anchor == 2 && source.cursor == 2)
    assert(compare(object(field, "accessibilitySelectedText"), selector("isEqualToString:"), native_string("")) != 0 as uint8)
    assert(host.synchronize(200.0) && !host.synchronize(200.0))
    let requests = source.selection_requests
    select_span(field, 11 as uint, 0 as uint)
    select_span(field, 0 as uint, 18446744073709551615)
    select_span(field, 9223372036854775807 as uint, 0 as uint)
    assert(source.selection_requests == requests)
    source.selection_allowed = false
    assert(compare(field, selector("isAccessibilitySelectorAllowed:"), selector("setAccessibilitySelectedTextRange:")) == 0 as uint8)
    select_span(field, 0 as uint, 1 as uint)
    source.selection_allowed = true; source.enabled = false
    select_span(field, 0 as uint, 1 as uint)
    assert(source.selection_requests == requests)
    source.enabled = true; source.value = ""; source.anchor = 0; source.cursor = 0
    assert(object(field, "accessibilityNumberOfCharacters") == 0 as uint)
    let empty = selection_span(field); assert(empty[0] == 0 as uint && empty[1] == 0 as uint)
    select_span(field, 0 as uint, 1 as uint)
    assert(source.selection_requests == requests)
    let retained = object(field, "retain"); host.remove()
    let detached = selection_span(field)
    assert(detached[0] == 9223372036854775807 as uint && detached[1] == 0 as uint)
    select_span(field, 0 as uint, 0 as uint)
    assert(source.selection_requests == requests)
    send_void(retained, selector("release")); send_void(pool, selector("drain"))
}
test "AppKit text selection translates UTF-16 and complete graphemes without changing reversed anchors" { verify_text_selection() }

func verify_multiline_selection() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = Source(); source.multiline = true; source.value = "A\né👩‍💻"
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let children = object(host.root_handle(), "accessibilityChildren")
    let field = send_arg(children, selector("objectAtIndex:"), 49999 as uint)
    assert(compare(object(field, "accessibilityRole"), selector("isEqualToString:"), native_string("AXTextArea")) != 0 as uint8)
    assert(object(field, "accessibilityNumberOfCharacters") == 9 as uint)
    select_span(field, 1 as uint, 3 as uint)
    assert(source.anchor == 1 && source.cursor == 3)
    assert(compare(object(field, "accessibilitySelectedText"), selector("isEqualToString:"), native_string("\né")) != 0 as uint8)
    source.value = "x"
    let shortened = selection_span(field)
    assert(shortened[0] == 1 as uint && shortened[1] == 0 as uint)
    assert(source.anchor == 1 && source.cursor == 3) // Querying never edits Source.
    source.value = ""
    let empty = selection_span(field)
    assert(empty[0] == 0 as uint && empty[1] == 0 as uint)
    assert(compare(object(field, "accessibilitySelectedText"), selector("isEqualToString:"), native_string("")) != 0 as uint8)
    let button = send_arg(children, selector("objectAtIndex:"), 0 as uint)
    assert(compare(button, selector("isAccessibilitySelectorAllowed:"), selector("accessibilitySelectedTextRange")) == 0 as uint8)
    let absent = selection_span(button)
    assert(absent[0] == 9223372036854775807 as uint && absent[1] == 0 as uint)
    assert(object(button, "accessibilitySelectedText") == 0 as uint)
    host.remove(); send_void(pool, selector("drain"))
}
test "AppKit multiline selection includes line breaks and safely rereads a shortened source" { verify_multiline_selection() }

func verify_geometry() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = Source()
    source.root_bounds = AX.Bounds(40.0, 30.0, 300.0, 120.0)
    var host = Presentation(source, 0 as uint, 0 as uint, 300.0, false)
    let root = host.root_handle()
    let children = object(root, "accessibilityChildren")
    let button = send_arg(children, selector("objectAtIndex:"), 0 as uint)
    let initial = frame(root)
    assert(initial[0] == 40.0 && initial[1] == 150.0)
    let child_frame = frame(button)
    assert(child_frame[0] == -28.0 && child_frame[1] == 96.0)
    assert(!host.synchronize(360.0))
    let resized = frame(root)
    assert(resized[0] == 40.0 && resized[1] == 210.0)
    assert(!host.synchronize(360.0, Math.Vec2(25.0, -12.0)))
    let placed = frame(root)
    assert(placed[0] == 65.0 && placed[1] == 222.0 && placed[2] == 300.0 && placed[3] == 120.0)
    assert(!host.synchronize(400.0)) // Keep the last origin when omitted.
    assert(frame(root)[1] == 262.0)
    assert(frame(button) == child_frame) // Translation belongs to the root only.
    assert(host.root_handle() == root && host.peer_count() == 2 && source.requested == 1)
    assert(source.read("root")!.bounds == source.root_bounds)
    // Source bounds and presentation movement may happen in the same update.
    source.root_bounds = AX.Bounds(10.0, 20.0, 300.0, 120.0)
    source.pending = [AX.Change("root", AX.ChangeKind.bounds), AX.Change("button", AX.ChangeKind.bounds)]
    assert(!host.synchronize(400.0, Math.Vec2(-8.0, 15.0)))
    assert(frame(root)[0] == 2.0 && frame(root)[1] == 245.0)
    assert(frame(button)[0] == 2.0 && frame(button)[1] == 86.0)
    host.remove(); send_void(pool, selector("drain"))
    let flipped_pool = object(system_class("NSAutoreleasePool"), "new")
    var flipped_host = Presentation(source, 0 as uint, 0 as uint, 400.0, true, Math.Vec2(25.0, 12.0))
    let flipped_root = flipped_host.root_handle()
    assert(frame(flipped_root)[0] == 35.0 && frame(flipped_root)[1] == 32.0)
    assert(!flipped_host.synchronize(500.0, Math.Vec2(-4.0, 18.0)))
    assert(frame(flipped_root)[0] == 6.0 && frame(flipped_root)[1] == 38.0)
    flipped_host.remove(); send_void(flipped_pool, selector("drain"))
}
test "AppKit geometry follows host height and origin without double translating descendants" { verify_geometry() }

class Geometry:AX.TextGeometry {
    private var source:Source
    init(source:Source) { self.source = source }
    func bounds(selection:AX.TextRange) AX.Bounds? {
        self.source.geometry_start = selection.start; self.source.geometry_length = selection.length
        return AX.Bounds(20.0,30.0,40.0,15.0)
    }
    func range_at(x:float,y:float) AX.TextRange? {
        self.source.geometry_x = x; self.source.geometry_y = y
        return AX.TextRange(2,1)
    }
    func line_for_index(index:int) int? { if index < 0 || index > 5 { return null } if index < 3 { return 0 } return 1 }
    func range_for_line(line:int) AX.TextRange? { if line == 0 { return AX.TextRange(0,3) } if line == 1 { return AX.TextRange(3,2) } return null }
    func visible_range() AX.TextRange? { return AX.TextRange(1,3) }
}

class CollectionSource:AX.Source {
    var requested:int = 0
    var row_requests:int = 0
    var rows_supported:bool = true
    var row_total:int = 50000
    var column_total:int = 4
    var position:int? = 49999
    var column:int? = 3
    var sorting:bool? = false
    var column_requests:int = 0
    var collection_role:AX.Role = AX.Role.table
    var row_role:AX.Role = AX.Role.row
    var level:int = 1
    func columns(id:str) AX.Columns? {
        if id == "collection" && self.collection_role == AX.Role.table { return CollectionColumns(self) }
        return null
    }
    func rows(id:str) AX.Rows? {
        if id == "collection" && self.rows_supported { return CollectionRows(self) }
        return null
    }
    func root() str? { return "collection" }
    func focused() str? { return null }
    func read(id:str) AX.Element? {
        if id == "collection" {
            return AX.Element(id:id, role:self.collection_role, child_count:self.row_total,
                row_count:self.row_total, column_count:self.column_total)
        }
        if id == "header" { return AX.Element(id:id, parent:"opaque-column", role:AX.Role.column_header, sorted_descending:self.sorting) }
        if id == "opaque-column" {
            return AX.Element(id:id, parent:"collection", role:AX.Role.column, column_index:3, header:"header", sorted_descending:self.sorting)
        }
        if id == "opaque-row" {
            // Sibling position differs from flattened model position in trees.
            return AX.Element(id:id, parent:"collection", role:self.row_role,
                index:2, row_index:self.position, level:self.level, child_count:1)
        }
        if id == "opaque-cell" {
            return AX.Element(id:id, parent:"opaque-row", role:AX.Role.cell,
                index:0, row_index:self.position, column_index:self.column)
        }
        return null
    }
    func child(id:str, index:int) str? {
        self.requested++
        if id == "collection" && index == 0 { return "header" }
        if id == "collection" && index == self.row_total - 1 { return "opaque-row" }
        if id == "opaque-row" && index == 0 { return "opaque-cell" }
        return null
    }
    func perform(id:str, request:AX.Request) bool { return false }
    func changes() AX.Change[] { return [] }
}

class CollectionColumns:AX.Columns {
    private var source:CollectionSource
    init(source:CollectionSource) { self.source = source }
    func count() int { return self.source.column_total }
    func column(index:int) str? {
        self.source.column_requests++
        if index == 3 && index < self.source.column_total { return "opaque-column" }
        return null
    }
}

class CollectionRows:AX.Rows {
    private var source:CollectionSource
    init(source:CollectionSource) { self.source = source }
    func selected() str[] { if self.source.row_total > 0 { return ["opaque-row"] } return [] }
    func count() int { return self.source.row_total }
    func row(index:int) str? {
        self.source.row_requests++
        if index >= 0 && index == self.source.row_total - 1 { return "opaque-row" }
        return null
    }
}

func verify_indexed_rows() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = CollectionSource()
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let root = host.root_handle()
    assert(compare(root, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityRows")) != 0 as uint8)
    let rows = object(root, "accessibilityRows")
    assert(rows != 0 as uint && object(rows, "count") == 50000 as uint)
    assert(host.peer_count() == 1 && source.row_requests == 0 && source.requested == 0)
    let retained_rows = object(rows, "copy")
    assert(retained_rows == rows && host.peer_count() == 1)
    let row = send_arg(rows, selector("objectAtIndex:"), 49999 as uint)
    assert(row != 0 as uint && object(row, "accessibilityIndex") == 49999 as uint)
    assert(source.row_requests == 1 && source.requested == 0 && host.peer_count() == 2)
    assert(send_arg(object(root, "accessibilityChildren"), selector("objectAtIndex:"), 49999 as uint) == row)
    assert(compare(root, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityCellForColumn:row:")) != 0 as uint8)
    // This fake source has only one child cell. Its model column is deliberately
    // different from that child index; the bridge must reject a mismatched cell.
    let query = selector("accessibilityCellForColumn:row:")
    assert(send_cell(root, query, 0, 49999) == 0 as uint)
    source.column = 0
    let cell = send_cell(root, query, 0, 49999)
    assert(cell != 0 as uint)
    let before = source.row_requests
    assert(send_cell(root, query, -1, 49999) == 0 as uint)
    assert(send_cell(root, query, 4, 49999) == 0 as uint)
    assert(send_cell(root, query, 0, -1) == 0 as uint)
    assert(send_cell(root, query, 0, 50000) == 0 as uint)
    assert(source.row_requests == before)
    source.row_total = 1; source.position = 0
    assert(object(rows, "count") == 1 as uint)
    assert(send_arg(rows, selector("objectAtIndex:"), 0 as uint) == row)
    assert(send_cell(root, query, 0, 0) == cell)
    source.row_total = -1
    assert(object(rows, "count") == 0 as uint)
    source.row_total = 0
    assert(object(rows, "count") == 0 as uint)
    source.rows_supported = false
    assert(object(rows, "count") == 0 as uint)
    assert(object(root, "accessibilityRows") == 0 as uint)
    assert(compare(root, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityRows")) == 0 as uint8)
    let retained_root = object(root, "retain")
    host.remove()
    assert(object(retained_rows, "count") == 0 as uint)
    assert(send_arg(retained_rows, selector("objectAtIndex:"), 0 as uint) == 0 as uint)
    assert(send_cell(root, query, 0, 0) == 0 as uint)
    send_void(retained_root, selector("release"))
    send_void(retained_rows, selector("release")); send_void(pool, selector("drain"))
}
test "AppKit row projection and indexed cell lookup stay lazy live and detach safely" { verify_indexed_rows() }

