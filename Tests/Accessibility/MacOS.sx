func verify_collection_positions() {
    let pool = object(system_class("NSAutoreleasePool"), "new")
    var source = CollectionSource()
    var host = Presentation(source, 0 as uint, 0 as uint, 200.0, false)
    let root = host.root_handle()
    assert(compare(root, selector("isAccessibilitySelectorAllowed:"), selector("accessibilityRowCount")) != 0 as uint8)
    assert(object(root, "accessibilityRowCount") == 50000 as uint)
    assert(object(root, "accessibilityColumnCount") == 4 as uint)
    assert(host.peer_count() == 1 && source.requested == 0)
    let children = object(root, "accessibilityChildren")
    let row = send_arg(children, selector("objectAtIndex:"), 49999 as uint)
    assert(object(row, "accessibilityIndex") == 49999 as uint)
    assert(compare(object(row, "accessibilitySubrole"), selector("isEqualToString:"), native_string("AXTableRow")) != 0 as uint8)
    let cell = send_arg(object(row, "accessibilityChildren"), selector("objectAtIndex:"), 0 as uint)
    let row_span = native_span(cell, "accessibilityRowIndexRange")
    let column_span = native_span(cell, "accessibilityColumnIndexRange")
