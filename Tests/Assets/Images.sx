use GFX.Assets.Image
use GFX.Assets.Images.Images as ImageCatalog
use GFX.Color

test "store caller-provided images without choosing a decoder" {
    var images = ImageCatalog()
    let handle = images.add(Image.solid(Color.red_500()))
    assert(images.contains(handle))
    assert(images.snapshot(handle).pixels()[0] == 251 as uint8)
    assert(images.revision(handle) == 1)

    images.replace(handle, Image.solid(Color.blue_500()))
    assert(images.revision(handle) == 2)
    assert(images.remove(handle))
    assert(!images.contains(handle))
}

test "round normalized image colors to RGBA8 channels" {
    let image = Image.solid(Color(r:0.5, g:0.25, b:0.75, a:0.5))
    let pixels = image.pixels()
    assert(pixels[0] == 128 as uint8)
    assert(pixels[1] == 64 as uint8)
    assert(pixels[2] == 191 as uint8)
    assert(pixels[3] == 128 as uint8)
}
