use GFX.Bootstrap

struct Counter {
    var value:int
}

struct First {
    let expected:int
    var trace:DropTrace

    drop {
        assert(self.trace.next == self.expected)
        self.trace.next++
    }
}

struct Second {
    let expected:int
    var trace:DropTrace

    drop {
        assert(self.trace.next == self.expected)
        self.trace.next++
    }
}

class DropTrace {
    public var next:int
}

test "isolate and mutate application resources" {
    var first = Bootstrap.Application()
    var second = Bootstrap.Application()
    var first_resources = first.resources()
    var second_resources = second.resources()

    first_resources.insert(Counter(value:40))
    assert(first_resources.has<Counter>())
    assert(!second_resources.has<Counter>())

    if true {
        var counter:&Counter = first_resources.get_mut<Counter>()
        counter.value += 2
    }
    if true {
        let counter:@Counter = first_resources.get<Counter>()
        assert(counter.value == 42)
    }
    if true {
        var counter:&Counter? = first_resources.try_get_mut<Counter>()
        assert(counter != null)
    }

    if true {
        let missing:@Counter? = second_resources.try_get<Counter>()
        assert(missing == null)
    }
    let removed = first_resources.remove<Counter>()
    assert(removed != null)
    assert(!first_resources.has<Counter>())

    var trace = DropTrace(next:1)
    second_resources.insert(First(expected:1, trace:trace))
    second_resources.insert(Second(expected:3, trace:trace))
    second_resources.insert(First(expected:2, trace:trace))
    second_resources.clear()
    assert(trace.next == 4)
}
