use GFX.ECS

struct Position {
    var x:int
}

struct Label {
    let value:str
}

func move_position(position:&Position) {
    position.x += 2
}

test "store typed components on stable entities" {
    var world = ECS.World()
    var first_recipe = ECS.EntityRecipe()
        ..with(Position(x:40))
        ..with(Label(value:"first"))
    var second_recipe = ECS.EntityRecipe()
        ..with(Position(x:7))

    let first = world.spawn(first_recipe)
    let second = world.spawn(second_recipe)

    assert(world.is_alive(first))
    let initial_entities = world.entities()
    assert(initial_entities.count() == 2)
    assert(world.has<Position>(first))
    assert(world.has<Label>(first))
    assert(!world.has<Label>(second))
    world.update<Position>(first, move_position)
    if true {
        let position:@Position = world.get<Position>(first)
        assert(position.x == 42)
    }
    let removed = world.remove<Label>(first)
    assert(removed != null)
    assert(!world.has<Label>(first))

    world.insert(first, Label(value:"updated"))
    assert(world.get<Label>(first).value == "updated")

    world.destroy(second)
    assert(!world.is_alive(second))
    let remaining_entities = world.entities()
    assert(remaining_entities.count() == 1)
}

test "reuse entity slots without reviving stale handles" {
    var world = ECS.World()
    var original_recipe = ECS.EntityRecipe()
        ..with(Position(x:1))
    let original = world.spawn(original_recipe)

    world.destroy(original)
    var replacement_recipe = ECS.EntityRecipe()
        ..with(Position(x:2))
    let replacement = world.spawn(replacement_recipe)

    assert(!world.is_alive(original))
    assert(world.is_alive(replacement))
    assert(original != replacement)
    assert(!world.has<Position>(original))
    assert(world.get<Position>(replacement).x == 2)

    world.clear()
    var after_clear_recipe = ECS.EntityRecipe()
        ..with(Position(x:3))
    let after_clear = world.spawn(after_clear_recipe)
    assert(!world.is_alive(original))
    assert(!world.is_alive(replacement))
    assert(world.is_alive(after_clear))
    assert(world.get<Position>(after_clear).x == 3)
}

test "the latest duplicate recipe component wins without duplicating membership" {
    var world = ECS.World()
    var recipe = ECS.EntityRecipe()
        ..with(Position(x:1))
        ..with(Position(x:7))
        ..with(Label(value:"unique"))
    let entity = world.spawn(recipe)

    assert(world.get<Position>(entity).x == 7)
    let entities = world.entities()
    assert(entities.count() == 1)
    assert(entities[0] == entity)
}

test "dense component columns survive swap removal and structural migration" {
    var world = ECS.World()
    var entities:ECS.Entity[] = []
    var index = 0
    while index < 512 {
        var recipe = ECS.EntityRecipe()
            ..with(Position(x:index))
            ..with(Label(value:"alive"))
        entities.append(world.spawn(recipe))
        index++
    }

    index = 0
    while index < entities.count() {
        if index % 3 == 0 {
            world.destroy(entities[index])
        } else if index % 3 == 1 {
            world.remove<Label>(entities[index])
        }
        index++
    }

    index = 0
    while index < entities.count() {
        let entity = entities[index]
        if index % 3 == 0 {
            assert(!world.is_alive(entity))
        } else {
            assert(world.is_alive(entity))
            assert(world.get<Position>(entity).x == index)
            assert(world.has<Label>(entity) == (index % 3 == 2))
        }
        index++
    }
}
