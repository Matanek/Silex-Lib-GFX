use GFX.Application

struct Counter {
    var value:int
}

struct First {
    let expected:int
    var trace:DropTrace

    drop {
        assert(self.trace.next == self.expected)
        self.trace.next++
    }
}

struct Second {
    let expected:int
    var trace:DropTrace

    drop {
        assert(self.trace.next == self.expected)
        self.trace.next++
    }
}

class DropTrace {
    var next:int
}

test "isolate and mutate application resources" {
    var first = Application()
    var second = Application()
    var first_resources = first.resources()
    var second_resources = second.resources()

    assert(first_resources.has<Application.Controller>())
    assert(second_resources.has<Application.Controller>())

    first_resources.insert(Counter(value:40))
    assert(first_resources.has<Counter>())
    assert(!second_resources.has<Counter>())

    if true {
        var counter:&Counter = first_resources.get_mut<Counter>()
        counter.value += 2
    }
    if true {
        let counter:@Counter = first_resources.get<Counter>()
        assert(counter.value == 42)
    }
    if true {
        var counter:&Counter? = first_resources.try_get_mut<Counter>()
        assert(counter != null)
    }

    if true {
        let missing:@Counter? = second_resources.try_get<Counter>()
        assert(missing == null)
    }
    let removed = first_resources.remove<Counter>()
    assert(removed != null)
    assert(!first_resources.has<Counter>())

    var trace = DropTrace(next:1)
    second_resources.insert(First(expected:1, trace:trace))
    second_resources.insert(Second(expected:3, trace:trace))
    second_resources.insert(First(expected:2, trace:trace))
    second_resources.clear()
    assert(trace.next == 4)
}

test "scope resources without copying or owning the parent" {
    var application = Application()
    var resources = application.resources()
    resources.insert(Counter(value:40))

    var scoped = resources.scope()
    assert(scoped.has<Counter>())
    if true {
        var inherited:&Counter = scoped.get_mut<Counter>()
        inherited.value += 2
    }
    if true {
        let global:@Counter = resources.get<Counter>()
        assert(global.value == 42)
    }

    scoped.insert(Counter(value:2))
    if true {
        let local_resource:@Counter = scoped.get<Counter>()
        let global:@Counter = resources.get<Counter>()
        assert(local_resource.value == 2)
        assert(global.value == 42)
    }

    let removed = scoped.remove<Counter>()
    assert(removed != null)
    if true {
        let inherited:@Counter = scoped.get<Counter>()
        assert(inherited.value == 42)
    }
    assert(scoped.remove<Counter>() == null)

    scoped.insert(Counter(value:7))
    scoped.clear()
    assert(scoped.has<Counter>())
    if true {
        let inherited:@Counter = scoped.get<Counter>()
        assert(inherited.value == 42)
    }
}
