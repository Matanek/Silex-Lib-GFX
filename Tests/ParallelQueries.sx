use GFX.Bootstrap
use GFX.ECS
use GFX.ECS.Plugin as ECSPlugin

struct Value { var number:int }
struct Added { var number:int }

func independent(query:ECS.Query<(ECS.Entity, &Value)>) {
    for (entity, value) in query { value.number++ }
}

func with_continue(query:ECS.Query<(ECS.Entity, &Added)>) {
    for (entity, added) in query {
        if added.number < 0 { continue }
        added.number++
    }
}

func with_break(query:ECS.Query<(ECS.Entity, @Value)>) {
    for (entity, value) in query { break }
}

func with_return(query:ECS.Query<(ECS.Entity, @Value)>) {
    for (entity, value) in query { return }
}

func with_accumulation(query:ECS.Query<(ECS.Entity, @Value)>) {
    var total = 0
    for (entity, value) in query { total += value.number }
}

func with_effect(query:ECS.Query<(ECS.Entity, @Value)>) {
    for (entity, value) in query { print(value.number) }
}

func with_commands(commands:&ECS.Commands, query:ECS.Query<(ECS.Entity, @Value)>) {
    for (entity, value) in query {
        if value.number < 0 { commands.destroy(entity) }
    }
}

func inspect_classification(application:Bootstrap.Application) int {
    assert(application.scheduler_parallel_query_system_count(Bootstrap.Schedule.update, false) == 3)
    return 0
}

test "classify independent query loops conservatively" {
    var application = Bootstrap.Application(2)
        ..install(ECSPlugin())
        ..add_system(Bootstrap.Schedule.update, independent)
        ..add_system(Bootstrap.Schedule.update, with_continue)
        ..add_system(Bootstrap.Schedule.update, with_break)
        ..add_system(Bootstrap.Schedule.update, with_return)
        ..add_system(Bootstrap.Schedule.update, with_accumulation)
        ..add_system(Bootstrap.Schedule.update, with_effect)
        ..add_system(Bootstrap.Schedule.update, with_commands)
        ..with_runner(inspect_classification)
    assert(application.run() == 0)
}

func update_and_destroy(commands:&ECS.Commands, query:ECS.Query<(ECS.Entity, &Value)>) {
    for (entity, value) in query {
        value.number++
        if value.number % 3 == 1 { commands.destroy(entity) }
    }
}

func run_update(application:Bootstrap.Application) int {
    application.run_schedule(Bootstrap.Schedule.update)
    application.run_schedule(Bootstrap.Schedule.post_update)
    return 0
}

func seed(application:Bootstrap.Application, count:int) ECS.Entity[] {
    var result:ECS.Entity[] = []
    var resources = application.resources()
    var world:&ECS.World = resources.get_mut<ECS.World>()
    var index = 0
    while index < count {
        var recipe = ECS.EntityRecipe()..with(Value(number:index))
        result.append(world.spawn(recipe))
        index++
    }
    return result
}

func run_case(worker_count:int, count:int, expect_parallel:bool) int[] {
    var application = Bootstrap.Application(worker_count)
        ..install(ECSPlugin())
        ..add_system(Bootstrap.Schedule.update, update_and_destroy)
        ..with_runner(run_update)
    let entities = seed(application, count)
    assert(application.run() == 0)
    if expect_parallel {
        assert(application.query_parallel_dispatch_count() == 1)
        assert(application.query_local_dispatch_count() == 0)
    } else {
        assert(application.query_parallel_dispatch_count() == 0)
        assert(application.query_local_dispatch_count() == 1)
    }
    var survivors:int[] = []
    var resources = application.resources()
    let world:@ECS.World = resources.get<ECS.World>()
    var index = 0
    while index < entities.count() {
        let entity = entities[index]
        if index % 3 == 0 {
            assert(!world.is_alive(entity))
        } else {
            assert(world.is_alive(entity))
            assert(world.get<Value>(entity).number == index + 1)
            survivors.append(entity.index)
        }
        index++
    }
    return survivors
}

test "partition large queries and keep small queries local" {
    let small = run_case(4, 31, false)
    assert(small.count() == 20)
    let large = run_case(4, 257, true)
    assert(large.count() == 171)
}

test "preserve component results and command order in mono and multiworker execution" {
    let sequential = run_case(1, 257, true)
    let parallel = run_case(4, 257, true)
    assert(sequential.count() == parallel.count())
    var index = 0
    while index < sequential.count() {
        assert(sequential[index] == parallel[index])
        index++
    }
}

func spawn_from_parallel_stage(commands:&ECS.Commands) {
    var recipe = ECS.EntityRecipe()..with(Value(number:10_000))
    commands.spawn(recipe)
}

func destroy_multiples_of_three(commands:&ECS.Commands, query:ECS.Query<(ECS.Entity, @Value)>) {
    for (entity, value) in query {
        if value.number % 3 == 0 { commands.destroy(entity) }
    }
}

func remove_multiples_of_five(commands:&ECS.Commands, query:ECS.Query<(ECS.Entity, @Value)>) {
    for (entity, value) in query {
        if value.number % 5 == 0 { commands.remove<Value>(entity) }
    }
}

func insert_odd_markers(commands:&ECS.Commands, query:ECS.Query<(ECS.Entity, @Value)>) {
    for (entity, value) in query {
        if value.number % 2 == 1 { commands.insert(entity, Added(number:1)) }
    }
}

test "stress deterministic structural commands and generation reuse" {
    var repetition = 0
    while repetition < 8 {
        var application = Bootstrap.Application(4)
            ..install(ECSPlugin())
            ..add_system(Bootstrap.Schedule.update, spawn_from_parallel_stage)
            ..add_system(Bootstrap.Schedule.update, destroy_multiples_of_three)
            ..add_system(Bootstrap.Schedule.update, remove_multiples_of_five)
            ..add_system(Bootstrap.Schedule.update, insert_odd_markers)
            ..with_runner(run_update)
        let entities = seed(application, 193)
        assert(application.run() == 0)
        var resources = application.resources()
        var world:&ECS.World = resources.get_mut<ECS.World>()
        var destroyed = 0
        var index = 0
        while index < entities.count() {
            let entity = entities[index]
            if index % 3 == 0 {
                destroyed++
                assert(!world.is_alive(entity))
            } else {
                assert(world.is_alive(entity))
                assert(world.has<Value>(entity) == (index % 5 != 0))
                assert(world.has<Added>(entity) == (index % 2 == 1))
            }
            index++
        }
        let spawned = world.entities()
        assert(spawned.count() == entities.count() - destroyed + 1)
        var replacement = ECS.EntityRecipe()..with(Value(number:-1))
        let reused = world.spawn(replacement)
        assert(reused.generation > 1)
        assert(world.is_alive(reused))
        repetition++
    }
}
