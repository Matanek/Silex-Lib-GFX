use GFX.Components
use GFX.Plugins
use GFX.Resources

func injected_foundation_resources(
    time:@Resources.FrameTime,
    world:&Resources.World,
    commands:&Resources.Commands,
    input:@Resources.InputState,
    renderer:&Resources.Renderer
) {}

func injected_asset_resources(
    images:&Resources.Images,
    sprite_sheets:&Resources.SpriteSheets,
    input:&Resources.Input
) {}

func injected_window_resource(window:&Resources.Window) {}

func injected_presentation_resources(
    device:@Resources.Device,
    surface:@Resources.GPUSurface
) {}

func configured_plugins(
    window:Plugins.Window.Settings,
    gpu:Plugins.GPU.Settings,
    rendering:Plugins.Rendering.Settings
) {}

func foundation_plugins(
    assets:Plugins.Assets,
    ecs:Plugins.ECS,
    input:Plugins.Input,
    rendering:Plugins.Rendering
) {}

func presentation_plugins(window:Plugins.Window) {}

test "expose components resources and plugins through intentional umbrellas" {
    let time = Plugins.Time()
    let pacing = Plugins.FramePacing(60)
    let window = Plugins.Window(Plugins.Window.Settings()..hidden = true)
    let rendering_defaults = Plugins.Rendering.Settings()
    let rendering_without_aa = Plugins.Rendering.Settings(
        antialiasing:Plugins.RenderingAntialiasing.none
    )
    assert(
        rendering_defaults.antialiasing ==
        Plugins.RenderingAntialiasing.msaa_4x
    )
    assert(
        rendering_without_aa.antialiasing ==
        Plugins.RenderingAntialiasing.none
    )
}
