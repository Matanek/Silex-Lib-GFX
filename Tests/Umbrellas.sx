use GFX.Components
use GFX.Plugins
use GFX.Resources
use STD.Math

func injected_foundation_resources(
    time:@Resources.FrameTime,
    world:&Resources.World,
    commands:&Resources.Commands,
    input:@Resources.InputState,
    renderer:&Resources.Renderer
) {}

func injected_asset_resources(
    images:&Resources.Images,
    sprite_sheets:&Resources.SpriteSheets,
    audio:&Resources.Audio,
    input:&Resources.Input
) {}

func injected_scene_resources(
    meshes:&Resources.Meshes3D,
    tone_mapping:@Resources.ToneMapping3D,
    camera_2d:&Resources.ViewportCamera2D,
    camera_3d:&Resources.ViewportCamera3D,
    window:&Resources.Window
) {}

func injected_presentation_resources(
    device:@Resources.Device,
    surface:@Resources.GPUSurface,
    viewer:&Resources.Viewer,
    web_view:&Resources.WebView
) {}

func configured_plugins(
    window:Plugins.WindowSettings,
    gpu:Plugins.GPUSettings,
    rendering:Plugins.RenderingSettings,
    camera_2d:Plugins.ViewportCamera2DSettings,
    camera_3d:Plugins.ViewportCamera3DSettings
) {}

func foundation_plugins(
    assets:Plugins.Assets,
    audio:Plugins.Audio,
    ecs:Plugins.ECS,
    input:Plugins.Input,
    rendering:Plugins.Rendering
) {}

func presentation_plugins(
    viewer:Plugins.Viewer,
    web_view:Plugins.WebView,
    window:Plugins.Window
) {}

test "expose components resources and plugins through intentional umbrellas" {
    let transform_2d = Components.Transform2D(position:Math.Vec2(12.0, 8.0))
    let transform_3d = Components.Transform3D(position:Math.Vec3(1.0, 2.0, 3.0))
    let camera_2d = Components.Camera2D(zoom:2.0)
    let light_3d = Components.PointLight3D(radius:6.0)

    assert(transform_2d.position == Math.Vec2(12.0, 8.0))
    assert(transform_3d.position == Math.Vec3(1.0, 2.0, 3.0))
    assert(camera_2d.zoom == 2.0)
    assert(light_3d.radius == 6.0)

    let time = Plugins.Time()
    let pacing = Plugins.FramePacing(60)
    let scene_2d = Plugins.Scene2D()
    let scene_3d = Plugins.Scene3D()
    let fps_counter = Plugins.FPSCounter(Plugins.FPSCounterSettings()
        ..anchor = Plugins.FPSCounterAnchor.bottom_right
    )
    let grid_2d = Plugins.Grid2D()
    let grid_3d = Plugins.Grid3D()
    let window = Plugins.Window(Plugins.WindowSettings()..hidden = true)
    let viewport = Plugins.ViewportCamera3D(
        Plugins.ViewportCamera3DSettings()..distance = 12.0
    )
}
