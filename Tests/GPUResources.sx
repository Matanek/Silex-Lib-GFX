use GFX.Color
use GFX.GPU

test "move bytes through a GPU buffer" {
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var upload = device.upload_buffer(8)
    var source:uint8[] = []
    source.append(3 as uint8)
    source.append(5 as uint8)
    source.append(8 as uint8)
    source.append(13 as uint8)
    source.append(21 as uint8)
    source.append(34 as uint8)
    source.append(55 as uint8)
    source.append(89 as uint8)
    upload.write(@source[0:source.count()])

    var buffer = device.buffer(GPU.BufferSettings(
        size:source.count(),
        usage:GPU.BufferUsage.vertex()
    ))
    var download = device.download_buffer(source.count())
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(upload, buffer, source.count())
    transfer.download(buffer, download, source.count())
    transfer.finish()
    var completed = commands.submit_and_track()
    completed.wait()

    let result = download.read()
    assert(result.count() == source.count())
    var index = 0
    while index < result.count() {
        assert(result[index] == source[index])
        index++
    }
}

test "render and blit between offscreen textures" {
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    let usage = GPU.TextureUsage(sampled:true, color_target:true)
    var source = device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.rgba8_unorm,
        width:16,
        height:16,
        usage:usage,
        name:"GPU test source"
    ))
    var destination = device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.rgba8_unorm,
        width:16,
        height:16,
        usage:usage,
        name:"GPU test destination"
    ))
    var sampler = device.sampler()
    assert(source.byte_count() == 1024)

    var commands = device.commands()
    var pass = commands.render(GPU.ColorTarget(
        texture:source,
        clear:Color.indigo_900()
    ))
    pass.finish()
    commands.blit(
        GPU.BlitRegion(texture:source, width:16, height:16),
        GPU.BlitRegion(texture:destination, width:16, height:16)
    )
    commands.submit()
    device.wait_until_idle()
}

test "draw a triangle through a graphics pipeline" {
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    let vertex_source = "#include <metal_stdlib>\nusing namespace metal; struct VertexOutput { float4 position [[position]]; }; vertex VertexOutput vertex_main(uint vertex_id [[vertex_id]]) { const float2 positions[3] = { float2(0.0, -0.5), float2(0.5, 0.5), float2(-0.5, 0.5) }; VertexOutput output; output.position = float4(positions[vertex_id], 0.0, 1.0); return output; }"
    let fragment_source = "#include <metal_stdlib>\nusing namespace metal; fragment float4 fragment_main() { return float4(0.2, 0.6, 1.0, 1.0); }"
    var vertex = device.shader(GPU.ShaderStage.vertex, GPU.ShaderFormat.msl, vertex_source, GPU.ShaderSettings(entry:"vertex_main"))
    var fragment = device.shader(GPU.ShaderStage.fragment, GPU.ShaderFormat.msl, fragment_source, GPU.ShaderSettings(entry:"fragment_main"))
    var targets:GPU.ColorTargetFormat[] = []
    targets.append(GPU.ColorTargetFormat(format:GPU.TextureFormat.rgba8_unorm))
    var pipeline = device.graphics_pipeline(vertex, fragment, GPU.GraphicsPipelineSettings(
        color_targets:targets
    ))
    var target = device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.rgba8_unorm,
        width:32,
        height:32,
        usage:GPU.TextureUsage.as_color_target()
    ))
    var commands = device.commands()
    var pass = commands.render(GPU.ColorTarget(texture:target))
    pass.bind(pipeline)
    pass.draw(3)
    pass.finish()
    commands.submit()
    device.wait_until_idle()
}

