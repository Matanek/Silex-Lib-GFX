use GFX.Window
use GFX.Input

test "consume native window events through the public input adapter" {
    var input = Input()
    input.update()

    var window = Window(Window.Settings(title:"Silex Portability Event", hidden:true))
    let window_id = window.id()
    window.show()
    window.hide()
    input.update()

    var saw_visibility_event = false
    for event in input.events() {
        match event {
            window_shown(value) => {
                if value.window == window_id { saw_visibility_event = true }
            }
            window_hidden(value) => {
                if value.window == window_id { saw_visibility_event = true }
            }
            else => {}
        }
    }
    assert(saw_visibility_event)
}
