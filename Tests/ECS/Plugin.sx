use GFX.Application
use GFX.ECS

class Position {
    private var current_x:int

    init(x:int) { self.current_x = x }
    func advance(amount:int) { self.current_x += amount }
    func x() int { return self.current_x }
}

class StatefulPlugin:Application.Plugin {
    private var updates:int

    init() { self.updates = 0 }
    func id() str { return "GFX.ECS.Tests.Stateful" }

    func build(application:Application) {
        application.add_plugin(ECS.Plugin())
        application.add_system(Application.Schedule.startup, StatefulPlugin.spawn)
        application.add_system(Application.Schedule.update, StatefulPlugin.update)
        application.add_system(Application.Schedule.shutdown, StatefulPlugin.verify)
    }

    func spawn(world:&ECS.World) {
        world.spawn(ECS.EntityRecipe()..with(Position(x:40)))
    }

    func update(
        positions:ECS.Query<(ECS.Entity, &Position)>,
        controller:&Application.Controller
    ) {
        for (entity, position) in positions {
            position.advance(2)
            self.updates++
        }
        controller.stop()
    }

    func verify(positions:ECS.Query<(ECS.Entity, @Position)>) {
        assert(self.updates == 1)
        for (entity, position) in positions { assert(position.x() == 42) }
    }

    func update_count() int { return self.updates }
}

func observe_shutdown(world:@ECS.World, commands:@ECS.Commands) {}

test "install and remove ECS through its plugin" {
    var application = Application()
    var resources = application.resources()
    assert(!resources.has<ECS.World>())
    assert(!resources.has<ECS.Commands>())

    var plugin = StatefulPlugin()
    application.add_plugin(plugin)
    application.add_plugin(ECS.Plugin())
    application.add_system(Application.Schedule.shutdown, observe_shutdown)

    assert(application.has_plugin("GFX.ECS.Plugin"))
    assert(resources.has<ECS.World>())
    assert(resources.has<ECS.Commands>())
    assert(application.run() == 0)
    assert(plugin.update_count() == 1)
    assert(!resources.has<ECS.World>())
    assert(!resources.has<ECS.Commands>())
}
