use GFX.Application
use GFX.ECS

struct Position { var value:int }
struct Velocity { var value:int }
struct Marker { let value:int }

func read_position(query:ECS.Query<(@Position, @Marker)>) {}
func observe_position(query:ECS.Query<(@Position, @Marker)>) {}
func write_velocity(query:ECS.Query<(&Velocity, @Marker)>) {}
func write_position(query:ECS.Query<(&Position, @Marker)>) {}
func write_world(world:&ECS.World) {}
func legacy(application:Application) {}

func run_update(application:Application) int {
    application.run_schedule(Application.Schedule.update)
    return 0
}

test "derive resource, component, World, and Application access descriptors" {
    var application = Application(1)
    application.add_plugin(ECS.Plugin())
    if true {
        var resources = application.resources()
        var world:&ECS.World = resources.get_mut<ECS.World>()
        var recipe = ECS.EntityRecipe()
            ..with(Position(value:1))
            ..with(Velocity(value:2))
            ..with(Marker(value:3))
        world.spawn(recipe)
    }
    application.add_system(Application.Schedule.update, read_position)
    application.add_system(Application.Schedule.update, observe_position)
    application.add_system(Application.Schedule.update, write_velocity)
    application.add_system(Application.Schedule.update, write_position)
    application.add_system(Application.Schedule.update, write_world)
    application.add_system(Application.Schedule.update, legacy)
    application.add_after_system(Application.Schedule.update, read_position)
    application.with_runner(run_update)
    assert(application.run() == 0)
}

struct ChainLeft { var value:int }
struct ChainRight { var value:int }

func chain_first(left:&ChainLeft) { left.value = 1 }
func chain_middle(left:@ChainLeft, right:&ChainRight) {
    assert(left.value == 1)
    right.value = 1
}
func chain_last(right:@ChainRight) { assert(right.value == 1) }

test "preserve transitive registration dependencies between stages" {
    var application = Application(1)
    application.resources().insert(ChainLeft(value:0))
    application.resources().insert(ChainRight(value:0))
    application.add_system(Application.Schedule.update, chain_first)
    application.add_system(Application.Schedule.update, chain_middle)
    application.add_system(Application.Schedule.update, chain_last)
    application.with_runner(run_update)
    assert(application.run() == 0)
}
