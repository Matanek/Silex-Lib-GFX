use GFX.Animation
use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Plugins
use GFX.Resources
use STD.Math

static struct Const {
    let positions:Math.Vec2[] = [
        Math.Vec2(-200.0, 200.0),
        Math.Vec2(200.0, 200.0),
        Math.Vec2(0.0, -200.0),
    ]
}

func create_points(world:&Resources.World) {
    let canvas_size = 10
    var canvas = Canvas()
        ..paint(func(painter:&Canvas.Painter) {
            painter.fill(
                Canvas.Circle(Math.Vec2(5.0), 5.0),
                Canvas.Fill.solid(Color.red_500())
            )
        })

    for position in Const.positions {
        world.spawn(ECS.EntityRecipe()
            ..with(Components.Transform2D(position:position))
            ..with(Components.Canvas(canvas, canvas_size, canvas_size)..layer = 1)
        )
    }
}

func create_square(world:&Resources.World) {
    let canvas_size = 90
    let square_size = 90.0
    let duration = 1.25
    let half_duration = duration * 0.5
    var square = Canvas()
        ..paint(func(painter:&Canvas.Painter) {
            painter.fill(
                Canvas.Rect(Math.Vec2(), Math.Vec2(square_size)),
                Canvas.Fill.solid(Color.white())
            )
        })
    let route = Animation.sequence([
        Animation.move_to(Const.positions[1], duration, easing:Animation.Easing.in_out),
        Animation.move_to(Const.positions[2], duration, easing:Animation.Easing.in_out),
        Animation.move_to(Const.positions[0], duration, easing:Animation.Easing.in_out),
    ])
    let colors = Animation.sequence([
        Animation.color_to(Color.pink_400(), duration, easing:Animation.Easing.in_out),
        Animation.color_to(Color.amber_400(), duration, easing:Animation.Easing.in_out),
        Animation.color_to(Color.sky_500(), duration, easing:Animation.Easing.in_out),
    ])
    let scale_between_points = Animation.sequence([
        Animation.scale_to(1.25, half_duration, easing:Animation.Easing.in_out),
        Animation.scale_to(1.0, half_duration, easing:Animation.Easing.in_out),
    ])
    let scales = Animation.sequence([
        scale_between_points,
        scale_between_points,
        scale_between_points,
    ])
    let timeline = Animation.parallel([
        route,
        Animation.rotate_to(Math.pi() * 2.0, duration * 3.0,
            easing:Animation.Easing.in_out),
        scales,
        colors,
    ])
        ..ping_pong()
        ..loop()

    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Const.positions[0]))
        ..with(Components.Canvas(square, canvas_size, canvas_size)
            ..color = Color.indigo_400())
        ..with(timeline.play())
    )
}

func main() {
    Application()
        ..add_plugin(Plugins.Window(Plugins.WindowSettings()
            ..title = "GFX.Animation — Timeline 2D"
            ..width = 960
            ..height = 640
        ))
        ..add_plugin(Plugins.Rendering(Plugins.RenderingSettings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.FPSCounter())
        ..add_plugin(Animation.Plugin())
        ..add_system(Application.Schedule.startup, create_square)
        ..add_system(Application.Schedule.startup, create_points)
        ..run()
}
