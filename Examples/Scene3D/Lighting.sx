use GFX.Application
use GFX.Application.FrameTime
use GFX.Application.Time as TimePlugin
use GFX.Color
use GFX.ECS
use GFX.Input
use GFX.Scene3D
use GFX.Scene3D.Rotator as Rotator3D
use GFX.Scene3D.Transform as Transform3D
use GFX.Scene3D.ViewportCamera as ViewportCamera3D
use GFX.Window
use GFX.Window.Plugin as WindowPlugin
use STD.Math

enum Preset {
    sun
    spot
    cube
    tube
    point
}

struct State {
    var sun:ECS.Entity
    var spot:ECS.Entity
    var cube:ECS.Entity
    var tube:ECS.Entity
    var point:ECS.Entity
    var active:Preset
}

func create_geometry(world:&ECS.World, meshes:&Scene3D.Meshes) {
    let ground = meshes.add(
        Scene3D.Geometry.Cube.make().translated(Math.Vec3(0.0, -0.5, 0.0))
    )
    let cube = meshes.add(
        Scene3D.Geometry.Cube.make().translated(Math.Vec3(0.0, 0.5, 0.0))
    )

    world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(scale:Math.Vec3(4.0, 0.3, 4.0)))
        ..with(Scene3D.Mesh(ground))
        ..with(Scene3D.Material(
            albedo:Color.bytes(125, 127, 118),
            roughness:0.82
        ))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(rotation:Math.Quat.angle_axis(
            Math.radians(22.0),
            Math.Vec3.up()
        )))
        ..with(Scene3D.Mesh(cube))
        ..with(Scene3D.Material(
            albedo:Color.bytes(218, 214, 196),
            metallic:0.1,
            roughness:0.34
        ))
        ..with(Rotator3D(x_speed:0.0, y_speed:0.45, z_speed:0.0))
    )
}

func create_lights(world:&ECS.World, state:&State) {
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.AmbientLight(
            color:Color.white(),
            intensity:0.06
        ))
    )

    state.sun = world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.SunLight(
            direction:Math.Vec3(-0.45, -0.9, -0.35).normalized(),
            color:Color.white(),
            intensity:5.0
        ))
        ..with(Scene3D.SunLightGizmo())
    )

    let position = Math.Vec3(0.0, 3.0, 3.2)
    let direction = Math.Vec3(0.0, 0.25, 0.0)
        .subtract(position)
        .normalized()

    state.spot = world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(position:position))
        ..with(Scene3D.SpotProjectorLight(
            direction:direction,
            color:Color.white(),
            intensity:7.0,
            reach:2.2,
            angle:Math.radians(15.0),
            enabled:false
        )
            ..softness = Math.radians(7.0)
            ..falloff = 1.7
        )
        ..with(Scene3D.SpotProjectorLightGizmo())
    )
    state.cube = world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(position:position))
        ..with(Scene3D.CubeProjectorLight(
            direction:direction,
            color:Color.white(),
            intensity:7.0,
            size:Math.Vec3(3.0, 3.0, 2.2),
            enabled:false
        )
            ..softness = 0.8
            ..falloff = 1.7
        )
        ..with(Scene3D.CubeProjectorLightGizmo())
    )
    state.tube = world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(position:position))
        ..with(Scene3D.TubeProjectorLight(
            direction:direction,
            color:Color.white(),
            intensity:7.0,
            length:2.2,
            radius:1.5,
            enabled:false
        )
            ..softness = 0.8
            ..falloff = 1.7
        )
        ..with(Scene3D.TubeProjectorLightGizmo())
    )
    state.point = world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(position:Math.Vec3(1.3, 1.4, 1.6)))
        ..with(Scene3D.PointLight(
            color:Color.white(),
            intensity:5.0,
            radius:1.8,
            enabled:false
        )
            ..softness = 0.8
            ..falloff = 1.4
        )
        ..with(Scene3D.PointLightGizmo())
    )
}

func preset_name(value:Preset) str {
    if value == Preset.sun { return "1 SunLight" }
    if value == Preset.spot { return "2 SpotProjectorLight" }
    if value == Preset.cube { return "3 CubeProjectorLight" }
    if value == Preset.tube { return "4 TubeProjectorLight" }
    return "5 PointLight"
}

func apply_preset(
    world:&ECS.World,
    state:&State,
    window:&Window,
    preset:Preset
) {
    state.active = preset
    world.update<Scene3D.SunLight>(state.sun, func(light:&Scene3D.SunLight) {
        light.enabled = preset == Preset.sun
    })
    world.update<Scene3D.SpotProjectorLight>(
        state.spot,
        func(light:&Scene3D.SpotProjectorLight) {
            light.enabled = preset == Preset.spot
        }
    )
    world.update<Scene3D.CubeProjectorLight>(
        state.cube,
        func(light:&Scene3D.CubeProjectorLight) {
            light.enabled = preset == Preset.cube
        }
    )
    world.update<Scene3D.TubeProjectorLight>(
        state.tube,
        func(light:&Scene3D.TubeProjectorLight) {
            light.enabled = preset == Preset.tube
        }
    )
    world.update<Scene3D.PointLight>(state.point, func(light:&Scene3D.PointLight) {
        light.enabled = preset == Preset.point
    })
    window.set_title("Scene3D — Lighting — " + preset_name(preset))
}

func activate_default(world:&ECS.World, state:&State, window:&Window) {
    apply_preset(world, state, window, state.active)
}

func select_light(
    input:@Input.State,
    world:&ECS.World,
    state:&State,
    window:&Window
) {
    if input.is_pressed(Input.Key.num1) { apply_preset(world, state, window, Preset.sun) }
    if input.is_pressed(Input.Key.num2) { apply_preset(world, state, window, Preset.spot) }
    if input.is_pressed(Input.Key.num3) { apply_preset(world, state, window, Preset.cube) }
    if input.is_pressed(Input.Key.num4) { apply_preset(world, state, window, Preset.tube) }
    if input.is_pressed(Input.Key.num5) { apply_preset(world, state, window, Preset.point) }
}

func rotate(time:@FrameTime, query:ECS.Query<(&Transform3D, @Rotator3D)>) {
    for (transform, rotator) in query {
        transform.rotation = Math.Quat.angle_axis(
            rotator.y_speed * time.delta,
            Math.Vec3.up()
        ).multiply(transform.rotation).normalized()
    }
}

func main() {
    var application = Application()
    application.resources().insert(State(
        sun:ECS.Entity(),
        spot:ECS.Entity(),
        cube:ECS.Entity(),
        tube:ECS.Entity(),
        point:ECS.Entity(),
        active:Preset.sun
    ))
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene3D — Lighting — 1 SunLight"
        ..width = 1280
        ..height = 720
    ))
    application.add_plugin(TimePlugin())
    application.add_plugin(ViewportCamera3D(ViewportCamera3D.Settings()
        ..target = Math.Vec3(0.0, 0.55, 0.0)
        ..distance = 5.0
        ..min_distance = 2.0
        ..max_distance = 12.0
        ..pitch = Math.radians(-18.0)
        ..vertical_fov = Math.radians(42.0)
        ..near_plane = 0.05
        ..far_plane = 80.0
    ))
    application.add_system(Application.Schedule.startup, create_geometry)
    application.add_system(Application.Schedule.startup, create_lights)
    application.add_after_system(Application.Schedule.startup, activate_default)
    application.add_system(Application.Schedule.pre_update, select_light)
    application.add_system(Application.Schedule.update, rotate)
    application.run()
}
