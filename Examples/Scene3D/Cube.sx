use GFX.Application
use GFX.Application.FrameTime
use GFX.Application.Time as TimePlugin
use GFX.Color
use GFX.ECS
use GFX.Input.Plugin as InputPlugin
use GFX.Scene3D
use GFX.Scene3D.Rotator as Rotator3D
use GFX.Scene3D.Transform as Transform3D
use GFX.Window.Plugin as WindowPlugin
use STD.Math

func create_scene(world:&ECS.World, meshes:&Scene3D.Meshes) {
    let cube = meshes.add(Scene3D.Geometry.Cube.make(Math.Vec3(2.0)))

    world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(position:Math.Vec3(0.0, 0.0, 5.0)))
        ..with(Scene3D.Camera(vertical_fov:Math.radians(55.0)))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Transform3D())
        ..with(Scene3D.Mesh(cube))
        ..with(Scene3D.Material(
            albedo:Color.indigo_400(),
            metallic:0.15,
            roughness:0.28
        ))
        ..with(Rotator3D(x_speed:0.25, y_speed:0.55, z_speed:0.1))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.AmbientLight(
            color:Color.sky_200(),
            intensity:0.12
        ))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.SunLight(
            direction:Math.Vec3(-0.45, -1.0, -0.35),
            color:Color.white(),
            intensity:3.0
        ))
    )
}

func rotate(
    time:@FrameTime,
    query:ECS.Query<(&Transform3D, @Rotator3D)>
) {
    for (transform, rotator) in query {
        let pitch = Math.Quat.angle_axis(
            rotator.x_speed * time.delta,
            Math.Vec3.right()
        )
        let yaw = Math.Quat.angle_axis(
            rotator.y_speed * time.delta,
            Math.Vec3.up()
        )
        let roll = Math.Quat.angle_axis(
            rotator.z_speed * time.delta,
            Math.Vec3.front()
        )
        transform.rotation = yaw.multiply(pitch).multiply(roll)
            .multiply(transform.rotation)
            .normalized()
    }
}

func main() {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene3D — Cube"
        ..width = 960
        ..height = 640
    ))
    application.add_plugin(InputPlugin())
    application.add_plugin(TimePlugin())
    application.add_plugin(Scene3D.Plugin())
    application.add_system(Application.Schedule.startup, create_scene)
    application.add_system(Application.Schedule.update, rotate)
    application.run()
}
