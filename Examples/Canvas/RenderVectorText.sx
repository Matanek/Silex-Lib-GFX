use GFX.Color
use GFX.Canvas
use GFX.Viewer
use STD.Math

func main() {
    var font = Canvas.Font.default()
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "Silex — déjà prêt",
            Math.Vec2(4.0),
            Canvas.TextStyle(size:18.0, color:Color.white(), font:font)
        )
    })
    let image = drawing.rasterize(180, 28)
    assert(image.width() == 180)
    assert(image.height() == 28)
    Viewer.show(image, "GFX.Canvas — Vector text")
}
