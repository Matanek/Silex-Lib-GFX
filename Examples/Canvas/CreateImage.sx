use GFX.Color
use GFX.Canvas
use GFX.Viewer
use STD.Math

func paint_chart(painter:&Canvas.Painter) {
    painter.fill(
        Canvas.Rect(Math.Vec2(0.0), Math.Vec2(320.0, 180.0), 16.0),
        Canvas.Fill.solid(Color.slate_900())
    )

    var graph = Canvas.Path()
        ..move_to(Math.Vec2(24.0, 136.0))
        ..cubic_to(
            Math.Vec2(88.0, 132.0),
            Math.Vec2(112.0, 38.0),
            Math.Vec2(176.0, 76.0)
        )
        ..quadratic_to(Math.Vec2(244.0, 116.0), Math.Vec2(296.0, 32.0))
    painter.stroke(graph, Canvas.Stroke(Color.sky_400(), 5.0))

    painter.text(
        "GFX DRAWING",
        Math.Vec2(24.0, 20.0),
        Canvas.TextStyle(size:18.0, color:Color.white())
    )
}

func main() {
    var drawing = Canvas()..paint(paint_chart)
    let image = drawing.rasterize(320, 180)
    assert(image.width() == 320)
    assert(image.height() == 180)
    Viewer.show(image, "GFX.Canvas — Create image")
}
