use GFX.Audio
use GFX.Application
use GFX.Window
use STD.Math

struct SpatialAudioDemo {
    var sound:Audio.Sound
    var playing:Audio.PlayingSound
    var elapsed:float

    init() {
        self.sound = Audio.Sound()
        self.playing = Audio.PlayingSound()
        self.elapsed = 0.0
    }
}

func begin_demo(audio:&Audio, demo:&SpatialAudioDemo) {
    let tone = audio.load("../../Assets/Audio/SpatialTone.wav")
    demo.sound = tone
    demo.playing = audio.play(tone, Audio.Playback(
        volume:0.2,
        repeat:Audio.Repeat.forever(),
        position:Math.Vec3(-2.0, 0.0, -1.0),
        fade_in_seconds:0.15
    ))
}

func update_demo(
    time:@Application.FrameTime,
    demo:&SpatialAudioDemo,
    audio:&Audio
) {
    demo.elapsed += time.delta
    let x = Math.sin(demo.elapsed as float32) as float * 3.0
    audio.set_position(demo.playing, Math.Vec3(x, 0.0, -1.0))
}

func main() {
    var application = Application()
    application
        ..add_resource(SpatialAudioDemo())
        ..add_plugin(Audio.Plugin())
        ..add_plugin(Application.Time())
        ..add_plugin(Application.FramePacing(60))
        ..add_plugin(Window.Plugin(Window.Plugin.Settings()
            ..title = "GFX Spatial Audio"
            ..width = 640
            ..height = 360
        ))
        ..add_system(Application.Schedule.startup, begin_demo)
        ..add_system(Application.Schedule.update, update_demo)
        ..run()
}
