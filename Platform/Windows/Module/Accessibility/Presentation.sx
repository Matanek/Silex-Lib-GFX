            if property == 30059 as int32 { return variant_array(output,self.provider_array(self.model.selected(token))) }
            if property == 30060 as int32 { variant_boolean(output,element.multiple_selection); return 0 as int32 }
            if property == 30061 as int32 { variant_boolean(output,Description.selection_required(element)); return 0 as int32 }
        }
        if Description.supports(element,10010 as int32) {
            if property == 30079 as int32 { variant_boolean(output,self.selected(element)); return 0 as int32 }
            if property == 30080 as int32 { return self.variant_provider(output,self.selection_container(token)) }
        }
        if property == 30070 as int32 && Description.supports(element,10005 as int32) { var state:int32 = 0 as int32; if element.expanded == true { state = 1 as int32 } variant_integer(output,state); return 0 as int32 }
        if property == 30086 as int32 && Description.supports(element,10015 as int32) { var state:int32 = 0 as int32; if element.checked == true { state = 1 as int32 } variant_integer(output,state); return 0 as int32 }
