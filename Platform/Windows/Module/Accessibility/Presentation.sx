            if token == self.model.window() || !Description.supports(current,detail) { return 0 as int32 }
            if (detail == 10006 as int32 || detail == 10012 as int32) && !self.model.has_rows(token) { return 0 as int32 }
            let facet = Identifiers.pattern_interface(detail)
            if facet < 0 { return 0 as int32 }
            COM.retain(object); C.store<uint>(output,0 as uint,COM.facet(object,facet)); return 0 as int32
        }
        if operation == 4 as int32 {
            if token != self.model.window() { return 0 as int32 }
            return C.call<func(uint,uint) int32>(C.load<uint>(self.context,88 as uint),self.window,output)
        }
        if operation == 10 as int32 { return self.write_provider(output,self.model.navigate(token,detail),1) }
        if operation == 11 as int32 { return self.runtime_id(output,object,token) }
        if operation == 12 as int32 {
            let rectangle = self.rectangle(token,current.bounds)
            C.store<float64>(output,0 as uint,rectangle.x); C.store<float64>(output,8 as uint,rectangle.y)
            C.store<float64>(output,16 as uint,rectangle.width); C.store<float64>(output,24 as uint,rectangle.height)
            return 0 as int32
        }
        if operation == 13 as int32 { return 0 as int32 }
        if operation == 14 as int32 { if token == self.model.window() { return 0 as int32 } return self.perform(token,AX.Request(AX.Action.focus)) }
        if operation == 15 as int32 { return self.write_provider(output,self.model.window(),2) }
