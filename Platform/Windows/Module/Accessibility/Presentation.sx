        if property >= 30027 as int32 && property <= 30044 as int32 {
            let pattern = Description.property_pattern(property)
            var supported = !root && Description.supports(element,pattern)
            if (pattern == 10006 as int32 || pattern == 10012 as int32) && !self.model.has_rows(token) { supported = false }
            // Root Window information comes from the system HWND provider.
            if root && property == 30044 as int32 { return 0 as int32 }
            variant_boolean(output,supported); return 0 as int32
        }
        if property == 30045 as int32 && Description.supports(element,10002 as int32) { return variant_text(output,element.value ?? "") }
        if (property == 30046 as int32 && Description.supports(element,10002 as int32)) || (property == 30048 as int32 && Description.supports(element,10003 as int32)) {
            variant_boolean(output,Description.read_only(element)); return 0 as int32
        }
        if Description.supports(element,10003 as int32) {
            if property == 30047 as int32 { variant_double(output,(element.number ?? 0.0) as float64); return 0 as int32 }
            if property == 30049 as int32 { variant_double(output,(element.minimum ?? 0.0) as float64); return 0 as int32 }
            if property == 30050 as int32 { variant_double(output,(element.maximum ?? 0.0) as float64); return 0 as int32 }
            if property == 30051 as int32 || property == 30052 as int32 { C.store<uint16>(output,0 as uint,5 as uint16); Native.nan(output+8 as uint); return 0 as int32 }
        }
