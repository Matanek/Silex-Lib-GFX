use Interop.C

// All managed state belongs to HWND's thread. COM objects contain only native
// context/token/span storage; foreign requests are sent to that window.
package nocopy class Host {
    private var model:Model
    private var context:uint = 0 as uint
    private let window:uint
    private var height:float
    private var origin:Math.Vec2
    private var providers:Dictionary<uint,uint> = Dictionary<uint,uint>()
    private var snapshots:Dictionary<uint,AX.Element> = Dictionary<uint,AX.Element>()
    private var com_owned:bool = false
    private var wake_event:uint32 = 0 as uint32
    private var wake_pending:bool = false
    private var flushing:bool = false

    init(source:AX.Source,view:uint,window:uint,height:float,flipped:bool,origin:Math.Vec2) {
        self.model = Model(source); self.window = window; self.height = height; self.origin = origin
        self.attach()
    }
    private func attach() {
        let window = self.window
        if window == 0 as uint || Native.window_thread(window) != Native.thread() { return }
        let initialized = Native.initialize_com()
        self.com_owned = initialized == 0 as int32 || initialized == 1 as int32
        // RPC_E_CHANGED_MODE means the application already chose another
        // apartment. Source is still marshalled to HWND, including MTA calls.
        if !self.com_owned && initialized != -2147417850 as int32 { return }
        let message = Native.message_id()
        if message == 0 as uint32 { self.remove(); return }
        let context = Native.context(window,C.object_address(self),message)
        if context == 0 as uint { self.remove(); return }
        self.context = context; COM.initialize_tables(context)
        if !Native.install(window,C.function_address(window_callback),context) { self.remove(); return }
        self.wake_event = Wake.register(); Native.activate(context)
    }
    func remove() {
        let context = self.context; self.context = 0 as uint
        let com_owned = self.com_owned; self.com_owned = false
        if context != 0 as uint {
            Native.invalidate(context)
            Native.uninstall(self.window,C.function_address(window_callback),context)
            self.model.remove()
            for token in self.providers.get_keys() {
                if let object = self.providers.find(token) { Native.disconnect(context,object); COM.release(object) }
            }
            self.providers.clear(); self.snapshots.clear(); Native.release_context(context)
        }
        if com_owned { Native.uninitialize_com() }
    }
    drop { self.remove() }
    func root_handle() uint { if self.context == 0 as uint { return 0 as uint } return self.provider(self.model.window()) }
    func peer_count() int { return self.providers.count() }
    private func read(token:uint) AX.Element? {
        if self.context == 0 as uint { return null }
        if token == self.model.window() { return AX.Element(id:"window",enabled:Native.enabled(self.window),focusable:true) }
        return self.model.element(token)
    }
    private func provider(token:uint) uint {
        if token == 0 as uint || self.context == 0 as uint { return 0 as uint }
        if let object = self.providers.find(token) { return object }
        if let element = self.read(token) {
            let object = COM.create(self.context,token)
            if object != 0 as uint { self.providers.set(token,object); self.snapshots.set(token,element) }
            return object
        }
        return 0 as uint
    }
    private func write_provider(output:uint,token:uint,facet:int = 0) int32 {
        if token == 0 as uint { return 0 as int32 }
        let object = self.provider(token); if object == 0 as uint { return Native.unavailable() }
        let value = COM.facet(object,facet); COM.retain(value); C.store<uint>(output,0 as uint,value); return 0 as int32
    }
    private func provider_array(tokens:uint[]) uint {
        let array = Native.array(13 as uint16,tokens.count())
        if array == 0 as uint { return 0 as uint }
        var index = 0
        for token in tokens {
            let object = self.provider(token)
            if object == 0 as uint || !Native.put(array,index,object) { Native.destroy_array(array); return 0 as uint }
            index++
        }
        return array
    }
    private func scale() float64 {
        if self.height <= 0.0 { return 1.0 as float64 }
        let height = Native.client_height(self.window)
        if height <= 0 { return 1.0 as float64 }
        return height as float64/self.height as float64
    }
    private func rectangle(token:uint,bounds:AX.Bounds) Types.Rectangle {
        if token == self.model.window() {
            let (x,y,width,height) = Native.window_bounds(self.window)
            return Types.Rectangle(x:x as float64,y:y as float64,width:width as float64,height:height as float64)
        }
        let (x,y) = Native.screen_origin(self.window); let scale = self.scale()
        return Types.Rectangle(x:x as float64+(bounds.x as float64+self.origin.x as float64)*scale,y:y as float64+(bounds.y as float64+self.origin.y as float64)*scale,width:bounds.width as float64*scale,height:bounds.height as float64*scale)
    }
    private func local_point(x:float64,y:float64) Math.Vec2? {
        let (left,top) = Native.screen_origin(self.window); let scale = self.scale()
        let local_x = round_float<float32>((x-left as float64)/scale-self.origin.x as float64)
        let local_y = round_float<float32>((y-top as float64)/scale-self.origin.y as float64)
        if !Math.is_finite(local_x) || !Math.is_finite(local_y) { return null }
        return Math.Vec2(local_x,local_y)
    }
    private func perform(token:uint,request:AX.Request) int32 {
        if let element = self.read(token) {
            if !element.enabled || !Native.enabled(self.window) { return Native.disabled() }
            if !Description.has(element,request.action) { return Native.unsupported() }
            if self.model.perform(token,request) {
                if !self.wake_pending { self.wake_pending = Wake.push(self.wake_event) }
                return 0 as int32
            }
        }
        return Native.unsupported()
    }
    private func runtime_id(output:uint,object:uint,token:uint) int32 {
        if token == self.model.window() { return 0 as int32 }
        let array = Native.array(3 as uint16,7)
        if array == 0 as uint { return Native.out_of_memory() }
        var append:int32 = 3 as int32
        if !Native.put(array,0,C.address_bits(C.mutable_pointer(append))) { Native.destroy_array(array); return Native.out_of_memory() }
        var index = 0
        while index < 6 {
            var value:int32 = 0 as int32
            if index < 4 { value = C.load<int32>(self.context,(336+index*4) as uint) }
            else { value = C.load<int32>(object,(24+(index-4)*4) as uint) }
            if !Native.put(array,index+1,C.address_bits(C.mutable_pointer(value))) { Native.destroy_array(array); return Native.out_of_memory() }
            index++
        }
        C.store<uint>(output,0 as uint,array); return 0 as int32
    }
    private func property(token:uint,element:AX.Element,property:int32,output:uint) int32 {
        let root = token == self.model.window()
        if property == 30003 as int32 { var kind = Description.control_type(element.role); if root { kind = 50032 as int32 } variant_integer(output,kind); return 0 as int32 }
        if property == 30005 as int32 { var name = element.name; if root { name = Native.title(self.window) } return variant_text(output,name) }
        if property == 30008 as int32 { let focused = Native.focused(self.window) && self.model.focused() == token; variant_boolean(output,focused); return 0 as int32 }
        if property == 30009 as int32 { variant_boolean(output,element.focusable); return 0 as int32 }
        if property == 30010 as int32 { variant_boolean(output,element.enabled && Native.enabled(self.window)); return 0 as int32 }
        if property == 30011 as int32 { return variant_text(output,element.id) }
        if property == 30012 as int32 || property == 30024 as int32 { return variant_text(output,"Silex") }
        if property == 30013 as int32 { return variant_text(output,element.description) }
        if property == 30016 as int32 || property == 30017 as int32 { variant_boolean(output,true); return 0 as int32 }
        if property == 30018 as int32 {
            if let id = element.labelled_by {
                let object = self.provider(self.model.peer(id))
                if object != 0 as uint { COM.retain(object); C.store<uint16>(output,0 as uint,13 as uint16); C.store<uint>(output,8 as uint,object) }
            }
            return 0 as int32
        }
