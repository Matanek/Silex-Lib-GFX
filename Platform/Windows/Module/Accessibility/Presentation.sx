        if property == 30020 as int32 { var handle:int32 = 0 as int32; if root { handle = C.load<int32>(self.context,8 as uint) } variant_integer(output,handle); return 0 as int32 }
        if property == 30022 as int32 { variant_boolean(output,element.offscreen || !Native.visible(self.window)); return 0 as int32 }
        if property == 30023 as int32 {
            var orientation:int32 = 0 as int32
            if element.role == AX.Role.slider || element.role == AX.Role.scrollbar { orientation = 2 as int32; if element.horizontal { orientation = 1 as int32 } }
            variant_integer(output,orientation); return 0 as int32
        }
