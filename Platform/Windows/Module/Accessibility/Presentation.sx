    private func variant_provider(output:uint,token:uint) int32 {
        if token == 0 as uint { C.store<uint16>(output,0 as uint,13 as uint16); return 0 as int32 }
        let object = self.provider(token)
        if object == 0 as uint { return Native.unavailable() }
        COM.retain(object); C.store<uint16>(output,0 as uint,13 as uint16); C.store<uint>(output,8 as uint,object); return 0 as int32
    }
    private func selection_container(token:uint) uint {
        var parent = self.model.parent(token); var seen = Dictionary<uint,bool>()
        while parent != 0 as uint {
            if seen.contains(parent) { return 0 as uint } seen.set(parent,true)
            if let element = self.model.element(parent) { if Description.selection(element) { return parent } }
            parent = self.model.parent(parent)
        }
        return 0 as uint
    }
    private func selected(element:AX.Element) bool { return Description.selected(element) }
    private func select_item(token:uint,element:AX.Element,operation:int32) int32 {
        if !element.enabled || !Native.enabled(self.window) { return Native.disabled() }
        let container = self.selection_container(token)
        if operation == 34 as int32 {
            if !self.selected(element) { return 0 as int32 }
            if element.role == AX.Role.radio || element.role == AX.Role.tab { return Native.invalid_operation() }
            return self.perform(token,AX.Request(AX.Action.deselect))
        }
        if operation == 33 as int32 {
            if self.selected(element) { return 0 as int32 }
            if let owner = self.model.element(container) {
                if !owner.multiple_selection && !self.model.selected(container).is_empty() { return Native.invalid_operation() }
            }
        } elif element.role != AX.Role.radio && element.role != AX.Role.tab {
            // Radio/tab activation already replaces the exclusive selection.
            // Other multi-selection containers need an explicit clear for Select.
            for other in self.model.selected(container) {
                if other != token {
                    let result = self.perform(other,AX.Request(AX.Action.deselect)); if result < 0 as int32 { return result }
                }
            }
        }
        if self.selected(element) { return 0 as int32 }
        if Description.has(element,AX.Action.select) { return self.perform(token,AX.Request(AX.Action.select)) }
        if element.role == AX.Role.radio || element.role == AX.Role.tab { return self.perform(token,AX.Request(AX.Action.activate)) }
        return Native.unsupported()
    }

    // Called only by the validated HWND callback on its owner thread.
    func native_message(message:uint32,wparam:uint,lparam:int) int {
        let context = self.context
        if context == 0 as uint { return Native.next(self.window,message,wparam,lparam) }
        if message == 0x82 as uint32 { self.remove(); return Native.next(self.window,message,wparam,lparam) }
        if message == 0x3d as uint32 && lparam == -25 {
            let provider = self.root_handle()
            if provider == 0 as uint { return 0 }
            COM.retain(provider)
            let result = C.call<func(uint,uint,int,uint) int>(C.load<uint>(context,80 as uint),self.window,wparam,lparam,provider)
            COM.release(provider); return result
        }
        if message == C.load<uint32>(context,28 as uint) && wparam == context && lparam > 0 {
            let packet = lparam as uint
            if Native.is_packet(context,packet) && C.load<uint>(packet,0 as uint) == context {
                let object = C.load<uint>(packet,8 as uint)
                if Native.owns_object(context,object) {
                    COM.retain(object)
                    let status = self.dispatch(packet,object)
                    COM.release(object)
                    C.store<int32>(packet,64 as uint,status)
                    return 0
                }
            }
        }
        return Native.next(self.window,message,wparam,lparam)
    }
    private func dispatch(packet:uint,object:uint) int32 {
