func text_selection_mode(this:uint,output:uint) int32 { return integer(this,62 as int32,output) }
func window_state(this:uint,state:int32) int32 { return finish(make(this,70 as int32,detail:state)) }
func window_close(this:uint) int32 { return finish(make(this,71 as int32)) }
func window_idle(this:uint,milliseconds:int32,output:uint) int32 { return integer(this,72 as int32,output,first:milliseconds as int) }
func can_maximize(this:uint,output:uint) int32 { return integer(this,73 as int32,output) }
func can_minimize(this:uint,output:uint) int32 { return integer(this,74 as int32,output) }
func is_modal(this:uint,output:uint) int32 { return integer(this,75 as int32,output) }
