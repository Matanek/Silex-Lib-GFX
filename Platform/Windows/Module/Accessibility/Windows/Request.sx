func is_topmost(this:uint,output:uint) int32 { return integer(this,78 as int32,output) }
func find_attribute(this:uint,attribute:int32,value:Types.Variant,backward:int32,output:uint) int32 { if output == 0 as uint { return Native.pointer_error() } C.store<uint>(output,0 as uint,0 as uint); let packet = make(this,104 as int32,output,detail:attribute,first:backward as int); if packet == 0 as uint { return Native.out_of_memory() } C.store<uint>(packet,80 as uint,value.tag); C.store<uint>(packet,88 as uint,value.value); C.store<uint>(packet,96 as uint,value.extra); return finish(packet) }
func clone(this:uint,output:uint) int32 { return pointer(this,100 as int32,output) }
func compare(this:uint,other:uint,output:uint) int32 { return other_range(this,101 as int32,other,output) }
func compare_endpoints(this:uint,endpoint:int32,other:uint,target:int32,output:uint) int32 { return other_range(this,102 as int32,other,output,endpoint,target as int) }
func enclose(this:uint,unit:int32) int32 { return finish(make(this,103 as int32,detail:unit)) }
func find_text(this:uint,text:uint,backward:int32,ignore_case:int32,output:uint) int32 { return pointer(this,105 as int32,output,detail:backward,first:ignore_case as int,second:text) }
func attribute(this:uint,attribute:int32,output:uint) int32 { return variant(this,106 as int32,attribute,output) }
func text_bounds(this:uint,output:uint) int32 { return pointer(this,107 as int32,output) }
func enclosing_element(this:uint,output:uint) int32 { return pointer(this,108 as int32,output) }
func get_text(this:uint,maximum:int32,output:uint) int32 { return pointer(this,109 as int32,output,first:maximum as int) }
func move_range(this:uint,unit:int32,count:int32,output:uint) int32 { return integer(this,110 as int32,output,detail:unit,first:count as int) }
func move_endpoint(this:uint,endpoint:int32,unit:int32,count:int32,output:uint) int32 { return integer(this,111 as int32,output,detail:endpoint,first:count as int,third:unit as int) }
func move_to_range(this:uint,endpoint:int32,other:uint,target:int32) int32 { return other_range(this,112 as int32,other,endpoint:endpoint,target:target as int) }
func select_text(this:uint) int32 { return finish(make(this,113 as int32)) }
func add_text_selection(this:uint) int32 { return finish(make(this,114 as int32)) }
func remove_text_selection(this:uint) int32 { return finish(make(this,115 as int32)) }
func scroll_text(this:uint,align_top:int32) int32 { return finish(make(this,116 as int32,detail:align_top)) }
func text_children(this:uint,output:uint) int32 { return pointer(this,117 as int32,output) }

package func initialize_tables(context:uint) {
    let tables:uint[][] = [
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(options), C.function_address(pattern), C.function_address(property), C.function_address(host)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(navigate), C.function_address(runtime_id), C.function_address(rectangle), C.function_address(embedded_roots), C.function_address(set_focus), C.function_address(fragment_root)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(element_at), C.function_address(focused)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(invoke)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(set_string), C.function_address(get_string), C.function_address(read_only)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(set_number), C.function_address(get_number), C.function_address(read_only), C.function_address(maximum), C.function_address(minimum), C.function_address(large_change), C.function_address(small_change)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(toggle), C.function_address(toggle_state)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(select), C.function_address(add_selection), C.function_address(remove_selection), C.function_address(is_selected), C.function_address(selection_container)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(get_selection), C.function_address(multiple_selection), C.function_address(selection_required)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(expand), C.function_address(collapse), C.function_address(expanded_state)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(reveal)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(grid_item), C.function_address(rows), C.function_address(columns)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(row), C.function_address(column), C.function_address(row_span), C.function_address(column_span), C.function_address(containing_grid)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(row_headers), C.function_address(column_headers), C.function_address(major_axis)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(cell_row_headers), C.function_address(cell_column_headers)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(text_selection), C.function_address(visible_ranges), C.function_address(range_from_child), C.function_address(range_from_point), C.function_address(document_range), C.function_address(text_selection_mode)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(window_state), C.function_address(window_close), C.function_address(window_idle), C.function_address(can_maximize), C.function_address(can_minimize), C.function_address(is_modal), C.function_address(visual_state), C.function_address(interaction_state), C.function_address(is_topmost)],
        [C.function_address(query), C.function_address(retain), C.function_address(release), C.function_address(clone), C.function_address(compare), C.function_address(compare_endpoints), C.function_address(enclose), C.function_address(find_attribute), C.function_address(find_text), C.function_address(attribute), C.function_address(text_bounds), C.function_address(enclosing_element), C.function_address(get_text), C.function_address(move_range), C.function_address(move_endpoint), C.function_address(move_to_range), C.function_address(select_text), C.function_address(add_text_selection), C.function_address(remove_text_selection), C.function_address(scroll_text), C.function_address(text_children)]
    ]
    var offset:uint = 384 as uint; var index = 0
    for table in tables {
        assert(offset+(table.count()*8) as uint <= 2048 as uint)
        C.store<uint>(context,(160+index*8) as uint,context+offset)
        for method in table { C.store<uint>(context,offset,method); offset += 8 as uint }
        index++
    }
}
