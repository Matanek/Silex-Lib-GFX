func row_subrole(element:AX.Element) str? {
    if element.role == AX.Role.dialog { return "AXDialog" }
    if element.role == AX.Role.tab { return "AXTabButton" }
    if element.role == AX.Role.column_header && supports(element, AX.Action.activate) { return "AXSortButton" }
    if element.role == AX.Role.row { return "AXTableRow" }
    if element.role == AX.Role.tree_item { return "AXOutlineRow" }
    return null
}

// Conversion runs only for an accessibility query/action on this text control,
// never per frame or across the semantic tree. No cached string or global state.
func has_text_selection(element:AX.Element) bool {
    return element.value != null && element.selection_anchor != null && element.selection_cursor != null
}
func text_index(index:int, count:int) int {
    if index < 0 { return 0 }
    if index > count { return count }
    return index
}
func utf16_boundaries(text:str) uint[] {
    let boundaries = Grapheme.boundaries(text)
    var offsets:uint[] = [0]
    var bytes = 0; var units = 0 as uint; var next = 1
    for scalar in UTF8.scalars(text) {
        if scalar <= 127 { bytes++ }
        elif scalar <= 2047 { bytes += 2 }
        elif scalar <= 65535 { bytes += 3 }
        else { bytes += 4 }
        units++
        if scalar > 65535 { units++ }
        if next < boundaries.count() && bytes == boundaries[next] { offsets.append(units); next++ }
    }
    return offsets
}
func selected_span(element:AX.Element, offsets:uint[]) uint[2] {
    let anchor = text_index(element.selection_anchor!, offsets.count() - 1)
    let cursor = text_index(element.selection_cursor!, offsets.count() - 1)
    var start = anchor; var end = cursor
    if start > end { start = cursor; end = anchor }
    return [offsets[start], offsets[end] - offsets[start]]
}

func copy_children(native:uint, method:uint, zone:uint) uint { return object(native, "retain") }

func supports(element:AX.Element, action:AX.Action) bool {
    if !element.enabled { return false }
    for available in element.actions { if action == available { return true } }
    return false
}
func action(method:uint, element:AX.Element) AX.Action? {
    if method == selector("accessibilityPerformShowMenu") { return AX.Action.expand }
    if method == selector("accessibilityPerformIncrement") && !supports(element,AX.Action.increment) { return AX.Action.scroll_forward }
    if method == selector("accessibilityPerformDecrement") && !supports(element,AX.Action.decrement) { return AX.Action.scroll_backward }
    if method == selector("accessibilityPerformCancel") { return AX.Action.dismiss }
    if method == selector("accessibilityPerformPress") { return AX.Action.activate }
    if method == selector("setAccessibilityFocused:") { return AX.Action.focus }
    if method == selector("setAccessibilityValue:") { return AX.Action.set_value }
    if method == selector("accessibilityPerformIncrement") { return AX.Action.increment }
    if method == selector("accessibilityPerformDecrement") { return AX.Action.decrement }
    return null
}
func role(value:AX.Role) str {
    if value == AX.Role.column { return "AXColumn" }
    if value == AX.Role.column_header { return "AXButton" }
    if value == AX.Role.tab_group { return "AXTabGroup" }
    if value == AX.Role.tab { return "AXRadioButton" }
    if value == AX.Role.tooltip { return "AXHelpTag" }
    if value == AX.Role.scrollbar { return "AXScrollBar" }
    if value == AX.Role.separator { return "AXSplitter" }
    if value == AX.Role.button { return "AXButton" }
    if value == AX.Role.text { return "AXStaticText" }
    if value == AX.Role.text_field { return "AXTextField" }
    if value == AX.Role.text_area { return "AXTextArea" }
    if value == AX.Role.checkbox { return "AXCheckBox" }
    if value == AX.Role.radio { return "AXRadioButton" }
    if value == AX.Role.radio_group { return "AXRadioGroup" }
    if value == AX.Role.slider { return "AXSlider" }
    if value == AX.Role.list { return "AXList" }
    if value == AX.Role.tree { return "AXOutline" }
    if value == AX.Role.table { return "AXTable" }
    if value == AX.Role.row || value == AX.Role.list_item || value == AX.Role.tree_item { return "AXRow" }
    if value == AX.Role.cell { return "AXCell" }
    if value == AX.Role.scroll_view { return "AXScrollArea" }
    if value == AX.Role.progress { return "AXProgressIndicator" }
    if value == AX.Role.image { return "AXImage" }
    if value == AX.Role.menu { return "AXMenu" }
    if value == AX.Role.menu_item { return "AXMenuItem" }
    if value == AX.Role.combo_box { return "AXComboBox" }
    return "AXGroup"
}
func notification(kind:AX.ChangeKind) str {
    if kind == AX.ChangeKind.focus { return "AXFocusedUIElementChanged" }
    if kind == AX.ChangeKind.value { return "AXValueChanged" }
    if kind == AX.ChangeKind.selection { return "AXSelectedChildrenChanged" }
    if kind == AX.ChangeKind.name { return "AXTitleChanged" }
    return "AXLayoutChanged"
}

