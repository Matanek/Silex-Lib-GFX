    }
    // Foundation marshals NSRange itself. Use the runtime's forwarding IMP,
    // not a scalar callback masquerading as an aggregate-returning function.
    // NSRange is two NSUInteger (16 bytes) on both distributed macOS targets.
    let trampoline = C.address_bits(method_implementation(C.pointer_bits(system_class("NSObject")), C.pointer_bits(selector("silexUnimplementedTextRange"))))
    for name in ["accessibilitySelectedTextRange", "accessibilityRowIndexRange", "accessibilityColumnIndexRange"] {
        add(type, name, trampoline, "{_NSRange=QQ}@:")
    }
    add(type, "setAccessibilitySelectedTextRange:", trampoline, "v@:{_NSRange=QQ}")
    add(type,"accessibilityVisibleCharacterRange",trampoline,"{_NSRange=QQ}@:")
    add(type,"accessibilityRangeForLine:",trampoline,"{_NSRange=QQ}@:q")
    add(type,"accessibilityRangeForIndex:",trampoline,"{_NSRange=QQ}@:q")
    add(type,"accessibilityRangeForPosition:",trampoline,"{_NSRange=QQ}@:{CGPoint=dd}")
    add(type,"accessibilityLineForIndex:",trampoline,"q@:q")
    add(type,"accessibilityStringForRange:",trampoline,"@@:{_NSRange=QQ}")
    let rectangle_trampoline = Target.rectangle_forwarding()
    add(type,"accessibilityFrameForRange:",rectangle_trampoline,"{CGRect={CGPoint=dd}{CGSize=dd}}@:{_NSRange=QQ}")
    let forward:func(uint,uint,uint) void = forward_range
    add(type, "forwardInvocation:", C.function_address(forward), "v@:@")
    let state:func(uint,uint) uint8 = read_state
    for name in ["isAccessibilityElement", "isAccessibilityEnabled", "isAccessibilityFocused", "isAccessibilitySelected", "isAccessibilityExpanded", "isAccessibilityDisclosed", "isAccessibilityModal"] {
        add(type, name, C.function_address(state), "B@:")
    }
    let check:func(uint,uint,uint) uint8 = allowed
    add(type, "isAccessibilitySelectorAllowed:", C.function_address(check), "B@::")
    let perform:func(uint,uint) uint8 = press
    for name in ["accessibilityPerformPress", "accessibilityPerformIncrement", "accessibilityPerformDecrement", "accessibilityPerformCancel", "accessibilityPerformShowMenu"] {
        add(type, name, C.function_address(perform), "B@:")
    }
    let focus:func(uint,uint,uint8) void = set_focused
    add(type, "setAccessibilityFocused:", C.function_address(focus), "v@:B")
    let state_setter:func(uint,uint,uint8) void = set_state
    for name in ["setAccessibilitySelected:", "setAccessibilityExpanded:", "setAccessibilityDisclosed:"] {
        add(type, name, C.function_address(state_setter), "v@:B")
    }
    let value:func(uint,uint,uint) void = set_value
    add(type, "setAccessibilityValue:", C.function_address(value), "v@:@")
    register_class(C.pointer_bits(type)); return type
}
func children_class() uint {
    var type = system_class("SilexAccessibilityChildren")
    if type != 0 as uint { return type }
    type = C.address_bits(allocate_class(C.pointer_bits(system_class("NSArray")), C.terminated_pointer("SilexAccessibilityChildren"), 0 as uint))
    let count:func(uint,uint) uint = array_count
    let child:func(uint,uint,uint) uint = array_child
    let copy_callback:func(uint,uint,uint) uint = copy_children
    add(type, "count", C.function_address(count), "Q@:")
    add(type, "objectAtIndex:", C.function_address(child), "@@:Q")
    add(type, "copyWithZone:", C.function_address(copy_callback), "@@:^v")
    register_class(C.pointer_bits(type)); return type
}
func selector(name:str) uint { return C.address_bits(register_selector(C.terminated_pointer(name))) }
func system_class(name:str) uint { return C.address_bits(get_class(C.terminated_pointer(name))) }
func object(receiver:uint, name:str) uint { return send(receiver, selector(name)) }
func string(value:str) uint { return send_object(system_class("NSString"), selector("stringWithUTF8String:"), C.address_bits(C.terminated_pointer(value))) }
func number(value:float) uint { return send_double(system_class("NSNumber"), selector("numberWithDouble:"), value as float64) }
func retain(value:uint) { let held = object(value, "retain") }
func release(value:uint) { send_void(value, selector("release")) }
func release_pool(value:uint) { send_void(value, selector("drain")) }
func copy_string(value:uint) str {
    let count = send_object(value, selector("lengthOfBytesUsingEncoding:"), 4 as uint)
    let data = object(value, "UTF8String")
    var bytes:uint8[] = []
    var index = 0 as uint
    while index < count { bytes.append(C.load<uint8>(data, index)); index++ }
    return C.string(@bytes[0:bytes.count()])
}
func set_frame(element:uint, x:float, y:float, width:float, height:float) {
    let method = selector("setAccessibilityFrameInParentSpace:")
    let signature = send_object(element, selector("methodSignatureForSelector:"), method)
    let invocation = send_object(system_class("NSInvocation"), selector("invocationWithMethodSignature:"), signature)
    send_void_object(invocation, selector("setSelector:"), method)
    send_void_object(invocation, selector("setTarget:"), element)
    var rect:float64[4] = [x as float64, y as float64, width as float64, height as float64]
    set_argument(invocation, selector("setArgument:atIndex:"), C.address_bits(C.mutable_pointer(rect)), 2)
    send_void(invocation, selector("invoke"))
}
func notify(element:uint, name:str) { post_notification(element, string(name)) }
func view(window:uint) uint { return object(window, "contentView") }
func flipped(view:uint) bool { return read_bool(view, selector("isFlipped")) != 0 as uint8 }

