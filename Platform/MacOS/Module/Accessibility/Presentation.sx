func cell_index(element:AX.Element, method:uint) int? {
    if element.role != AX.Role.cell { return null }
    var result:int? = null
    if method == selector("accessibilityRowIndexRange") { result = element.row_index }
    elif method == selector("accessibilityColumnIndexRange") { result = element.column_index }
    if let value = result { if value >= 0 { return value } }
