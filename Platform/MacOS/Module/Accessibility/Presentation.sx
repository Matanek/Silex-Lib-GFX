use GFX.Accessibility as AX
use STD.Collections.Dictionary
use STD.Math
use STD.Text.Grapheme
use STD.Text.UTF8
use Interop.C
use Interop.Boundary

// One owner per presented source, confined to the AppKit/UI thread. Native
// objects hold unretained contexts; remove() invalidates them before any owner
// or window can die. AppKit may retain a detached element or children array.
nocopy class Peer {
    let owner:uint
    let id:str
    let handle:uint
    let children:uint
    let rows:uint
    let columns:uint
    let selected_rows:uint
    var expanded:bool? = null
    init(owner:uint, id:str) {
        self.owner = owner; self.id = id
        self.handle = object(element_class(), "new")
        self.children = object(children_class(), "new")
        self.rows = object(children_class(), "new")
        self.columns = object(children_class(), "new")
        self.selected_rows = object(children_class(), "new")
        associate(self.handle, C.object_address(self))
        associate(self.children, C.object_address(self))
        associate(self.rows, C.object_address(self))
        associate(self.columns, C.object_address(self))
        associate(self.selected_rows, C.object_address(self))
    }
    func detach() { associate(self.handle, 0 as uint); associate(self.children, 0 as uint); associate(self.rows, 0 as uint); associate(self.columns, 0 as uint); associate(self.selected_rows, 0 as uint) }
    drop { self.detach(); release(self.selected_rows); release(self.columns); release(self.rows); release(self.children); release(self.handle) }
}

package nocopy class Host {
    private var source:AX.Source
    private var peers:Dictionary<str, Peer> = Dictionary<str, Peer>()
    private let view:uint
    private let window:uint
    private let previous_children:uint
    private let previous_element:uint8
    private var root_id:str? = null
    private var active:bool = true
    private var dirty:bool = false
    private var height:float
    private var origin:Math.Vec2
    private let flipped:bool
    private var wake_event:uint32 = 0 as uint32

    // view/window may be zero for the owning headless AppKit tests. This never
    // initializes NSApplication, SDL or a native window.
    init(source:AX.Source, view:uint, window:uint, height:float, flipped:bool, origin:Math.Vec2) {
        let pool = object(system_class("NSAutoreleasePool"), "new")
        self.source = source; self.view = view; self.window = window
        self.height = height; self.flipped = flipped; self.origin = origin
        self.previous_children = object(view, "accessibilityChildren")
        retain(self.previous_children)
        self.previous_element = read_bool(view, selector("isAccessibilityElement"))
        if view != 0 as uint {
            send_bool(view, selector("setAccessibilityElement:"), 0 as uint8)
            self.wake_event = register_events(1 as int32)
        }
        self.refresh_root()
        release_pool(pool)
    }

    func root_handle() uint {
        if !self.active { return 0 as uint }
        if let id = self.source.root() { return self.peer(id) }
        return 0 as uint
    }
    func peer_count() int { return self.peers.count() }

    func synchronize(height:float, origin:Math.Vec2?) bool {
        if !self.active { return false }
        let next_origin = origin ?? self.origin
        let moved = self.height != height || self.origin != next_origin
        self.height = height
        self.origin = next_origin
        let pool = object(system_class("NSAutoreleasePool"), "new")
        self.refresh_root()
        // Presentation movement affects only the root's view-relative frame.
        // Descendants remain parent-relative: never enumerate the collection.
        if moved {
            if let id = self.root_id {
                if let peer = self.peers.find(id) {
                    if let element = self.source.read(id) { self.frame(peer, element); notify(peer.handle, "AXLayoutChanged") }
                }
            }
        }
        let changed = self.dirty
        self.dirty = false
        for change in self.source.changes() {
            if var peer = self.peers.find(change.id) {
                if change.kind == AX.ChangeKind.removed {
                    notify(peer.handle, "AXUIElementDestroyed")
                    peer.detach()
                    let removed = self.peers.remove(change.id)
                } else {
                    var event_name = notification(change.kind)
                    if let element = self.source.read(change.id) {
                        if change.kind == AX.ChangeKind.selection && has_text_selection(element) {
                            event_name = "AXSelectedTextChanged"
                        }
                        if change.kind == AX.ChangeKind.state {
                            if element.role == AX.Role.tree_item && element.expanded != null && element.expanded != peer.expanded {
                                if element.expanded == true { event_name = "AXRowExpanded" }
                                else { event_name = "AXRowCollapsed" }
                            }
                            peer.expanded = element.expanded
                        }
                        if change.kind == AX.ChangeKind.selection &&
                            (element.role == AX.Role.table || element.role == AX.Role.tree || element.role == AX.Role.list) {
                            event_name = "AXSelectedRowsChanged"
                        }
                        self.frame(peer, element)
                        // A semantic checked-state change is a native value
                        // change for checkboxes and radio buttons.
                        if change.kind == AX.ChangeKind.state && element.checked != null {
                            notify(peer.handle, "AXValueChanged")
                        }
                    }
                    notify(peer.handle, event_name)
                }
            }
        }
        release_pool(pool)
        return changed
    }

    private func refresh_root() {
        let id = self.source.root()
        if id == self.root_id { return }
        self.root_id = id
        if self.view == 0 as uint { return }
        var children = object(system_class("NSArray"), "array")
        if let root = id {
            children = send_object(system_class("NSArray"), selector("arrayWithObject:"), self.peer(root))
        }
        send_void_object(self.view, selector("setAccessibilityChildren:"), children)
        notify(self.view, "AXLayoutChanged")
    }

    func peer(id:str) uint {
        if !self.active { return 0 as uint }
        if let peer = self.peers.find(id) { return peer.handle }
        if let element = self.source.read(id) {
            var peer = Peer(C.object_address(self), id)
            peer.expanded = element.expanded
            let previous = self.peers.set(id, peer)
            self.frame(peer, element)
            return peer.handle
        }
        return 0 as uint
    }

    private func frame(peer:Peer, element:AX.Element) {
        var x = element.bounds.x; var y = element.bounds.y
        var height = self.height
        var flipped = self.flipped
        var nested = false
        if let parent = element.parent {
            if let description = self.source.read(parent) {
                x -= description.bounds.x; y -= description.bounds.y
                height = description.bounds.height; flipped = false
                nested = true
            }
        }
        if !nested { x += self.origin.x; y += self.origin.y }
        if !flipped { y = height - y - element.bounds.height }
        set_frame(peer.handle, x, y, element.bounds.width, element.bounds.height)
    }

    module func property(peer:Peer, method:uint) uint {
        if !self.active { return 0 as uint }
        if let element = self.source.read(peer.id) {
            if method == selector("accessibilityRole") { if element.role == AX.Role.column_header && !supports(element, AX.Action.activate) { return string("AXStaticText") }
                return string(role(element.role)) }
            if method == selector("accessibilitySubrole") {
                if let name = row_subrole(element) { return string(name) }
                return 0 as uint
            }
            if method == selector("accessibilityLabel") || method == selector("accessibilityTitle") { return string(element.name) }
            if method == selector("accessibilityHelp") {
                if let shortcut = element.shortcut {
                    if element.description == "" { return string(shortcut) }
                    return string(element.description+" · "+shortcut)
                }
                return string(element.description)
            }
            if method == selector("accessibilityIdentifier") { return string(element.id) }
            if method == selector("accessibilityValue") {
                var checked_state = element.checked
                if element.role == AX.Role.tab { checked_state = element.selected }
                if let checked = checked_state {
                    var value = 0.0; if checked { value = 1.0 }
                    return number(value)
                }
                if let value = element.number { return number(value) }
                if let value = element.value { return string(value) }
                return 0 as uint
            }
            if method == selector("accessibilitySelectedText") {
                if !has_text_selection(element) { return 0 as uint }
                let text = element.value!
                let offsets = Grapheme.boundaries(text)
                let first = text_index(element.selection_anchor!, offsets.count() - 1)
                let last = text_index(element.selection_cursor!, offsets.count() - 1)
                var start = first; var end = last
                if start > end { start = last; end = first }
                let bytes = UTF8.bytes(text)
                return string(C.string(@bytes[offsets[start]:offsets[end]]))
            }
            if method == selector("accessibilityMinValue") {
                if let value = element.minimum { return number(value) }
                return 0 as uint
            }
            if method == selector("accessibilityMaxValue") {
                if let value = element.maximum { return number(value) }
                return 0 as uint
            }
            if method == selector("accessibilityTitleUIElement") {
                if let label = element.labelled_by { return self.peer(label) }
                return 0 as uint
            }
            if method == selector("accessibilityServesAsTitleForUIElements") {
                if let target = element.labels {
                    let handle = self.peer(target)
                    if handle != 0 as uint {
                        return send_object(system_class("NSArray"), selector("arrayWithObject:"), handle)
                    }
                }
                return object(system_class("NSArray"), "array")
            }
            if method == selector("accessibilityTabs") || method == selector("accessibilitySelectedChildren") {
                return self.choice_children(peer,method == selector("accessibilitySelectedChildren"))
            }
            if method == selector("accessibilityHorizontalScrollBar") { return self.scroll_bar(peer,true) }
            if method == selector("accessibilityVerticalScrollBar") { return self.scroll_bar(peer,false) }
            if method == selector("accessibilityHeader") {
                if let header = element.header { return self.peer(header) }
            }
            if method == selector("accessibilityDisclosedByRow") {
                if let parent = element.parent {
                    if let description = self.source.read(parent) {
                        if description.role == AX.Role.tree_item { return self.peer(parent) }
                    }
                }
                return 0 as uint
            }
            if method == selector("accessibilityDisclosedRows") && element.role == AX.Role.tree_item { return peer.rows }
            if method == selector("accessibilityColumns") && self.source.columns(peer.id) != null { return peer.columns }
            if method == selector("accessibilitySelectedRows") && self.row_view(peer) != null { return peer.selected_rows }
            if method == selector("accessibilityParent") {
                if let parent = element.parent { return self.peer(parent) }
                return self.view
            }
            if method == selector("accessibilityChildren") || method == selector("accessibilityChildrenInNavigationOrder") { return peer.children }
            if method == selector("accessibilityRows") && self.row_view(peer) != null { return peer.rows }
            if method == selector("accessibilityWindow") || method == selector("accessibilityTopLevelUIElement") { return self.window }
            if method == selector("accessibilityApplicationFocusedUIElement") || method == selector("accessibilityFocusedUIElement") {
                if let focused = self.source.focused() { return self.peer(focused) }
            }
        }
        return 0 as uint
    }

    module func state(peer:Peer, method:uint) uint8 {
        if self.active {
            if let element = self.source.read(peer.id) {
                if method == selector("isAccessibilityElement") { return 1 as uint8 }
                if method == selector("isAccessibilityModal") && element.role == AX.Role.dialog { return 1 as uint8 }
                if method == selector("isAccessibilityEnabled") && element.enabled { return 1 as uint8 }
                if method == selector("isAccessibilityFocused") && element.focused { return 1 as uint8 }
                if method == selector("isAccessibilitySelected") && element.selected == true { return 1 as uint8 }
                if (method == selector("isAccessibilityExpanded") || method == selector("isAccessibilityDisclosed")) && element.expanded == true { return 1 as uint8 }
            }
        }
        return 0 as uint8
    }

    module func orientation(peer:Peer) int64 {
        if self.active {
            if let element = self.source.read(peer.id) {
                if element.role == AX.Role.slider || element.role == AX.Role.radio_group || element.role == AX.Role.scrollbar || element.role == AX.Role.separator || element.role == AX.Role.progress {
                    if element.horizontal { return 2 as int64 }
                    return 1 as int64
                }
            }
        }
        return 0 as int64
    }

    module func text_length(peer:Peer) int64 {
        if self.active {
            if let element = self.source.read(peer.id) {
                if has_text_selection(element) {
                    let offsets = utf16_boundaries(element.value!)
                    return offsets[offsets.count() - 1] as int64
                }
            }
        }
        return 0 as int64
    }
    // Metadata is read only on a native query, never per frame or by scanning
    // children. Model row positions can differ from tree sibling indices.
    module func collection_number(peer:Peer, method:uint) int64 {
        if self.active {
            if let element = self.source.read(peer.id) {
                if let value = collection_number(element, method) { return value as int64 }
            }
        }
        return 9223372036854775807 as int64 // NSNotFound.
    }
    module func cell_span(peer:Peer, method:uint) uint[2] {
        if self.active {
            if let element = self.source.read(peer.id) {
                if let index = cell_index(element, method) { return [index as uint, 1] }
            }
        }
        return [9223372036854775807, 0]
    }
    module func text_span(peer:Peer) uint[2] {
        if self.active {
            if let element = self.source.read(peer.id) {
                if has_text_selection(element) { return selected_span(element, utf16_boundaries(element.value!)) }
            }
        }
        return [9223372036854775807, 0] // NSNotFound, zero length.
    }
    module func select_text(peer:Peer, span:uint[2]) {
        if !self.active { return }
        if let element = self.source.read(peer.id) {
            if !has_text_selection(element) || !supports(element, AX.Action.set_text_selection) { return }
            let offsets = utf16_boundaries(element.value!)
            let total = offsets[offsets.count() - 1]
            // Subtraction checks the length without overflowing NSUInteger.
            if span[0] > total || span[1] > total - span[0] { return }
            var anchor = 0
            while anchor + 1 < offsets.count() && offsets[anchor + 1] <= span[0] { anchor++ }
            var cursor = anchor
            if span[1] != 0 as uint {
                let end = span[0] + span[1]
                while cursor < offsets.count() - 1 && offsets[cursor] < end { cursor++ }
            }
            // NSRange has no direction: do not overwrite a reversed anchor
            // when the client merely repeats the application's current span.
            let previous = selected_span(element, offsets)
            if previous[0] == offsets[anchor] && previous[1] == offsets[cursor] - offsets[anchor] { return }
            let changed = self.perform(peer, AX.Request(AX.Action.set_text_selection, anchor:anchor, cursor:cursor))
        }
    }

    module func text_query(peer:Peer, operation:uint, invocation:uint) {
        if !self.active { return }
        if let element = self.source.read(peer.id) {
            if !has_text_selection(element) { return }
            let offsets = utf16_boundaries(element.value!)
            var geometry = self.source.text_geometry(peer.id)
            var selection:AX.TextRange? = null
            if operation == selector("accessibilityVisibleCharacterRange") {
                if var layout = geometry { selection = layout.visible_range() }
            } elif operation == selector("accessibilityRangeForLine:") {
                var line:int = 0
                set_argument(invocation, selector("getArgument:atIndex:"), C.address_bits(C.mutable_pointer(line)), 2)
                if var layout = geometry { selection = layout.range_for_line(line) }
            } elif operation == selector("accessibilityRangeForPosition:") {
                var point:float64[2] = [0.0,0.0]
                set_argument(invocation, selector("getArgument:atIndex:"), C.address_bits(C.mutable_pointer(point)), 2)
                let position = self.source_point(point)
                if var layout = geometry { selection = layout.range_at(position.x,position.y) }
            } elif operation == selector("accessibilityLineForIndex:") || operation == selector("accessibilityRangeForIndex:") {
                var index:int = 0
                set_argument(invocation, selector("getArgument:atIndex:"), C.address_bits(C.mutable_pointer(index)), 2)
                if index < 0 || index as uint > offsets[offsets.count()-1] { return }
                var cluster = 0
                while cluster+1 < offsets.count() && offsets[cluster+1] <= index as uint { cluster++ }
                if operation == selector("accessibilityLineForIndex:") {
                    if var layout = geometry { if let line = layout.line_for_index(cluster) {
                        var result:int = line
                        send_void_object(invocation, selector("setReturnValue:"), C.address_bits(C.mutable_pointer(result)))
                    } }
                    return
                }
                var length = 1; if cluster == offsets.count()-1 { length = 0 }
                selection = AX.TextRange(cluster,length)
            } else {
                var span:uint[2] = [0,0]
                set_argument(invocation, selector("getArgument:atIndex:"), C.address_bits(C.mutable_pointer(span)), 2)
                let total = offsets[offsets.count()-1]
                if span[0] > total || span[1] > total-span[0] { return }
                var start = 0
                while start+1 < offsets.count() && offsets[start+1] <= span[0] { start++ }
                var end = start
                if span[1] != 0 as uint { while end < offsets.count()-1 && offsets[end] < span[0]+span[1] { end++ } }
                selection = AX.TextRange(start,end-start)
                if operation == selector("accessibilityStringForRange:") {
                    // NSString owns the UTF-16 substring operation, including
                    // ranges which do not coincide with grapheme boundaries.
                    let text = string(element.value!)
                    let result = send_object(text, selector("methodSignatureForSelector:"), selector("substringWithRange:"))
                    let call = send_object(system_class("NSInvocation"), selector("invocationWithMethodSignature:"), result)
                    send_void_object(call, selector("setSelector:"), selector("substringWithRange:"))
                    send_void_object(call, selector("setTarget:"), text)
                    set_argument(call, selector("setArgument:atIndex:"), C.address_bits(C.mutable_pointer(span)), 2)
                    send_void(call, selector("invoke"))
                    var value:uint = 0
                    send_void_object(call, selector("getReturnValue:"), C.address_bits(C.mutable_pointer(value)))
                    send_void_object(invocation, selector("setReturnValue:"), C.address_bits(C.mutable_pointer(value)))
                    return
                }
                if operation == selector("accessibilityFrameForRange:") {
                    if var layout = geometry { if let bounds = layout.bounds(selection!) {
                        var frame = self.screen_rect(bounds)
                        send_void_object(invocation, selector("setReturnValue:"), C.address_bits(C.mutable_pointer(frame)))
                    } }
                    return
                }
            }
            if let resolved = selection {
                if resolved.start < 0 || resolved.length < 0 || resolved.start >= offsets.count() || resolved.length > offsets.count()-1-resolved.start { return }
                var span:uint[2] = [offsets[resolved.start],offsets[resolved.start+resolved.length]-offsets[resolved.start]]
                send_void_object(invocation, selector("setReturnValue:"), C.address_bits(C.mutable_pointer(span)))
            }
        }
    }
    private func screen_rect(bounds:AX.Bounds) float64[4] {
        var y = bounds.y+self.origin.y
        if !self.flipped { y = self.height-y-bounds.height }
        var rect:float64[4] = [(bounds.x+self.origin.x) as float64,y as float64,bounds.width as float64,bounds.height as float64]
        if self.view != 0 as uint { rect = convert_rect(self.view,"convertRect:toView:",rect,true) }
        if self.window != 0 as uint { rect = convert_rect(self.window,"convertRectToScreen:",rect,false) }
        return rect
    }
    private func source_point(point:float64[2]) Math.Vec2 {
        var position = point
        if self.window != 0 as uint { position = convert_point(self.window,"convertPointFromScreen:",position,false) }
        if self.view != 0 as uint { position = convert_point(self.view,"convertPoint:fromView:",position,true) }
        var y = position[1] as float
        if !self.flipped { y = self.height-y }
        return Math.Vec2(position[0] as float-self.origin.x,y-self.origin.y)
    }

    module func child_count(peer:Peer) uint {
        if self.active {
            if let element = self.source.read(peer.id) {
                if element.role == AX.Role.column {
                    if let parent = element.parent {
                        if var rows = self.source.rows(parent) { let count = rows.count(); if count > 0 { return count as uint } }
                    }
                    return 0 as uint
                }
                return element.child_count as uint
            }
        }
        return 0 as uint
    }
    module func child(peer:Peer, index:uint) uint {
        if index >= self.child_count(peer) { return 0 as uint }
        if let element = self.source.read(peer.id) {
            if element.role == AX.Role.column {
                if let parent = element.parent {
                    let handle = self.peer(parent)
                    if var owner = self.peers.find(parent) { return self.cell(owner, element.column_index ?? -1, index as int) }
                }
                return 0 as uint
            }
        }
        if let id = self.source.child(peer.id, index as int) { return self.peer(id) }
        return 0 as uint
    }

    // Row projection is a separate relationship, not a filter over children:
    // tables have header/scroll wrappers and outlines have nested descendants.
    private func row_view(peer:Peer) AX.Rows? {
        if !self.active { return null }
        if let element = self.source.read(peer.id) {
            if element.role == AX.Role.table || element.role == AX.Role.tree || element.role == AX.Role.list || element.role == AX.Role.tree_item {
                return self.source.rows(peer.id)
            }
        }
        return null
    }
    module func row_count(peer:Peer) uint {
        if var rows = self.row_view(peer) {
            let count = rows.count()
            if count > 0 { return count as uint }
        }
        return 0 as uint
    }
    module func row(peer:Peer, index:uint) uint {
        if var rows = self.row_view(peer) {
            let count = rows.count()
            if count <= 0 || index >= count as uint { return 0 as uint }
            if let id = rows.row(index as int) { return self.peer(id) }
        }
        return 0 as uint
    }
    module func cell(peer:Peer, column:int, row:int) uint {
        if !self.active || column < 0 || row < 0 { return 0 as uint }
        if let table = self.source.read(peer.id) {
            if table.role != AX.Role.table || column >= (table.column_count ?? 0) { return 0 as uint }
            if var rows = self.row_view(peer) {
                if row >= rows.count() { return 0 as uint }
                if let row_id = rows.row(row) {
                    if let id = self.source.child(row_id, column) {
                        if let cell = self.source.read(id) {
                            if cell.role == AX.Role.cell && cell.row_index == row && cell.column_index == column {
                                return self.peer(id)
                            }
                        }
                    }
                }
            }
        }
        return 0 as uint
    }

    module func column_count(peer:Peer) uint {
        if !self.active { return 0 as uint }
        if var columns = self.source.columns(peer.id) { let count = columns.count(); if count > 0 { return count as uint } }
        return 0 as uint
    }
    module func column(peer:Peer, index:uint) uint {
        if index >= self.column_count(peer) { return 0 as uint }
        if var columns = self.source.columns(peer.id) {
            if let id = columns.column(index as int) {
                if let element = self.source.read(id) {
                    if element.role == AX.Role.column && element.parent == peer.id && element.column_index == index as int { return self.peer(id) }
                }
            }
        }
        return 0 as uint
    }
    module func selected_rows(peer:Peer) str[] {
        if var rows = self.row_view(peer) { return rows.selected() }
        return []
    }
    private func scroll_bar(peer:Peer, horizontal:bool) uint {
        if let element = self.source.read(peer.id) {
            if element.role != AX.Role.scroll_view { return 0 as uint }
            var index = 0
            while index < element.child_count {
                if let id = self.source.child(peer.id,index) {
                    if let child = self.source.read(id) {
                        if child.role == AX.Role.scrollbar && child.horizontal == horizontal { return self.peer(id) }
                    }
                }
                index++
            }
        }
        return 0 as uint
    }
    private func choice_children(peer:Peer, selected:bool) uint {
        let result = object(system_class("NSMutableArray"),"array")
        if let element = self.source.read(peer.id) {
            if element.role != AX.Role.tab_group && element.role != AX.Role.radio_group { return result }
            var index = 0
            while index < element.child_count {
                if let id = self.source.child(peer.id,index) {
                    if let child = self.source.read(id) {
                        if child.role == AX.Role.tab || child.role == AX.Role.radio {
                            if !selected || child.selected == true || child.checked == true {
                                send_void_object(result,selector("addObject:"),self.peer(id))
                            }
                        } elif child.role == AX.Role.radio_group {
                            let handle = self.peer(id)
                            if var nested = self.peers.find(id) {
                                send_void_object(result,selector("addObjectsFromArray:"),self.choice_children(nested,selected))
                            }
                        }
                    }
                }
                index++
            }
        }
        return result
    }
    module func press(peer:Peer, method:uint) bool {
        if !self.active { return false }
        if let element = self.source.read(peer.id) {
