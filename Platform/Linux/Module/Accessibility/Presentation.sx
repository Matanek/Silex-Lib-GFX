use GFX.Accessibility

// The Linux bridge is tracked separately; retaining no native state here does
// not claim AT-SPI support.
package nocopy class Host {
    init(source:Accessibility.Source, view:uint, window:uint, height:float, flipped:bool) {}
    func synchronize(height:float) bool { return false }
    func remove() {}
    func root_handle() uint { return 0 as uint }
    func peer_count() int { return 0 }
}
func view(window:uint) uint { return 0 as uint }
func flipped(view:uint) bool { return false }
