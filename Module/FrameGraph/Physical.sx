use GFX.GPU

internal struct AliasGroup {
    internal let format:GPU.TextureFormat
    internal let usage:GPU.TextureUsage
    internal let usage_flags:uint32
    internal var last_pass:int

    internal init(format:GPU.TextureFormat, usage:GPU.TextureUsage, usage_flags:uint32, last_pass:int) {
        self.format = format
        self.usage = usage
        self.usage_flags = usage_flags
        self.last_pass = last_pass
    }
}
