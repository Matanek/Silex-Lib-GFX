use GFX.Assets.Image as Image
use GFX.Assets.ImageHandle as ImageHandle

class Entry {
    var image:Image
    var generation:int
    var revision:int
    var active:bool

    init(image:Image) {
        self.image = image
        self.generation = 1
        self.revision = 1
        self.active = true
    }
}

public class Images {
    private var entries:Entry[]

    init() { self.entries = [] }

    func add(image:Image) ImageHandle {
        self.entries.append(Entry(image))
        return ImageHandle(self.entries.count() - 1, 1)
    }

    func contains(handle:ImageHandle) bool {
        if !handle.is_valid() || handle.asset_index >= self.entries.count() { return false }
        var entry = self.entries[handle.asset_index]
        return entry.active && entry.generation == handle.asset_generation
    }

    func get(handle:ImageHandle) @Image {
        self.require(handle)
        return self.entries[handle.asset_index].image
    }

    func snapshot(handle:ImageHandle) Image {
        self.require(handle)
        return self.entries[handle.asset_index].image
    }

    func replace(handle:ImageHandle, image:Image) {
        var entry = self.require(handle)
        entry.image = image
        entry.revision++
    }

    func remove(handle:ImageHandle) bool {
        if !self.contains(handle) { return false }
        var entry = self.entries[handle.asset_index]
        entry.active = false
        entry.generation++
        entry.revision++
        return true
    }

    func revision(handle:ImageHandle) int {
        if !self.contains(handle) { return 0 }
        return self.entries[handle.asset_index].revision
    }

    private func require(handle:ImageHandle) Entry {
        if !self.contains(handle) { panic("GFX.Assets image handle is stale or invalid") }
        return self.entries[handle.asset_index]
    }
}
