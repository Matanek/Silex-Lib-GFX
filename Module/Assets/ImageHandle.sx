public struct ImageHandle {
    internal let asset_index:int
    internal let asset_generation:int

    public init() {
        self.asset_index = -1
        self.asset_generation = 0
    }

    internal init(index:int, generation:int) {
        self.asset_index = index
        self.asset_generation = generation
    }

    public func is_valid() bool {
        return self.asset_index >= 0 && self.asset_generation > 0
    }

    public func index() int { return self.asset_index }
    public func generation() int { return self.asset_generation }
}
