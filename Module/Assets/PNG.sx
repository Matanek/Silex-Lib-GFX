use GFX.Assets.Image
use Interop.Boundary
use Interop.C

public func try_load(path:str) Result<Image, str> {
    if path == "" { return Result<Image, str>.failure("PNG path cannot be empty") }
    let stream = C.address_bits(sdl_io_from_file(
        C.terminated_pointer(path),
        C.terminated_pointer("rb")
    ))
    if stream == 0 as uint {
        return Result<Image, str>.failure("could not open PNG image: " + path)
    }
    let decoded = C.address_bits(sdl_load_png_io(C.pointer_bits(stream), 1))
    if decoded == 0 as uint {
        return Result<Image, str>.failure("could not decode PNG image: " + path)
    }
    let converted = C.address_bits(sdl_convert_surface(
        C.pointer_bits(decoded),
        0x1676_2004 as uint32
    ))
    sdl_destroy_surface(C.pointer_bits(decoded))
    if converted == 0 as uint {
        return Result<Image, str>.failure("could not convert PNG image to RGBA8: " + path)
    }
    if sdl_lock_surface(C.pointer_bits(converted)) == 0 {
        sdl_destroy_surface(C.pointer_bits(converted))
        return Result<Image, str>.failure("could not access decoded PNG pixels: " + path)
    }
    let width = C.load<int32>(converted, 8 as uint) as int
    let height = C.load<int32>(converted, 12 as uint) as int
    let pitch = C.load<int32>(converted, 16 as uint) as int
    let source = C.load<uint>(converted, 24 as uint)
    var pixels:uint8[] = []
    var y = 0
    while y < height {
        var x = 0
        while x < width * 4 {
            pixels.append(C.load<uint8>(source, (y * pitch + x) as uint))
            x++
        }
        y++
    }
    sdl_unlock_surface(C.pointer_bits(converted))
    sdl_destroy_surface(C.pointer_bits(converted))
    return Result<Image, str>.success(Image.rgba8(width, height, pixels))
}

public func load(path:str) Image {
    match try_load(path) {
        failure(error) => { panic(error) }
        success(image) => { return image }
    }
}

let sdl_io_from_file = C.function<
    func(C.Pointer<uint8>, C.Pointer<uint8>) C.Pointer<uint8>
>(library:Boundary.SDL3, name:"SDL_IOFromFile")
let sdl_load_png_io = C.function<
    func(C.Pointer<uint8>, int32) C.Pointer<uint8>
>(library:Boundary.SDL3, name:"SDL_LoadPNG_IO")
let sdl_convert_surface = C.function<
    func(C.Pointer<uint8>, uint32) C.Pointer<uint8>
>(library:Boundary.SDL3, name:"SDL_ConvertSurface")
let sdl_lock_surface = C.function<func(C.Pointer<uint8>) int32>(
    library:Boundary.SDL3,
    name:"SDL_LockSurface"
)
let sdl_unlock_surface = C.function<func(C.Pointer<uint8>) void>(
    library:Boundary.SDL3,
    name:"SDL_UnlockSurface"
)
let sdl_destroy_surface = C.function<func(C.Pointer<uint8>) void>(
    library:Boundary.SDL3,
    name:"SDL_DestroySurface"
)
