use GFX.Assets.GLTF.Types.Error
use GFX.Assets.GLTF.Types.ErrorKind
use GFX.Assets.GLTF.Types.Format
use GFX.Assets.Model
use GFX.Color
use GFX.Scene3D
use Interop.C
use JSON
use STD.Math
use STD.Text.UTF8

struct ViewRecord {
    let offset:int
    let length:int
    let target:int
}

struct AccessorRecord {
    let view:int
    let count:int
    let components:int
    let bounded:bool
    let minimum:Math.Vec3
    let maximum:Math.Vec3
}

struct GeometryRecord {
    let position:int
    let normal:int
    let uv:int
    let color:int
    let indices:int
}

struct ExportData {
    var binary:uint8[]
    var views:ViewRecord[]
    var accessors:AccessorRecord[]
    var geometries:GeometryRecord[]
    var image_views:int[]
}

func encode(model:Model.Model, format:Format) Result<uint8[], Error> {
    var data = ExportData(binary:[], views:[], accessors:[], geometries:[], image_views:[])
    try pack_model(model, data)
    let embedded = match format { gltf => true; glb => false }
    let json = build_json(model, data, embedded)
    if embedded { return Result<uint8[], Error>.success(UTF8.bytes(json)) }
    return Result<uint8[], Error>.success(glb(json, data.binary))
}

func pack_model(model:Model.Model, data:&ExportData) Result<void, Error> {
    var index = 0
    while index < model.mesh_count() {
        pack_geometry(model.mesh(index), data)
        index++
    }
    index = 0
    while index < model.image_count() {
        align(data.binary)
        let offset = data.binary.count()
        match GFX.Assets.GLTF.ImageCodec.encode_png(model.image(index)) {
            failure(detail) => {
                return Result<void, Error>.failure(Error(
                    kind:ErrorKind.image,
                    subject:null,
                    detail:detail
                ))
            }
            success(bytes) => { append_bytes(data.binary, bytes) }
        }
        data.image_views.append(add_view(data, offset, data.binary.count() - offset, 0))
        index++
    }
    return Result<void, Error>.success()
}

func pack_geometry(mesh:Scene3D.Geometry.Mesh, data:&ExportData) {
    let vertices = mesh.vertices()
    let indices = mesh.indices()
    var minimum = Math.Vec3()
    var maximum = Math.Vec3()
    if vertices.count() > 0 {
        minimum = vertices[0].position
        maximum = vertices[0].position
    }

    align(data.binary)
    var offset = data.binary.count()
    for vertex in vertices {
        append_vec3(data.binary, vertex.position)
        minimum = minimum.minimum(vertex.position)
        maximum = maximum.maximum(vertex.position)
    }
    let position_view = add_view(data, offset, data.binary.count() - offset, 34962)
    let position = add_accessor(data, position_view, vertices.count(), 3, true, minimum, maximum)

    align(data.binary)
    offset = data.binary.count()
    for vertex in vertices { append_vec3(data.binary, vertex.normal) }
    let normal_view = add_view(data, offset, data.binary.count() - offset, 34962)
    let normal = add_accessor(data, normal_view, vertices.count(), 3, false, Math.Vec3(), Math.Vec3())

    align(data.binary)
    offset = data.binary.count()
    for vertex in vertices { append_float(data.binary, vertex.uv.x); append_float(data.binary, vertex.uv.y) }
    let uv_view = add_view(data, offset, data.binary.count() - offset, 34962)
    let uv = add_accessor(data, uv_view, vertices.count(), 2, false, Math.Vec3(), Math.Vec3())

    align(data.binary)
    offset = data.binary.count()
    for vertex in vertices { append_color(data.binary, vertex.color) }
    let color_view = add_view(data, offset, data.binary.count() - offset, 34962)
    let color = add_accessor(data, color_view, vertices.count(), 4, false, Math.Vec3(), Math.Vec3())

    align(data.binary)
    offset = data.binary.count()
    for value in indices { append_u32(data.binary, value) }
    let index_view = add_view(data, offset, data.binary.count() - offset, 34963)
    let index_accessor = add_accessor(data, index_view, indices.count(), 1, false, Math.Vec3(), Math.Vec3())
    data.geometries.append(GeometryRecord(
        position:position,
        normal:normal,
        uv:uv,
        color:color,
        indices:index_accessor
    ))
}

func add_view(data:&ExportData, offset:int, length:int, target:int) int {
    let index = data.views.count()
    data.views.append(ViewRecord(offset:offset, length:length, target:target))
    return index
}

func add_accessor(
    data:&ExportData,
    view:int,
    count:int,
    components:int,
    bounded:bool,
    minimum:Math.Vec3,
    maximum:Math.Vec3
) int {
    let index = data.accessors.count()
    data.accessors.append(AccessorRecord(
        view:view,
        count:count,
        components:components,
        bounded:bounded,
        minimum:minimum,
        maximum:maximum
    ))
    return index
}

func build_json(model:Model.Model, data:ExportData, embedded:bool) str {
    var result = "{\"asset\":{\"version\":\"2.0\",\"generator\":\"GFX.Assets.GLTF\"}"
    result += ",\"extensionsUsed\":[\"KHR_texture_transform\",\"KHR_materials_emissive_strength\",\"KHR_materials_unlit\"]"
    result += ",\"buffers\":[{\"byteLength\":$(data.binary.count())"
    if embedded {
        result += ",\"uri\":\"data:application/octet-stream;base64," +
            GFX.Assets.GLTF.Base64.encode(data.binary) + "\""
    }
    result += "}]"
    result += buffer_views_json(data.views)
    result += accessors_json(data.accessors)
    result += images_json(data.image_views)
    result += textures_json(model.image_count())
    result += materials_json(model)
    result += meshes_json(model, data.geometries)
    result += nodes_json(model)
    result += scene_json(model)
    return result + "}"
}

func buffer_views_json(views:ViewRecord[]) str {
    var result = ",\"bufferViews\":["
    var index = 0
    while index < views.count() {
        if index > 0 { result += "," }
        let view = views[index]
        result += "{\"buffer\":0,\"byteOffset\":$(view.offset),\"byteLength\":$(view.length)"
        if view.target != 0 { result += ",\"target\":$(view.target)" }
        result += "}"
        index++
    }
    return result + "]"
}

func accessors_json(accessors:AccessorRecord[]) str {
    var result = ",\"accessors\":["
    var index = 0
    while index < accessors.count() {
        if index > 0 { result += "," }
        let value = accessors[index]
        result += "{\"bufferView\":$(value.view),\"componentType\":"
        if value.components == 1 { result += "5125" } else { result += "5126" }
        result += ",\"count\":$(value.count),\"type\":\"" + component_name(value.components) + "\""
        if value.bounded {
            result += ",\"min\":" + vec3_json(value.minimum) + ",\"max\":" + vec3_json(value.maximum)
        }
        result += "}"
        index++
    }
    return result + "]"
}

func images_json(views:int[]) str {
    if views.count() == 0 { return "" }
    var result = ",\"images\":["
    var index = 0
    while index < views.count() {
        if index > 0 { result += "," }
        result += "{\"bufferView\":$(views[index]),\"mimeType\":\"image/png\"}"
        index++
    }
    return result + "]"
}

func textures_json(count:int) str {
    if count == 0 { return "" }
    var result = ",\"textures\":["
    var index = 0
    while index < count {
        if index > 0 { result += "," }
        result += "{\"source\":$(index)}"
        index++
    }
    return result + "]"
}

func materials_json(model:Model.Model) str {
    if model.material_count() == 0 { return "" }
    var result = ",\"materials\":["
    var index = 0
    while index < model.material_count() {
        if index > 0 { result += "," }
        result += material_json(model.material(index))
        index++
    }
    return result + "]"
}

func material_json(material:Model.ModelMaterial) str {
    let value = material.value
    var result = "{\"name\":" + quoted(material.name) + ",\"pbrMetallicRoughness\":{"
    result += "\"baseColorFactor\":" + color_json(value.albedo)
    result += ",\"metallicFactor\":$(value.metallic),\"roughnessFactor\":$(value.roughness)"
    if let texture = material.textures.albedo {
        result += ",\"baseColorTexture\":" + texture_json(texture)
    }
    if let texture = material.textures.metallic_roughness {
        result += ",\"metallicRoughnessTexture\":" + texture_json(texture)
    }
    result += "}"
    if value.emission_intensity > 0.0 {
        result += ",\"emissiveFactor\":[$(value.emission.r),$(value.emission.g),$(value.emission.b)]"
    }
    if let texture = material.textures.normal {
        result += ",\"normalTexture\":" + scaled_texture_json(texture, "scale", material.textures.normal_scale)
    }
    if let texture = material.textures.occlusion {
        result += ",\"occlusionTexture\":" + scaled_texture_json(texture, "strength", material.textures.occlusion_strength)
    }
    if let texture = material.textures.emission {
        result += ",\"emissiveTexture\":" + texture_json(texture)
    }
    result += ",\"alphaMode\":\"" + alpha_name(material.alpha_mode) + "\""
    if material.alpha_mode == Model.AlphaMode.mask { result += ",\"alphaCutoff\":$(material.alpha_cutoff)" }
    if material.double_sided { result += ",\"doubleSided\":true" }
    result += material_extensions(material)
    return result + "}"
}

func material_extensions(material:Model.ModelMaterial) str {
    let strength = material.value.emission_intensity > 0.0
    if !strength && !material.unlit { return "" }
    var result = ",\"extensions\":{"
    var separator = false
    if strength {
        result += "\"KHR_materials_emissive_strength\":{\"emissiveStrength\":$(material.value.emission_intensity)}"
        separator = true
    }
    if material.unlit {
        if separator { result += "," }
        result += "\"KHR_materials_unlit\":{}"
    }
    return result + "}"
}

func texture_json(texture:Model.TextureReference) str {
    var result = "{\"index\":$(texture.image)"
    if texture.transform.coordinates != 0 { result += ",\"texCoord\":$(texture.transform.coordinates)" }
    if has_transform(texture.transform) {
        result += ",\"extensions\":{\"KHR_texture_transform\":{"
        result += "\"offset\":[$(texture.transform.offset.x),$(texture.transform.offset.y)]"
        result += ",\"scale\":[$(texture.transform.scale.x),$(texture.transform.scale.y)]"
        result += ",\"rotation\":$(texture.transform.rotation)"
        if texture.transform.coordinates != 0 { result += ",\"texCoord\":$(texture.transform.coordinates)" }
        result += "}}"
    }
    return result + "}"
}

func scaled_texture_json(texture:Model.TextureReference, name:str, value:float) str {
    let base = texture_json(texture)
    let bytes = UTF8.bytes(base)
    var result = ""
    var index = 0
    while index + 1 < bytes.count() { result += C.string(@bytes[index:index + 1]); index++ }
    return result + ",\"$(name)\":$(value)}"
}

func has_transform(value:Model.TextureTransform) bool {
    return value.offset.x != 0.0 || value.offset.y != 0.0 ||
        value.scale.x != 1.0 || value.scale.y != 1.0 || value.rotation != 0.0
}

func meshes_json(model:Model.Model, geometries:GeometryRecord[]) str {
    var result = ",\"meshes\":["
    var mesh_index = 0
    while mesh_index < model.model_mesh_count() {
        if mesh_index > 0 { result += "," }
        let mesh = model.model_mesh(mesh_index)
        result += "{\"name\":" + quoted(mesh.name) + ",\"primitives\":["
        var primitive_index = 0
        while primitive_index < mesh.primitives.count() {
            if primitive_index > 0 { result += "," }
            let primitive = mesh.primitives[primitive_index]
            let geometry = geometries[primitive.mesh]
            result += "{\"attributes\":{\"POSITION\":$(geometry.position),\"NORMAL\":$(geometry.normal),"
            result += "\"TEXCOORD_0\":$(geometry.uv),\"COLOR_0\":$(geometry.color)},\"indices\":$(geometry.indices)"
            if primitive.material >= 0 { result += ",\"material\":$(primitive.material)" }
            result += "}"
            primitive_index++
        }
        result += "]}"
        mesh_index++
    }
    return result + "]"
}

func nodes_json(model:Model.Model) str {
    var result = ",\"nodes\":["
    var index = 0
    while index < model.node_count() {
        if index > 0 { result += "," }
        let node = model.node(index)
        result += "{\"name\":" + quoted(node.name)
        if node.mesh >= 0 { result += ",\"mesh\":$(node.mesh)" }
        if node.children.count() > 0 { result += ",\"children\":" + integers_json(node.children) }
        result += ",\"translation\":" + vec3_json(node.transform.position)
        result += ",\"rotation\":[$(node.transform.rotation.x),$(node.transform.rotation.y),$(node.transform.rotation.z),$(node.transform.rotation.w)]"
        result += ",\"scale\":" + vec3_json(node.transform.scale) + "}"
        index++
    }
    return result + "]"
}

func scene_json(model:Model.Model) str {
    var roots:int[] = []
    var index = 0
    while index < model.root_count() { roots.append(model.root(index)); index++ }
    return ",\"scenes\":[{\"nodes\":" + integers_json(roots) + "}],\"scene\":0"
}

func integers_json(values:int[]) str {
    var result = "["
    var index = 0
    while index < values.count() {
        if index > 0 { result += "," }
        result += "$(values[index])"
        index++
    }
    return result + "]"
}

func component_name(components:int) str {
    if components == 1 { return "SCALAR" }
    if components == 2 { return "VEC2" }
    if components == 3 { return "VEC3" }
    return "VEC4"
}

func alpha_name(value:Model.AlphaMode) str {
    return match value { opaque => "OPAQUE"; mask => "MASK"; blend => "BLEND" }
}

func quoted(value:str) str {
    var json = JSON.Value.string(value)
    return JSON.stringify(json)
}

func vec3_json(value:Math.Vec3) str { return "[$(value.x),$(value.y),$(value.z)]" }
func color_json(value:Color) str { return "[$(value.r),$(value.g),$(value.b),$(value.a)]" }

func glb(json:str, binary:uint8[]) uint8[] {
    var json_bytes = UTF8.bytes(json)
    while json_bytes.count() % 4 != 0 { json_bytes.append(32 as uint8) }
    var data = binary
    while data.count() % 4 != 0 { data.append(0 as uint8) }
    let total = 12 + 8 + json_bytes.count() + 8 + data.count()
    var result:uint8[] = []
    append_u32(result, 0x4654_6C67 as uint32)
    append_u32(result, 2 as uint32)
    append_u32(result, total as uint32)
    append_u32(result, json_bytes.count() as uint32)
    append_u32(result, 0x4E4F_534A as uint32)
    append_bytes(result, json_bytes)
    append_u32(result, data.count() as uint32)
    append_u32(result, 0x004E_4942 as uint32)
    append_bytes(result, data)
    return result
}

func align(bytes:&uint8[]) { while bytes.count() % 4 != 0 { bytes.append(0 as uint8) } }

func append_bytes(destination:&uint8[], source:uint8[]) {
    for byte in source { destination.append(byte) }
}

func append_vec3(bytes:&uint8[], value:Math.Vec3) {
    append_float(bytes, value.x)
    append_float(bytes, value.y)
    append_float(bytes, value.z)
}

func append_color(bytes:&uint8[], value:Color) {
    append_float(bytes, value.r)
    append_float(bytes, value.g)
    append_float(bytes, value.b)
    append_float(bytes, value.a)
}

func append_float(bytes:&uint8[], value:float) {
    var storage = "\0"
    while C.byte_count(storage) < 4 as uint { storage = storage + storage }
    let stored = C.store<float32>(C.address_bits(C.mutable_string_pointer(storage)), 0 as uint, value)
    var index = 0
    while index < 4 { bytes.append(C.byte_at(storage, index as uint)); index++ }
}

func append_u32(bytes:&uint8[], value:uint32) {
    bytes.append((value & 255) as uint8)
    bytes.append(((value >> 8) & 255) as uint8)
    bytes.append(((value >> 16) & 255) as uint8)
    bytes.append(((value >> 24) & 255) as uint8)
}
