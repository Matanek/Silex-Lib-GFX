use GFX.Assets
use GFX.Bootstrap.Application
use GFX.Bootstrap.Plugin as PluginProtocol
use GFX.Bootstrap.Schedule

public struct Plugin:PluginProtocol {
    func id() str { return "GFX.Plugins.Assets" }

    func build(application:Application) {
        application.resources().insert(Assets.Meshes())
        application.resources().insert(Assets.Images())
        application.add_system(Schedule.shutdown, stop_assets)
    }
}

func stop_assets(application:Application) {
    var resources = application.resources()
    var images = resources.remove<Assets.Images>()
    var meshes = resources.remove<Assets.Meshes>()
    assert(images != null)
    assert(meshes != null)
}
