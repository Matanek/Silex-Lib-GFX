use GFX.Assets.SpriteSheet as SpriteSheet
use GFX.Assets.SpriteSheetHandle as SpriteSheetHandle

class SpriteSheetEntry {
    let sheet:SpriteSheet
    var generation:int
    var active:bool

    init(sheet:SpriteSheet) {
        self.sheet = sheet
        self.generation = 1
        self.active = true
    }
}

public class SpriteSheets {
    private var entries:SpriteSheetEntry[]

    init() { self.entries = [] }

    func add(sheet:SpriteSheet) SpriteSheetHandle {
        if sheet.is_empty() { panic("GFX cannot add a sprite sheet without animations") }
        var entries = self.entries
        entries.append(SpriteSheetEntry(sheet))
        self.entries = entries
        return SpriteSheetHandle(entries.count() - 1, 1)
    }

    func contains(handle:SpriteSheetHandle) bool {
        if !handle.is_valid() || handle.asset_index >= self.entries.count() { return false }
        var entry = self.entries[handle.asset_index]
        return entry.active && entry.generation == handle.asset_generation
    }

    func get(handle:SpriteSheetHandle) @SpriteSheet {
        self.require(handle)
        return self.entries[handle.asset_index].sheet
    }

    func remove(handle:SpriteSheetHandle) bool {
        if !self.contains(handle) { return false }
        var entry = self.entries[handle.asset_index]
        entry.active = false
        entry.generation++
        return true
    }

    private func require(handle:SpriteSheetHandle) SpriteSheetEntry {
        if !self.contains(handle) { panic("GFX sprite sheet handle is stale or invalid") }
        return self.entries[handle.asset_index]
    }
}
