use STD.Math
use STD.Time.Clock

public struct FrameTime {
    var delta:float
    private var clock:Clock

    module init() {
        self.delta = 0.0
        self.clock = Clock()
    }

    module func advance() {
        var clock = self.clock
        self.delta = Math.clamp(clock.tick(), 0.0, 0.1)
        self.clock = clock
    }
}
