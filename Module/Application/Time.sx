use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.Application.FrameTime
use GFX.Application.ClockControl.ClockControl

public struct Time:PluginProtocol {
    func id() str { return "GFX.Application.Time" }

    func build(application:&Application) {
        application.add_resource(FrameTime())
        application.add_system(Schedule.pre_update, advance_time, process_mode:Application.ProcessMode.always)
        application.add_system(Schedule.pre_update, advance_simulation, process_mode:Application.ProcessMode.always)
        application.add_system(Schedule.shutdown, stop_time)
    }
}

func advance_time(application:Application) {
    var resources = application.resources()
    var delta:float? = null
    {
        if let control = resources.try_get<ClockControl>() { delta = control.delta }
    }
    var time = resources.get_mut<FrameTime>()
    time.advance(delta)
}

func stop_time(application:Application) {
    var resources = application.resources()
    var removed = resources.remove<FrameTime>()
    assert(removed != null)
}

func advance_simulation(time:@FrameTime, simulation:&Application.Simulation) {
    simulation.advance(time.delta)
}
