use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Scene2D
use GFX.Rendering
use STD.Math
use STD.Time.Clock

public enum Anchor {
    top_left
    top_center
    top_right
    center_left
    center
    center_right
    bottom_left
    bottom_center
    bottom_right
}

public struct Settings {
    var anchor:Anchor
    var margin:Math.Vec2
    var refresh_interval:float
    module var detailed:bool

    init() {
        self.anchor = Anchor.bottom_right
        self.margin = Math.Vec2(16.0)
        self.refresh_interval = 0.25
        self.detailed = false
    }
}

public struct PerformanceSettings {
    var anchor:Anchor
    var margin:Math.Vec2
    var refresh_interval:float

    init() {
        self.anchor = Anchor.top_left
        self.margin = Math.Vec2(16.0)
        self.refresh_interval = 0.25
    }
}

class State {
    let settings:Settings
    var elapsed:float
    var frames:int
    var display:ECS.Entity
    var clock:Clock

    init(settings:Settings) {
        self.settings = settings
        self.elapsed = 0.0
        self.frames = 0
        self.display = ECS.Entity()
        self.clock = Clock()
    }
}

public struct Plugin:PluginProtocol {
    private let settings:Settings

    init(settings:Settings = Settings()) {
        if settings.margin.x < 0.0 || settings.margin.y < 0.0 {
            panic("GFX.FPSCounter margins must not be negative")
        }
        if settings.refresh_interval <= 0.0 {
            panic("GFX.FPSCounter refresh interval must be positive")
        }
        self.settings = settings
    }

    package init(settings:PerformanceSettings) {
        var configured = Settings()
        configured.anchor = settings.anchor
        configured.margin = settings.margin
        configured.refresh_interval = settings.refresh_interval
        configured.detailed = true
        if configured.margin.x < 0.0 || configured.margin.y < 0.0 {
            panic("GFX performance panel margins must not be negative")
        }
        if configured.refresh_interval <= 0.0 {
            panic("GFX performance panel refresh interval must be positive")
        }
        self.settings = configured
    }

    func id() str { return "GFX.FPSCounter.Plugin" }

    func build(application:&Application) {
        application.add_plugin(Scene2D.Plugin())
        application.add_resource(State(self.settings))
        application.add_system(Schedule.startup, create_counter)
        application.add_system(Schedule.update, update_counter)
        application.add_system(Schedule.shutdown, stop_counter)
    }
}

func anchor_point(anchor:Anchor) Math.Vec2 {
    if anchor == Anchor.top_left { return Math.Vec2() }
    if anchor == Anchor.top_center { return Math.Vec2(0.5, 0.0) }
    if anchor == Anchor.top_right { return Math.Vec2(1.0, 0.0) }
    if anchor == Anchor.center_left { return Math.Vec2(0.0, 0.5) }
    if anchor == Anchor.center { return Math.Vec2(0.5) }
    if anchor == Anchor.center_right { return Math.Vec2(1.0, 0.5) }
    if anchor == Anchor.bottom_left { return Math.Vec2(0.0, 1.0) }
    if anchor == Anchor.bottom_center { return Math.Vec2(0.5, 1.0) }
    return Math.Vec2(1.0)
}

func anchor_offset(anchor:Anchor, margin:Math.Vec2) Math.Vec2 {
    let point = anchor_point(anchor)
    var x = 0.0
    var y = 0.0
    if point.x == 0.0 { x = margin.x }
    else if point.x == 1.0 { x = -margin.x }
    if point.y == 0.0 { y = margin.y }
    else if point.y == 1.0 { y = -margin.y }
    return Math.Vec2(x, y)
}

func counter_canvas(fps:int) Canvas {
    var canvas = Canvas()
    let label = "$(fps) FPS"
    var style = Canvas.TextStyle(
        size:18.0,
        color:Color.white(),
        alignment:Canvas.TextAlignment.center
    )
    let metrics = canvas.measure_text(label, style)
    let text_position = Math.Vec2(58.0, (34.0 - metrics.height) * 0.5)
    canvas.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(116.0, 34.0), 8.0),
            Canvas.Fill.solid(Color.black().with_alpha(0.72))
        )
        painter.text(label, text_position, style)
    })
    return canvas
}

func decimal_tenths(value:int) str {
    return "$(value / 10).$(value % 10)"
}

func performance_canvas(fps:int, frame_tenths:int, stats:Rendering.Stats) Canvas {
    var labels:str[] = []
    labels.append("FPS")
    labels.append("FRAME")
    labels.append("DRAW CALLS")
    labels.append("TRIANGLES")
    labels.append("PIPELINE BINDS")
    labels.append("GPU PASSES")
    labels.append("UNIFORMS")
    labels.append("TEXTURES")

    var values:str[] = []
    values.append("$(fps)")
    values.append(decimal_tenths(frame_tenths) + " ms")
    values.append("$(stats.draw_calls())")
    values.append("$(stats.triangles())")
    values.append("$(stats.pipeline_bindings())")
    values.append("$(stats.render_passes())")
    values.append("$((stats.uniform_bytes() + 1023) / 1024) KiB")
    values.append("$(stats.texture_bindings())")

    var canvas = Canvas()
    canvas.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(252.0, 214.0), 9.0),
            Canvas.Fill.solid(Color.black().with_alpha(0.82))
        )
        painter.stroke(
            Canvas.Rect(Math.Vec2(0.5), Math.Vec2(251.0, 213.0), 9.0),
            Canvas.Stroke(Color.cyan_400().with_alpha(0.48), 1.0)
        )
        painter.text(
            "GFX PERFORMANCE",
            Math.Vec2(16.0, 11.0),
            Canvas.TextStyle(size:14.0, color:Color.cyan_300(), weight:Canvas.TextWeight.bold)
        )
        painter.stroke(
            Canvas.Line(Math.Vec2(16.0, 38.0), Math.Vec2(236.0, 38.0)),
            Canvas.Stroke(Color.slate_500().with_alpha(0.5), 1.0)
        )
        var index = 0
        while index < labels.count() {
            let y = 48.0 + index as float * 19.0
            painter.text(
                labels[index],
                Math.Vec2(16.0, y),
                Canvas.TextStyle(size:13.0, color:Color.slate_300())
            )
            painter.text(
                values[index],
                Math.Vec2(236.0, y),
                Canvas.TextStyle(size:13.0, color:Color.white(), alignment:Canvas.TextAlignment.end)
            )
            index++
        }
    })
    return canvas
}

func display_width(settings:Settings) int {
    if settings.detailed { return 252 }
    return 116
}

func display_height(settings:Settings) int {
    if settings.detailed { return 214 }
    return 34
}
func display_canvas(settings:Settings, fps:int, frame_tenths:int, stats:Rendering.Stats) Canvas {
    if settings.detailed { return performance_canvas(fps, frame_tenths, stats) }
    return counter_canvas(fps)
}

func create_counter(state:&State, world:&ECS.World, renderer:@Rendering.Renderer) {
    state.display = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Overlay(
            display_canvas(state.settings, 0, 0, renderer.stats()),
            display_width(state.settings),
            display_height(state.settings)
        )
            ..anchor = anchor_point(state.settings.anchor)
            ..position = anchor_offset(state.settings.anchor, state.settings.margin)
            ..pivot = anchor_point(state.settings.anchor)
            ..layer = 100
        )
    )
    state.clock.tick()
}

func update_counter(state:&State, world:&ECS.World, renderer:@Rendering.Renderer) {
    state.elapsed += state.clock.tick()
    state.frames++
    if state.elapsed < state.settings.refresh_interval { return }

    let fps = Math.round(state.frames as float / state.elapsed) as int
    let frame_tenths = Math.round(state.elapsed * 10000.0 / state.frames as float) as int
    world.update<Scene2D.Overlay>(state.display, func(display:&Scene2D.Overlay) {
        var canvas = display_canvas(state.settings, fps, frame_tenths, renderer.stats())
        display.replace(canvas)
    })
    state.elapsed = 0.0
    state.frames = 0
}

func stop_counter(application:Application) {
    var resources = application.resources()
    var removed = resources.remove<State>()
    assert(removed != null)
}
