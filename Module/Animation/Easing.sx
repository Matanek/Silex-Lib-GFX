use STD.Math

// `constant` holds the source value until the target key boundary, making it
// suitable for blocking poses before refining an animation.
public enum Easing {
    constant
    linear
    in
    out
    in_out
    quadratic_in
    quadratic_out
    quadratic_in_out
    cubic_in
    cubic_out
    cubic_in_out
    sine_in
    sine_out
    sine_in_out
    back_in
    back_out
    back_in_out
    bounce_in
    bounce_out
    bounce_in_out
}

func sample(easing:Easing, amount:float, reversing:bool = false) float {
    if easing == Easing.constant {
        if reversing {
            if amount > 0.0 { return 1.0 }
            return 0.0
        }
        if amount < 1.0 { return 0.0 }
        return 1.0
    }
    if easing == Easing.linear { return amount }
    if easing == Easing.in { return quadratic_in(amount) }
    if easing == Easing.out {
        let inverse = 1.0 - amount
        return 1.0 - inverse * inverse
    }
    if easing == Easing.in_out {
        return amount * amount * (3.0 - 2.0 * amount)
    }
    if easing == Easing.quadratic_in { return quadratic_in(amount) }
    if easing == Easing.quadratic_out { return quadratic_out(amount) }
    if easing == Easing.quadratic_in_out { return quadratic_in_out(amount) }
    if easing == Easing.cubic_in { return amount * amount * amount }
    if easing == Easing.cubic_out {
        let inverse = 1.0 - amount
        return 1.0 - inverse * inverse * inverse
    }
    if easing == Easing.cubic_in_out { return cubic_in_out(amount) }
    if easing == Easing.sine_in {
        return 1.0 - Math.cos(amount * Math.pi() * 0.5)
    }
    if easing == Easing.sine_out {
        return Math.sin(amount * Math.pi() * 0.5)
    }
    if easing == Easing.sine_in_out {
        return -(Math.cos(Math.pi() * amount) - 1.0) * 0.5
    }
    if easing == Easing.back_in { return back_in(amount) }
    if easing == Easing.back_out { return back_out(amount) }
    if easing == Easing.back_in_out { return back_in_out(amount) }
    if easing == Easing.bounce_in {
        return 1.0 - bounce_out(1.0 - amount)
    }
    if easing == Easing.bounce_out { return bounce_out(amount) }
    return bounce_in_out(amount)
}

func quadratic_in(amount:float) float { return amount * amount }

func quadratic_out(amount:float) float {
    let inverse = 1.0 - amount
    return 1.0 - inverse * inverse
}

func quadratic_in_out(amount:float) float {
    if amount < 0.5 { return 2.0 * amount * amount }
    let inverse = -2.0 * amount + 2.0
    return 1.0 - inverse * inverse * 0.5
}

func cubic_in_out(amount:float) float {
    if amount < 0.5 { return 4.0 * amount * amount * amount }
    let inverse = -2.0 * amount + 2.0
    return 1.0 - inverse * inverse * inverse * 0.5
}

func back_in(amount:float) float {
    let overshoot = 1.70158
    return (overshoot + 1.0) * amount * amount * amount -
        overshoot * amount * amount
}

func back_out(amount:float) float {
    let overshoot = 1.70158
    let shifted = amount - 1.0
    return 1.0 + (overshoot + 1.0) * shifted * shifted * shifted +
        overshoot * shifted * shifted
}

func back_in_out(amount:float) float {
    let overshoot = 1.70158 * 1.525
    if amount < 0.5 {
        let scaled = amount * 2.0
        return scaled * scaled * ((overshoot + 1.0) * scaled - overshoot) * 0.5
    }
    let scaled = amount * 2.0 - 2.0
    return (scaled * scaled * ((overshoot + 1.0) * scaled + overshoot) + 2.0) * 0.5
}

func bounce_out(amount:float) float {
    let strength = 7.5625
    let divisor = 2.75
    if amount < 1.0 / divisor { return strength * amount * amount }
    if amount < 2.0 / divisor {
        let shifted = amount - 1.5 / divisor
        return strength * shifted * shifted + 0.75
    }
    if amount < 2.5 / divisor {
        let shifted = amount - 2.25 / divisor
        return strength * shifted * shifted + 0.9375
    }
    let shifted = amount - 2.625 / divisor
    return strength * shifted * shifted + 0.984375
}

func bounce_in_out(amount:float) float {
    if amount < 0.5 {
        return (1.0 - bounce_out(1.0 - amount * 2.0)) * 0.5
    }
    return (1.0 + bounce_out(amount * 2.0 - 1.0)) * 0.5
}
