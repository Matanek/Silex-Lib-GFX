use GFX.Color
use STD.Math

public use GFX.Animation.Easing.Easing
public use GFX.Animation.Playback.Playback
public use GFX.Animation.Plugin.Plugin
public use GFX.Animation.Timeline.Timeline

public func wait(duration:float) Timeline {
    return Timeline.wait(duration)
}

public func move_to(
    value:Math.Vec2,
    duration:float,
    easing:Easing = Easing.linear
) Timeline {
    return Timeline.move_to(value, duration, easing)
}

public func rotate_to(
    value:float,
    duration:float,
    easing:Easing = Easing.linear
) Timeline {
    return Timeline.rotate_to(value, duration, easing)
}

public func scale_to(
    value:float,
    duration:float,
    easing:Easing = Easing.linear
) Timeline {
    return Timeline.scale_to(value, duration, easing)
}

public func scale_to(
    value:Math.Vec2,
    duration:float,
    easing:Easing = Easing.linear
) Timeline {
    return Timeline.scale_to(value, duration, easing)
}

public func color_to(
    value:Color,
    duration:float,
    easing:Easing = Easing.linear
) Timeline {
    return Timeline.color_to(value, duration, easing)
}

public func sequence(children:Timeline[]) Timeline {
    return Timeline.sequence(children)
}

public func parallel(children:Timeline[]) Timeline {
    return Timeline.parallel(children)
}
