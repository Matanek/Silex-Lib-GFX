use GFX.Animation.Easing.Easing
use GFX.Animation.Easing.sample as sample_easing
use GFX.Animation.Playback.Playback
use GFX.Color
use STD.Math

struct PositionClip {
    let start:float
    let duration:float
    let end:Math.Vec2
    let easing:Easing
}

struct Position3DClip {
    let start:float
    let duration:float
    let end:Math.Vec3
    let easing:Easing
}

struct RotationClip {
    let start:float
    let duration:float
    let end:float
    let easing:Easing
}

struct Rotation3DClip {
    let start:float
    let duration:float
    let end:Math.Quat
    let easing:Easing
}

struct ScaleClip {
    let start:float
    let duration:float
    let end:Math.Vec2
    let easing:Easing
}

struct Scale3DClip {
    let start:float
    let duration:float
    let end:Math.Vec3
    let easing:Easing
}

struct ColorClip {
    let start:float
    let duration:float
    let end:Color
    let easing:Easing
}

public struct Timeline {
    private var position_clips:PositionClip[]
    private var position_3d_clips:Position3DClip[]
    private var rotation_clips:RotationClip[]
    private var rotation_3d_clips:Rotation3DClip[]
    private var scale_clips:ScaleClip[]
    private var scale_3d_clips:Scale3DClip[]
    private var color_clips:ColorClip[]
    private var total_duration:float
    private var ping_ponging:bool
    private var looping:bool

    module init() {
        self.position_clips = []
        self.position_3d_clips = []
        self.rotation_clips = []
        self.rotation_3d_clips = []
        self.scale_clips = []
        self.scale_3d_clips = []
        self.color_clips = []
        self.total_duration = 0.0
        self.ping_ponging = false
        self.looping = false
    }

    func duration() float { return self.total_duration }

    func loop() {
        if self.total_duration <= 0.0 {
            panic("GFX.Animation.Timeline.loop requires a positive duration")
        }
        self.looping = true
    }

    func ping_pong() {
        if self.total_duration <= 0.0 {
            panic("GFX.Animation.Timeline.ping_pong requires a positive duration")
        }
        self.ping_ponging = true
    }

    func play() Playback { return Playback(self) }

    module static func wait(duration:float) Timeline {
        require_positive_duration(duration, "wait")
        var result = Timeline()
        result.total_duration = duration
        return result
    }

    module static func move_to(
        value:Math.Vec2,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "move_to")
        var result = Timeline()
        result.position_clips.append(PositionClip(
            start:0.0,
            duration:duration,
            end:value,
            easing:easing
        ))
        result.total_duration = duration
        return result
    }

    module static func move_to(
        value:Math.Vec3,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "move_to")
        var result = Timeline()
        result.position_3d_clips.append(Position3DClip(
            start:0.0,
            duration:duration,
            end:value,
            easing:easing
        ))
        result.total_duration = duration
        return result
    }

    module static func rotate_to(
        value:float,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "rotate_to")
        var result = Timeline()
        result.rotation_clips.append(RotationClip(
            start:0.0,
            duration:duration,
            end:value,
            easing:easing
        ))
        result.total_duration = duration
        return result
    }

    module static func rotate_to(
        value:Math.Quat,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "rotate_to")
        var result = Timeline()
        result.rotation_3d_clips.append(Rotation3DClip(
            start:0.0,
            duration:duration,
            end:value.normalized(),
            easing:easing
        ))
        result.total_duration = duration
        return result
    }

    module static func scale_to(
        value:float,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "scale_to")
        var result = Timeline.scale_to(Math.Vec2(value), duration, easing)
        result.scale_3d_clips.append(Scale3DClip(
            start:0.0,
            duration:duration,
            end:Math.Vec3(value),
            easing:easing
        ))
        return result
    }

    module static func scale_to(
        value:Math.Vec2,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "scale_to")
        var result = Timeline()
        result.scale_clips.append(ScaleClip(
            start:0.0,
            duration:duration,
            end:value,
            easing:easing
        ))
        result.total_duration = duration
        return result
    }

    module static func scale_to(
        value:Math.Vec3,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "scale_to")
        var result = Timeline()
        result.scale_3d_clips.append(Scale3DClip(
            start:0.0,
            duration:duration,
            end:value,
            easing:easing
        ))
        result.total_duration = duration
        return result
    }

    module static func color_to(
        value:Color,
        duration:float,
        easing:Easing = Easing.linear
    ) Timeline {
        require_positive_duration(duration, "color_to")
        var result = Timeline()
        result.color_clips.append(ColorClip(
            start:0.0,
            duration:duration,
            end:value,
            easing:easing
        ))
        result.total_duration = duration
        return result
    }

    module static func sequence(children:Timeline[]) Timeline {
        var result = Timeline()
        for child in children {
            result.append(child, result.total_duration)
            result.total_duration += child.total_duration
        }
        return result
    }

    module static func parallel(children:Timeline[]) Timeline {
        var result = Timeline()
        for child in children {
            result.append(child, 0.0)
            if child.total_duration > result.total_duration {
                result.total_duration = child.total_duration
            }
        }
        return result
    }

    module func has_position() bool { return !self.position_clips.is_empty() }
    module func has_position_3d() bool { return !self.position_3d_clips.is_empty() }
    module func has_rotation() bool { return !self.rotation_clips.is_empty() }
    module func has_rotation_3d() bool { return !self.rotation_3d_clips.is_empty() }
    module func has_scale() bool { return !self.scale_clips.is_empty() }
    module func has_scale_3d() bool { return !self.scale_3d_clips.is_empty() }
    module func has_color() bool { return !self.color_clips.is_empty() }

    module func position_at(time:float, initial:Math.Vec2) Math.Vec2 {
        let local_time = self.local_time(time)
        let reversing = self.reversing_at(time)
        var previous = initial
        for clip in self.position_clips {
            if local_time < clip.start { return previous }
            if local_time <= clip.start + clip.duration {
                return previous.lerp(
                    clip.end,
                    sample_easing(
                        clip.easing,
                        (local_time - clip.start) / clip.duration,
                        reversing
                    )
                )
            }
            previous = clip.end
        }
        return previous
    }

    module func position_3d_at(time:float, initial:Math.Vec3) Math.Vec3 {
        let local_time = self.local_time(time)
        let reversing = self.reversing_at(time)
        var previous = initial
        for clip in self.position_3d_clips {
            if local_time < clip.start { return previous }
            if local_time <= clip.start + clip.duration {
                return previous.lerp(
                    clip.end,
                    sample_easing(
                        clip.easing,
                        (local_time - clip.start) / clip.duration,
                        reversing
                    )
                )
            }
            previous = clip.end
        }
        return previous
    }

    module func rotation_at(time:float, initial:float) float {
        let local_time = self.local_time(time)
        let reversing = self.reversing_at(time)
        var previous = initial
        for clip in self.rotation_clips {
            if local_time < clip.start { return previous }
            if local_time <= clip.start + clip.duration {
                return Math.lerp(
                    previous,
                    clip.end,
                    sample_easing(
                        clip.easing,
                        (local_time - clip.start) / clip.duration,
                        reversing
                    )
                )
            }
            previous = clip.end
        }
        return previous
    }

    module func rotation_3d_at(time:float, initial:Math.Quat) Math.Quat {
        let local_time = self.local_time(time)
        let reversing = self.reversing_at(time)
        var previous = initial.normalized()
        for clip in self.rotation_3d_clips {
            if local_time < clip.start { return previous }
            if local_time <= clip.start + clip.duration {
                return interpolate_rotation(
                    previous,
                    clip.end,
                    sample_easing(
                        clip.easing,
                        (local_time - clip.start) / clip.duration,
                        reversing
                    )
                )
            }
            previous = clip.end
        }
        return previous
    }

    module func scale_at(time:float, initial:Math.Vec2) Math.Vec2 {
        let local_time = self.local_time(time)
        let reversing = self.reversing_at(time)
        var previous = initial
        for clip in self.scale_clips {
            if local_time < clip.start { return previous }
            if local_time <= clip.start + clip.duration {
                return previous.lerp(
                    clip.end,
                    sample_easing(
                        clip.easing,
                        (local_time - clip.start) / clip.duration,
                        reversing
                    )
                )
            }
            previous = clip.end
        }
        return previous
    }

    module func scale_3d_at(time:float, initial:Math.Vec3) Math.Vec3 {
        let local_time = self.local_time(time)
        let reversing = self.reversing_at(time)
        var previous = initial
        for clip in self.scale_3d_clips {
            if local_time < clip.start { return previous }
            if local_time <= clip.start + clip.duration {
                return previous.lerp(
                    clip.end,
                    sample_easing(
                        clip.easing,
                        (local_time - clip.start) / clip.duration,
                        reversing
                    )
                )
            }
            previous = clip.end
        }
        return previous
    }

    module func color_at(time:float, initial:Color) Color {
        let local_time = self.local_time(time)
        let reversing = self.reversing_at(time)
        var previous = initial
        for clip in self.color_clips {
            if local_time < clip.start { return previous }
            if local_time <= clip.start + clip.duration {
                return previous.lerp(
                    clip.end,
                    sample_easing(
                        clip.easing,
                        (local_time - clip.start) / clip.duration,
                        reversing
                    )
                )
            }
            previous = clip.end
        }
        return previous
    }

    private func append(child:Timeline, offset:float) {
        if child.looping || child.ping_ponging {
            panic("GFX.Animation cannot compose a child timeline with playback options")
        }
        for clip in child.position_clips {
            self.insert_position(PositionClip(
                start:clip.start + offset,
                duration:clip.duration,
                end:clip.end,
                easing:clip.easing
            ))
        }
        for clip in child.position_3d_clips {
            self.insert_position_3d(Position3DClip(
                start:clip.start + offset,
                duration:clip.duration,
                end:clip.end,
                easing:clip.easing
            ))
        }
        for clip in child.rotation_clips {
            self.insert_rotation(RotationClip(
                start:clip.start + offset,
                duration:clip.duration,
                end:clip.end,
                easing:clip.easing
            ))
        }
        for clip in child.rotation_3d_clips {
            self.insert_rotation_3d(Rotation3DClip(
                start:clip.start + offset,
                duration:clip.duration,
                end:clip.end,
                easing:clip.easing
            ))
        }
        for clip in child.scale_clips {
            self.insert_scale(ScaleClip(
                start:clip.start + offset,
                duration:clip.duration,
                end:clip.end,
                easing:clip.easing
            ))
        }
        for clip in child.scale_3d_clips {
            self.insert_scale_3d(Scale3DClip(
                start:clip.start + offset,
                duration:clip.duration,
                end:clip.end,
                easing:clip.easing
            ))
        }
        for clip in child.color_clips {
            self.insert_color(ColorClip(
                start:clip.start + offset,
                duration:clip.duration,
                end:clip.end,
                easing:clip.easing
            ))
        }
    }

    private func insert_position(clip:PositionClip) {
        var index = 0
        while index < self.position_clips.count() &&
            self.position_clips[index].start <= clip.start
        {
            if overlaps(self.position_clips[index].start,
                self.position_clips[index].duration, clip.start, clip.duration)
            {
                panic("GFX.Animation.parallel cannot overlap two position animations")
            }
            index++
        }
        if index < self.position_clips.count() &&
            overlaps(self.position_clips[index].start,
                self.position_clips[index].duration, clip.start, clip.duration)
        {
            panic("GFX.Animation.parallel cannot overlap two position animations")
        }
        self.position_clips.insert(index, clip)
    }

    private func insert_position_3d(clip:Position3DClip) {
        var index = 0
        while index < self.position_3d_clips.count() &&
            self.position_3d_clips[index].start <= clip.start
        {
            if overlaps(self.position_3d_clips[index].start,
                self.position_3d_clips[index].duration, clip.start, clip.duration)
            {
                panic("GFX.Animation.parallel cannot overlap two 3D position animations")
            }
            index++
        }
        if index < self.position_3d_clips.count() &&
            overlaps(self.position_3d_clips[index].start,
                self.position_3d_clips[index].duration, clip.start, clip.duration)
        {
            panic("GFX.Animation.parallel cannot overlap two 3D position animations")
        }
        self.position_3d_clips.insert(index, clip)
    }

    private func insert_rotation(clip:RotationClip) {
        var index = 0
        while index < self.rotation_clips.count() &&
            self.rotation_clips[index].start <= clip.start
        {
            if overlaps(self.rotation_clips[index].start,
                self.rotation_clips[index].duration, clip.start, clip.duration)
            {
                panic("GFX.Animation.parallel cannot overlap two rotation animations")
            }
            index++
        }
        if index < self.rotation_clips.count() &&
            overlaps(self.rotation_clips[index].start,
                self.rotation_clips[index].duration, clip.start, clip.duration)
        {
            panic("GFX.Animation.parallel cannot overlap two rotation animations")
        }
        self.rotation_clips.insert(index, clip)
    }

    private func insert_rotation_3d(clip:Rotation3DClip) {
        var index = 0
        while index < self.rotation_3d_clips.count() &&
            self.rotation_3d_clips[index].start <= clip.start
        {
            if overlaps(self.rotation_3d_clips[index].start,
                self.rotation_3d_clips[index].duration, clip.start, clip.duration)
            {
                panic("GFX.Animation.parallel cannot overlap two 3D rotation animations")
            }
            index++
        }
        if index < self.rotation_3d_clips.count() &&
            overlaps(self.rotation_3d_clips[index].start,
                self.rotation_3d_clips[index].duration, clip.start, clip.duration)
        {
            panic("GFX.Animation.parallel cannot overlap two 3D rotation animations")
        }
        self.rotation_3d_clips.insert(index, clip)
    }

    private func insert_scale(clip:ScaleClip) {
        var index = 0
        while index < self.scale_clips.count() &&
            self.scale_clips[index].start <= clip.start
        {
            if overlaps(self.scale_clips[index].start,
                self.scale_clips[index].duration, clip.start, clip.duration)
            {
                panic("GFX.Animation.parallel cannot overlap two scale animations")
            }
            index++
        }
        if index < self.scale_clips.count() &&
            overlaps(self.scale_clips[index].start,
                self.scale_clips[index].duration, clip.start, clip.duration)
        {
            panic("GFX.Animation.parallel cannot overlap two scale animations")
        }
        self.scale_clips.insert(index, clip)
    }

    private func insert_scale_3d(clip:Scale3DClip) {
        var index = 0
        while index < self.scale_3d_clips.count() &&
            self.scale_3d_clips[index].start <= clip.start
        {
            if overlaps(self.scale_3d_clips[index].start,
                self.scale_3d_clips[index].duration, clip.start, clip.duration)
            {
                panic("GFX.Animation.parallel cannot overlap two 3D scale animations")
            }
            index++
        }
        if index < self.scale_3d_clips.count() &&
            overlaps(self.scale_3d_clips[index].start,
                self.scale_3d_clips[index].duration, clip.start, clip.duration)
        {
            panic("GFX.Animation.parallel cannot overlap two 3D scale animations")
        }
        self.scale_3d_clips.insert(index, clip)
    }

    private func insert_color(clip:ColorClip) {
        var index = 0
        while index < self.color_clips.count() &&
            self.color_clips[index].start <= clip.start
        {
            if overlaps(self.color_clips[index].start,
                self.color_clips[index].duration, clip.start, clip.duration)
            {
                panic("GFX.Animation.parallel cannot overlap two color animations")
            }
            index++
        }
        if index < self.color_clips.count() &&
            overlaps(self.color_clips[index].start,
                self.color_clips[index].duration, clip.start, clip.duration)
        {
            panic("GFX.Animation.parallel cannot overlap two color animations")
        }
        self.color_clips.insert(index, clip)
    }

    private func local_time(time:float) float {
        let elapsed = Math.max(time, 0.0)
        if self.ping_ponging {
            let phase = self.ping_pong_phase(elapsed)
            if phase <= self.total_duration { return phase }
            return self.total_duration * 2.0 - phase
        }
        if self.looping { return Math.modulo(elapsed, self.total_duration) }
        return elapsed
    }

    private func reversing_at(time:float) bool {
        if !self.ping_ponging { return false }
        return self.ping_pong_phase(Math.max(time, 0.0)) > self.total_duration
    }

    private func ping_pong_phase(elapsed:float) float {
        let cycle_duration = self.total_duration * 2.0
        var phase = elapsed
        if self.looping {
            phase = Math.modulo(phase, cycle_duration)
        } elif phase > cycle_duration {
            phase = cycle_duration
        }
        return phase
    }
}

func require_positive_duration(duration:float, operation:str) {
    if duration <= 0.0 {
        panic("GFX.Animation.$(operation) requires a positive duration")
    }
}

func interpolate_rotation(start:Math.Quat, end:Math.Quat, amount:float) Math.Quat {
    var destination = end
    if start.dot(destination) < 0.0 {
        destination = destination.multiply(-1.0)
    }
    return start.multiply(1.0 - amount)
        .add(destination.multiply(amount))
        .normalized()
}

func overlaps(left_start:float, left_duration:float, right_start:float, right_duration:float) bool {
    return left_start < right_start + right_duration &&
        right_start < left_start + left_duration
}
