use GFX.Bootstrap.Plugin as PluginProtocol
use GFX.Bootstrap.Application
use GFX.Bootstrap.Schedule
use GFX.Camera.Frame.Frame as CameraFrame
use GFX.Camera.Frame.from_world as collect_camera_frame
use GFX.Assets
use GFX.Color
use GFX.ECS
use GFX.GPU
use GFX.Rendering
use GFX.Scene.Frame.from_world as collect_scene_frame
use GFX.Time.Plugin as TimePlugin
use GFX.Window
use GFX.Camera.Plugin as CameraPlugin
use GFX.Assets.Plugin as AssetsPlugin
use GFX.GPU.Plugin as GPUPlugin
use GFX.Rendering.PluginSettings

public struct Plugin:PluginProtocol {
    private let settings:PluginSettings

    public init(settings:PluginSettings = PluginSettings()) {
        self.settings = settings
    }

    func id() str { return "GFX.Plugins.Rendering" }

    func build(application:Application) {
        application.install(TimePlugin())
        application.install(GPUPlugin())
        application.install(CameraPlugin())
        application.install(AssetsPlugin())
        application.resources().insert(Rendering.Renderer(self.clear_color()))
        application.add_system(Schedule.render, prepare_frame)
        application.add_after_system(Schedule.render, render_frame)
        application.add_system(Schedule.shutdown, stop_renderer)
    }

    private func clear_color() Color {
        return self.settings.clear
    }
}

func prepare_frame(
    world:@ECS.World,
    window:@Window,
    meshes:@Assets.Meshes,
    images:@Assets.Images,
    renderer:&Rendering.Renderer
) {
    let viewport = window.pixel_size()
    renderer.set_frame(
        collect_camera_frame(world, viewport),
        collect_scene_frame(world, meshes, images),
        viewport
    )
}

func render_frame(
    device:@GPU.Device,
    surface:@GPU.Surface,
    renderer:&Rendering.Renderer
) {
    renderer.render(device, surface)
}

func stop_renderer(application:Application) {
    var resources = application.resources()
    var removed = resources.remove<Rendering.Renderer>()
    assert(removed != null)
}
