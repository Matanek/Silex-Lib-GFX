public struct BufferUsage {
    var vertices:bool = false
    var indices:bool = false
    var indirect:bool = false
    var graphics_storage:bool = false
    var compute_read:bool = false
    var compute_write:bool = false

    public static func vertex() BufferUsage { return BufferUsage(vertices:true) }
    public static func index() BufferUsage { return BufferUsage(indices:true) }
    public static func indirect_commands() BufferUsage { return BufferUsage(indirect:true) }
    public static func storage() BufferUsage {
        return BufferUsage(graphics_storage:true, compute_read:true, compute_write:true)
    }
}

public struct TextureUsage {
    var sampled:bool = false
    var color_target:bool = false
    var depth_stencil_target:bool = false
    var graphics_storage:bool = false
    var compute_read:bool = false
    var compute_write:bool = false
    var compute_read_write:bool = false

    public static func for_sampling() TextureUsage { return TextureUsage(sampled:true) }
    public static func as_color_target() TextureUsage { return TextureUsage(color_target:true) }
    public static func as_depth_target() TextureUsage { return TextureUsage(depth_stencil_target:true) }
    public static func storage() TextureUsage {
        return TextureUsage(graphics_storage:true, compute_read:true, compute_write:true)
    }
}

internal func buffer_usage_flags(usage:BufferUsage) uint32 {
    var result:uint32 = 0
    if usage.vertices { result += (1 as uint32) << 0 }
    if usage.indices { result += (1 as uint32) << 1 }
    if usage.indirect { result += (1 as uint32) << 2 }
    if usage.graphics_storage { result += (1 as uint32) << 3 }
    if usage.compute_read { result += (1 as uint32) << 4 }
    if usage.compute_write { result += (1 as uint32) << 5 }
    return result
}

internal func texture_usage_flags(usage:TextureUsage) uint32 {
    var result:uint32 = 0
    if usage.sampled { result += (1 as uint32) << 0 }
    if usage.color_target { result += (1 as uint32) << 1 }
    if usage.depth_stencil_target { result += (1 as uint32) << 2 }
    if usage.graphics_storage { result += (1 as uint32) << 3 }
    if usage.compute_read { result += (1 as uint32) << 4 }
    if usage.compute_write { result += (1 as uint32) << 5 }
    if usage.compute_read_write { result += (1 as uint32) << 6 }
    return result
}

internal func native_bool(value:bool) int32 {
    if value { return 1 }
    return 0
}
