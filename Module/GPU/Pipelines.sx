use Interop.C
use Interop.Boundary
use GFX.GPU.Types
use GFX.GPU.Device
use GFX.GPU.Device.gpu_error
use GFX.GPU.Properties.Properties

public struct ShaderSettings {
    var entry:str = "main"
    var samplers:int = 0
    var storage_textures:int = 0
    var storage_buffers:int = 0
    var uniform_buffers:int = 0
    var name:str? = null
}

public struct VertexBufferLayout {
    let slot:int
    let pitch:int
    var rate:Types.VertexRate? = null
}

public struct VertexAttribute {
    let location:int
    let buffer_slot:int
    var format:Types.VertexFormat? = null
    let offset:int
}

public struct StencilFace {
    var fail:Types.Stencil? = null
    var pass:Types.Stencil? = null
    var depth_fail:Types.Stencil? = null
    var compare:Types.Compare? = null
}

public struct DepthStencilState {
    var depth_compare:Types.Compare? = null
    var back:StencilFace = StencilFace()
    var front:StencilFace = StencilFace()
    var stencil_compare_mask:uint8 = 255
    var stencil_write_mask:uint8 = 255
    var depth_test:bool = false
    var depth_write:bool = false
    var stencil_test:bool = false
}

public struct RasterizerState {
    var fill:Types.Fill? = null
    var cull:Types.Cull? = null
    var front_face:Types.FrontFace? = null
    var depth_bias:float = 0.0
    var depth_bias_clamp:float = 0.0
    var depth_bias_slope:float = 0.0
    var bias_depth:bool = false
    var clip_depth:bool = true
}

public struct MultisampleState {
    var samples:Types.Samples? = null
    var alpha_to_coverage:bool = false
}

public struct BlendState {
    var source_color:Types.BlendFactor? = null
    var destination_color:Types.BlendFactor? = null
    var color_operation:Types.BlendOperation? = null
    var source_alpha:Types.BlendFactor? = null
    var destination_alpha:Types.BlendFactor? = null
    var alpha_operation:Types.BlendOperation? = null
    var write_red:bool = true
    var write_green:bool = true
    var write_blue:bool = true
    var write_alpha:bool = true
    var enabled:bool = false
}

public struct ColorTargetFormat {
    var format:Types.TextureFormat? = null
    var blend:BlendState = BlendState()
}

public struct GraphicsPipelineSettings {
    var vertex_buffers:VertexBufferLayout[]? = null
    var attributes:VertexAttribute[]? = null
    var primitive:Types.Primitive? = null
    var rasterizer:RasterizerState = RasterizerState()
    var multisample:MultisampleState = MultisampleState()
    var depth_stencil:DepthStencilState = DepthStencilState()
    var color_targets:ColorTargetFormat[]? = null
    var depth_stencil_format:Types.TextureFormat? = null
    var name:str? = null
}

public struct ComputePipelineSettings {
    var entry:str = "main"
    var samplers:int = 0
    var read_only_storage_textures:int = 0
    var read_only_storage_buffers:int = 0
    var read_write_storage_textures:int = 0
    var read_write_storage_buffers:int = 0
    var uniform_buffers:int = 0
    var threads_x:int = 1
    var threads_y:int = 1
    var threads_z:int = 1
    var name:str? = null
}

public struct ShaderProgram {
    module let vertex_msl:str?
    module let fragment_msl:str?
    module let vertex_spirv:str?
    module let fragment_spirv:str?
    module let vertex_dxil:str?
    module let fragment_dxil:str?
    module let vertex_entry:str
    module let fragment_entry:str
    module let vertex_samplers:int
    module let vertex_storage_textures:int
    module let vertex_storage_buffers:int
    module let vertex_uniform_buffers:int
    module let fragment_samplers:int
    module let fragment_storage_textures:int
    module let fragment_storage_buffers:int
    module let fragment_uniform_buffers:int

    static func hlsl(
        source:str = "",
        file:str = "",
        vertex:str = "vertex_main",
        fragment:str = "fragment_main"
    ) ShaderProgram {
        panic("GPU.ShaderProgram.hlsl must be compiled by Silex")
    }
}

public struct ComputeProgram {
    module let msl:str?
    module let spirv:str?
    module let dxil:str?
    module let entry:str
    module let samplers:int
    module let read_only_storage_textures:int
    module let read_only_storage_buffers:int
    module let read_write_storage_textures:int
    module let read_write_storage_buffers:int
    module let uniform_buffers:int
    module let threads_x:int
    module let threads_y:int
    module let threads_z:int

    static func hlsl(
        source:str = "",
        file:str = "",
        entry:str = "compute_main"
    ) ComputeProgram {
        panic("GPU.ComputeProgram.hlsl must be compiled by Silex")
    }
}

public class Shader {
    private let device_handle:uint
    private let handle:uint
    private var device_owner:Device? = null
    private var current_stage:Types.ShaderStage? = null

    module init(device:Device, stage:Types.ShaderStage, format:Types.ShaderFormat, code:@uint8[..], settings:ShaderSettings) {
        if code.count() == 0 { panic("GFX.GPU shader code cannot be empty") }
        validate_shader_counts(settings)
        var properties = Properties()
        if let name = settings.name { properties.text("SDL.gpu.shader.create.name", name) }
        var compact = C.string(code)
        var storage:uint[7]
        let address = C.address_bits(C.mutable_pointer(storage))
        let code_size = C.store<uint>(address, 0 as uint, code.count() as uint)
        let code_pointer = C.store<uint>(address, 8 as uint, C.address_bits(C.pointer(compact)))
        let entry = C.store<uint>(address, 16 as uint, C.address_bits(C.terminated_pointer(settings.entry)))
        let stored_format = C.store<uint32>(address, 24 as uint, format.raw_value as uint32)
        let stored_stage = C.store<int32>(address, 28 as uint, stage.raw_value as int32)
        let samplers = C.store<uint32>(address, 32 as uint, settings.samplers as uint32)
        let textures = C.store<uint32>(address, 36 as uint, settings.storage_textures as uint32)
        let buffers = C.store<uint32>(address, 40 as uint, settings.storage_buffers as uint32)
        let uniforms = C.store<uint32>(address, 44 as uint, settings.uniform_buffers as uint32)
        let stored_properties = C.store<uint32>(address, 48 as uint, properties.native_handle())
        let handle = C.address_bits(sdl_create_gpu_shader(
            C.pointer_bits(device.native_handle()), C.pointer_bits(address)
        ))
        if handle == 0 as uint { panic("GFX.GPU could not create a shader: " + gpu_error()) }
        self.device_handle = device.native_handle()
        self.handle = handle
        self.device_owner = device
        self.current_stage = stage
    }

    drop {
        sdl_release_gpu_shader(C.pointer_bits(self.device_handle), C.pointer_bits(self.handle))
        self.device_owner = null
    }

    func stage() Types.ShaderStage {
        if let stage = self.current_stage { return stage }
        panic("GFX.GPU shader has no stage")
    }
    module func native_handle() uint { return self.handle }
    module func owner_handle() uint { return self.device_handle }
}

// Public opaque graphics pipeline. Applications obtain it from Device and
// pass it to render passes; GPU owns its construction and native handles.
public class GraphicsPipeline {
    private let device_handle:uint
    private let handle:uint
    private var device_owner:Device? = null
    private let current_primitive:Types.Primitive

    module init(device:Device, vertex:@Shader, fragment:@Shader, settings:GraphicsPipelineSettings) {
        if vertex.owner_handle() != device.native_handle() || fragment.owner_handle() != device.native_handle() {
            panic("GFX.GPU pipeline shaders must belong to its device")
        }
        if vertex.stage() != Types.ShaderStage.vertex || fragment.stage() != Types.ShaderStage.fragment {
            panic("GFX.GPU graphics pipeline requires a vertex shader followed by a fragment shader")
        }
        var configured_vertex_buffers:VertexBufferLayout[] = []
        var configured_attributes:VertexAttribute[] = []
        var configured_targets:ColorTargetFormat[] = []
        if let values = settings.vertex_buffers { configured_vertex_buffers = values }
        if let values = settings.attributes { configured_attributes = values }
        if let values = settings.color_targets { configured_targets = values }
        if configured_vertex_buffers.count() > 16 || configured_attributes.count() > 16 || configured_targets.count() > 8 {
            panic("GFX.GPU pipeline description exceeds the portable limits")
        }
        var properties = Properties()
        if let name = settings.name { properties.text("SDL.gpu.graphicspipeline.create.name", name) }

        var vertex_buffers:uint[64]
        var attributes:uint[128]
        var targets:uint[40]
        encode_vertex_buffers(configured_vertex_buffers, C.address_bits(C.mutable_pointer(vertex_buffers)))
        encode_attributes(configured_attributes, C.address_bits(C.mutable_pointer(attributes)))
        encode_targets(configured_targets, C.address_bits(C.mutable_pointer(targets)))

        var info:uint[21]
        let address = C.address_bits(C.mutable_pointer(info))
        let vertex_shader = C.store<uint>(address, 0 as uint, vertex.native_handle())
        let fragment_shader = C.store<uint>(address, 8 as uint, fragment.native_handle())
        let vertex_buffers_pointer = C.store<uint>(address, 16 as uint, C.address_bits(C.mutable_pointer(vertex_buffers)))
        let vertex_buffer_count = C.store<uint32>(address, 24 as uint, configured_vertex_buffers.count() as uint32)
        let attributes_pointer = C.store<uint>(address, 32 as uint, C.address_bits(C.mutable_pointer(attributes)))
        let attribute_count = C.store<uint32>(address, 40 as uint, configured_attributes.count() as uint32)
        let primitive = C.store<int32>(address, 48 as uint, primitive_type(settings.primitive).raw_value as int32)
        encode_rasterizer(settings.rasterizer, address + 52)
        encode_multisample(settings.multisample, address + 80)
        encode_depth_stencil(settings.depth_stencil, address + 92)
        let targets_pointer = C.store<uint>(address, 136 as uint, C.address_bits(C.mutable_pointer(targets)))
        let target_count = C.store<uint32>(address, 144 as uint, configured_targets.count() as uint32)
        var depth_format = Types.TextureFormat.invalid
        var has_depth = false
        if let configured = settings.depth_stencil_format { depth_format = configured; has_depth = true }
        let stored_depth = C.store<int32>(address, 148 as uint, depth_format.raw_value as int32)
        let stored_has_depth = C.store<uint8>(address, 152 as uint, Types.native_bool(has_depth) as uint8)
        let stored_properties = C.store<uint32>(address, 160 as uint, properties.native_handle())

        let handle = C.address_bits(sdl_create_gpu_graphics_pipeline(
            C.pointer_bits(device.native_handle()), C.pointer_bits(address)
        ))
        if handle == 0 as uint { panic("GFX.GPU could not create a graphics pipeline: " + gpu_error()) }
        self.device_handle = device.native_handle()
        self.handle = handle
        self.device_owner = device
        self.current_primitive = primitive_type(settings.primitive)
    }

    drop {
        sdl_release_gpu_graphics_pipeline(C.pointer_bits(self.device_handle), C.pointer_bits(self.handle))
        self.device_owner = null
    }

    module func native_handle() uint { return self.handle }
    module func owner_handle() uint { return self.device_handle }
    module func primitive() Types.Primitive { return self.current_primitive }
}

// Public opaque compute pipeline. Applications obtain it from Device and pass
// it to compute passes; GPU owns its construction and native handles.
public class ComputePipeline {
    private let device_handle:uint
    private let handle:uint
    private var device_owner:Device? = null

    module init(device:Device, format:Types.ShaderFormat, code:@uint8[..], settings:ComputePipelineSettings) {
        if code.count() == 0 { panic("GFX.GPU compute shader code cannot be empty") }
        validate_compute_counts(settings)
        if settings.threads_x == 0 || settings.threads_y == 0 || settings.threads_z == 0 {
            panic("GFX.GPU compute thread counts must be positive")
        }
        var properties = Properties()
        if let name = settings.name { properties.text("SDL.gpu.computepipeline.create.name", name) }
        var compact = C.string(code)
        var info:uint[9]
        let address = C.address_bits(C.mutable_pointer(info))
        let code_size = C.store<uint>(address, 0 as uint, code.count() as uint)
        let code_pointer = C.store<uint>(address, 8 as uint, C.address_bits(C.pointer(compact)))
        let entry = C.store<uint>(address, 16 as uint, C.address_bits(C.terminated_pointer(settings.entry)))
        let stored_format = C.store<uint32>(address, 24 as uint, format.raw_value as uint32)
        let samplers = C.store<uint32>(address, 28 as uint, settings.samplers as uint32)
        let read_textures = C.store<uint32>(address, 32 as uint, settings.read_only_storage_textures as uint32)
        let read_buffers = C.store<uint32>(address, 36 as uint, settings.read_only_storage_buffers as uint32)
        let write_textures = C.store<uint32>(address, 40 as uint, settings.read_write_storage_textures as uint32)
        let write_buffers = C.store<uint32>(address, 44 as uint, settings.read_write_storage_buffers as uint32)
        let uniforms = C.store<uint32>(address, 48 as uint, settings.uniform_buffers as uint32)
        let threads_x = C.store<uint32>(address, 52 as uint, settings.threads_x as uint32)
        let threads_y = C.store<uint32>(address, 56 as uint, settings.threads_y as uint32)
        let threads_z = C.store<uint32>(address, 60 as uint, settings.threads_z as uint32)
        let stored_properties = C.store<uint32>(address, 64 as uint, properties.native_handle())
        let handle = C.address_bits(sdl_create_gpu_compute_pipeline(
            C.pointer_bits(device.native_handle()), C.pointer_bits(address)
        ))
        if handle == 0 as uint { panic("GFX.GPU could not create a compute pipeline: " + gpu_error()) }
        self.device_handle = device.native_handle()
        self.handle = handle
        self.device_owner = device
    }

    drop {
        sdl_release_gpu_compute_pipeline(C.pointer_bits(self.device_handle), C.pointer_bits(self.handle))
        self.device_owner = null
    }

    module func native_handle() uint { return self.handle }
    module func owner_handle() uint { return self.device_handle }
}

extend Device {
    func shader(stage:Types.ShaderStage, format:Types.ShaderFormat, input:@uint8[..], settings:ShaderSettings = ShaderSettings()) Shader {
        return Shader(self, stage, format, input, settings)
    }

    func shader(stage:Types.ShaderStage, format:Types.ShaderFormat, input:str, settings:ShaderSettings = ShaderSettings()) Shader {
        var code:uint8[] = []
        let count = C.byte_count(input)
        var index:uint = 0
        while index < count {
            code.append(C.byte_at(input, index))
            index++
        }
        return Shader(self, stage, format, @code[0:code.count()], settings)
    }

    func graphics_pipeline(vertex:@Shader, fragment:@Shader, settings:GraphicsPipelineSettings) GraphicsPipeline {
        return GraphicsPipeline(self, vertex, fragment, settings)
    }

    func graphics_pipeline(program:@ShaderProgram, settings:GraphicsPipelineSettings) GraphicsPipeline {
        let formats = self.shader_formats()
        if formats.msl {
            if let vertex_code = program.vertex_msl {
                if let fragment_code = program.fragment_msl {
                    var vertex_bytes = decode_shader(vertex_code)
                    var fragment_bytes = decode_shader(fragment_code)
                    return self.graphics_pipeline(
                        Shader(self, Types.ShaderStage.vertex, Types.ShaderFormat.msl, @vertex_bytes[0:vertex_bytes.count()], shader_settings(
                            copy program.vertex_entry, copy program.vertex_samplers, copy program.vertex_storage_textures,
                            copy program.vertex_storage_buffers, copy program.vertex_uniform_buffers
                        )),
                        Shader(self, Types.ShaderStage.fragment, Types.ShaderFormat.msl, @fragment_bytes[0:fragment_bytes.count()], shader_settings(
                            copy program.fragment_entry, copy program.fragment_samplers, copy program.fragment_storage_textures,
                            copy program.fragment_storage_buffers, copy program.fragment_uniform_buffers
                        )),
                        settings
                    )
                }
            }
        }
        if formats.dxil {
            if let vertex_code = program.vertex_dxil {
                if let fragment_code = program.fragment_dxil {
                    var vertex_bytes = decode_shader(vertex_code)
                    var fragment_bytes = decode_shader(fragment_code)
                    return self.graphics_pipeline(
                        Shader(self, Types.ShaderStage.vertex, Types.ShaderFormat.dxil, @vertex_bytes[0:vertex_bytes.count()], shader_settings(
                            copy program.vertex_entry, copy program.vertex_samplers, copy program.vertex_storage_textures,
                            copy program.vertex_storage_buffers, copy program.vertex_uniform_buffers
                        )),
                        Shader(self, Types.ShaderStage.fragment, Types.ShaderFormat.dxil, @fragment_bytes[0:fragment_bytes.count()], shader_settings(
                            copy program.fragment_entry, copy program.fragment_samplers, copy program.fragment_storage_textures,
                            copy program.fragment_storage_buffers, copy program.fragment_uniform_buffers
                        )),
                        settings
                    )
                }
            }
        }
        if formats.spirv {
            if let vertex_code = program.vertex_spirv {
                if let fragment_code = program.fragment_spirv {
                    var vertex_bytes = decode_shader(vertex_code)
                    var fragment_bytes = decode_shader(fragment_code)
                    return self.graphics_pipeline(
                        Shader(self, Types.ShaderStage.vertex, Types.ShaderFormat.spirv, @vertex_bytes[0:vertex_bytes.count()], shader_settings(
                            copy program.vertex_entry, copy program.vertex_samplers, copy program.vertex_storage_textures,
                            copy program.vertex_storage_buffers, copy program.vertex_uniform_buffers
                        )),
                        Shader(self, Types.ShaderStage.fragment, Types.ShaderFormat.spirv, @fragment_bytes[0:fragment_bytes.count()], shader_settings(
                            copy program.fragment_entry, copy program.fragment_samplers, copy program.fragment_storage_textures,
                            copy program.fragment_storage_buffers, copy program.fragment_uniform_buffers
                        )),
                        settings
                    )
                }
            }
        }
        panic("GFX.GPU device has no shader format compatible with this HLSL program")
    }

    func compute_pipeline(input:Types.ShaderFormat, data:@uint8[..], settings:ComputePipelineSettings) ComputePipeline {
        return ComputePipeline(self, input, data, settings)
    }

    func compute_pipeline(input:Types.ShaderFormat, data:str, settings:ComputePipelineSettings) ComputePipeline {
        var code:uint8[] = []
        let count = C.byte_count(data)
        var index:uint = 0
        while index < count {
            code.append(C.byte_at(data, index))
            index++
        }
        return ComputePipeline(self, input, @code[0:code.count()], settings)
    }

    func compute_pipeline(input:@ComputeProgram, data:str? = null) ComputePipeline {
        let formats = self.shader_formats()
        let settings = ComputePipelineSettings(
            entry:copy input.entry,
            samplers:copy input.samplers,
            read_only_storage_textures:copy input.read_only_storage_textures,
            read_only_storage_buffers:copy input.read_only_storage_buffers,
            read_write_storage_textures:copy input.read_write_storage_textures,
            read_write_storage_buffers:copy input.read_write_storage_buffers,
            uniform_buffers:copy input.uniform_buffers,
            threads_x:copy input.threads_x,
            threads_y:copy input.threads_y,
            threads_z:copy input.threads_z,
            name:data
        )
        if formats.msl {
            if let code = input.msl {
                var bytes = decode_shader(code)
                return ComputePipeline(self, Types.ShaderFormat.msl, @bytes[0:bytes.count()], settings)
            }
        }
        if formats.dxil {
            if let code = input.dxil {
                var bytes = decode_shader(code)
                return ComputePipeline(self, Types.ShaderFormat.dxil, @bytes[0:bytes.count()], settings)
            }
        }
        if formats.spirv {
            if let code = input.spirv {
                var bytes = decode_shader(code)
                return ComputePipeline(self, Types.ShaderFormat.spirv, @bytes[0:bytes.count()], settings)
            }
        }
        panic("GFX.GPU device has no shader format compatible with this HLSL compute program")
    }
}

local func shader_settings(
    entry:str,
    samplers:int,
    storage_textures:int,
    storage_buffers:int,
    uniform_buffers:int
) ShaderSettings {
    return ShaderSettings(
        entry:entry,
        samplers:samplers,
        storage_textures:storage_textures,
        storage_buffers:storage_buffers,
        uniform_buffers:uniform_buffers
    )
}

local func decode_shader(encoded:str) uint8[] {
    let count = C.byte_count(encoded)
    if count % 2 != 0 as uint { panic("GFX.GPU received invalid compiled shader data") }
    var result:uint8[] = []
    var index:uint = 0
    while index < count {
        let high = hex_nibble(C.byte_at(encoded, index))
        let low = hex_nibble(C.byte_at(encoded, index + 1))
        result.append(((high * 16 as uint8) + low) as uint8)
        index += 2
    }
    return result
}

local func hex_nibble(value:uint8) uint8 {
    if value >= 48 as uint8 && value <= 57 as uint8 { return value - 48 as uint8 }
    if value >= 97 as uint8 && value <= 102 as uint8 { return value - 87 as uint8 }
    panic("GFX.GPU received invalid compiled shader data")
}

local func validate_counts(values:int[]) {
    for value in values { if value < 0 { panic("GFX.GPU shader resource counts cannot be negative") } }
}

local func validate_shader_counts(settings:ShaderSettings) {
    validate_counts([settings.samplers, settings.storage_textures, settings.storage_buffers, settings.uniform_buffers])
    if settings.samplers > 16 { panic("GFX.GPU shader supports at most 16 samplers") }
    if settings.storage_textures > 8 || settings.storage_buffers > 8 { panic("GFX.GPU shader supports at most 8 storage textures and buffers") }
    if settings.uniform_buffers > 4 { panic("GFX.GPU shader supports at most 4 uniform buffers") }
}

local func validate_compute_counts(settings:ComputePipelineSettings) {
    validate_counts([
        settings.samplers, settings.read_only_storage_textures, settings.read_only_storage_buffers,
        settings.read_write_storage_textures, settings.read_write_storage_buffers,
        settings.uniform_buffers, settings.threads_x, settings.threads_y, settings.threads_z
    ])
    if settings.samplers > 16 { panic("GFX.GPU compute pipeline supports at most 16 samplers") }
    if settings.read_only_storage_textures > 8 || settings.read_only_storage_buffers > 8 ||
        settings.read_write_storage_textures > 8 || settings.read_write_storage_buffers > 8 {
        panic("GFX.GPU compute pipeline supports at most 8 storage resources of each kind")
    }
    if settings.uniform_buffers > 4 { panic("GFX.GPU compute pipeline supports at most 4 uniform buffers") }
}

local func encode_vertex_buffers(values:VertexBufferLayout[], address:uint) {
    var index = 0
    while index < values.count() {
        let offset = (index * 16) as uint
        let slot = C.store<uint32>(address, offset, values[index].slot as uint32)
        let pitch = C.store<uint32>(address, offset + 4, values[index].pitch as uint32)
        let rate = C.store<int32>(address, offset + 8, vertex_rate(values[index].rate).raw_value as int32)
        let step = C.store<uint32>(address, offset + 12, 0)
        index++
    }
}

local func encode_attributes(values:VertexAttribute[], address:uint) {
    var index = 0
    while index < values.count() {
        let offset = (index * 16) as uint
        let location = C.store<uint32>(address, offset, values[index].location as uint32)
        let slot = C.store<uint32>(address, offset + 4, values[index].buffer_slot as uint32)
        let format = C.store<int32>(address, offset + 8, required_vertex_format(values[index].format).raw_value as int32)
        let attribute_offset = C.store<uint32>(address, offset + 12, values[index].offset as uint32)
        index++
    }
}

local func encode_targets(values:ColorTargetFormat[], address:uint) {
    var index = 0
    while index < values.count() {
        let offset = (index * 36) as uint
        let format = C.store<int32>(address, offset, required_texture_format(values[index].format).raw_value as int32)
        encode_blend(values[index].blend, address + offset + 4)
        index++
    }
}

local func encode_blend(value:BlendState, address:uint) {
    let source_color = C.store<int32>(address, 0 as uint, blend_factor(value.source_color, Types.BlendFactor.one).raw_value as int32)
    let destination_color = C.store<int32>(address, 4 as uint, blend_factor(value.destination_color, Types.BlendFactor.zero).raw_value as int32)
    let color_operation = C.store<int32>(address, 8 as uint, blend_operation(value.color_operation).raw_value as int32)
    let source_alpha = C.store<int32>(address, 12 as uint, blend_factor(value.source_alpha, Types.BlendFactor.one).raw_value as int32)
    let destination_alpha = C.store<int32>(address, 16 as uint, blend_factor(value.destination_alpha, Types.BlendFactor.zero).raw_value as int32)
    let alpha_operation = C.store<int32>(address, 20 as uint, blend_operation(value.alpha_operation).raw_value as int32)
    var mask:uint8 = 0
    if value.write_red { mask += 1 }
    if value.write_green { mask += 2 }
    if value.write_blue { mask += 4 }
    if value.write_alpha { mask += 8 }
    let write_mask = C.store<uint8>(address, 24 as uint, mask)
    let enabled = C.store<uint8>(address, 25 as uint, Types.native_bool(value.enabled) as uint8)
    let mask_enabled = C.store<uint8>(address, 26 as uint, 1)
}

local func encode_rasterizer(value:RasterizerState, address:uint) {
    let fill = C.store<int32>(address, 0 as uint, fill_mode(value.fill).raw_value as int32)
    let cull = C.store<int32>(address, 4 as uint, cull_mode(value.cull).raw_value as int32)
    let front = C.store<int32>(address, 8 as uint, front_face(value.front_face).raw_value as int32)
    let bias = C.store<float32>(address, 12 as uint, value.depth_bias as float32)
    let clamp = C.store<float32>(address, 16 as uint, value.depth_bias_clamp as float32)
    let slope = C.store<float32>(address, 20 as uint, value.depth_bias_slope as float32)
    let enabled = C.store<uint8>(address, 24 as uint, Types.native_bool(value.bias_depth) as uint8)
    let clip = C.store<uint8>(address, 25 as uint, Types.native_bool(value.clip_depth) as uint8)
}

local func encode_multisample(value:MultisampleState, address:uint) {
    let samples = C.store<int32>(address, 0 as uint, sample_count(value.samples).raw_value as int32)
    let mask = C.store<uint32>(address, 4 as uint, 0)
    let mask_enabled = C.store<uint8>(address, 8 as uint, 0)
    let coverage = C.store<uint8>(address, 9 as uint, Types.native_bool(value.alpha_to_coverage) as uint8)
}

local func encode_depth_stencil(value:DepthStencilState, address:uint) {
    let compare = C.store<int32>(address, 0 as uint, compare_mode(value.depth_compare, Types.Compare.less).raw_value as int32)
    encode_stencil(value.back, address + 4)
    encode_stencil(value.front, address + 20)
    let compare_mask = C.store<uint8>(address, 36 as uint, value.stencil_compare_mask)
    let write_mask = C.store<uint8>(address, 37 as uint, value.stencil_write_mask)
    let depth_test = C.store<uint8>(address, 38 as uint, Types.native_bool(value.depth_test) as uint8)
    let depth_write = C.store<uint8>(address, 39 as uint, Types.native_bool(value.depth_write) as uint8)
    let stencil_test = C.store<uint8>(address, 40 as uint, Types.native_bool(value.stencil_test) as uint8)
}

local func encode_stencil(value:StencilFace, address:uint) {
    let fail = C.store<int32>(address, 0 as uint, stencil_operation(value.fail).raw_value as int32)
    let pass = C.store<int32>(address, 4 as uint, stencil_operation(value.pass).raw_value as int32)
    let depth_fail = C.store<int32>(address, 8 as uint, stencil_operation(value.depth_fail).raw_value as int32)
    let compare = C.store<int32>(address, 12 as uint, compare_mode(value.compare, Types.Compare.always).raw_value as int32)
}

local func vertex_rate(value:Types.VertexRate?) Types.VertexRate {
    if let selected = value { return selected }
    return Types.VertexRate.vertex
}
local func primitive_type(value:Types.Primitive?) Types.Primitive {
    if let selected = value { return selected }
    return Types.Primitive.triangles
}
local func stencil_operation(value:Types.Stencil?) Types.Stencil {
    if let selected = value { return selected }
    return Types.Stencil.keep
}
local func compare_mode(value:Types.Compare?, fallback:Types.Compare) Types.Compare {
    if let selected = value { return selected }
    return fallback
}
local func fill_mode(value:Types.Fill?) Types.Fill {
    if let selected = value { return selected }
    return Types.Fill.solid
}
local func cull_mode(value:Types.Cull?) Types.Cull {
    if let selected = value { return selected }
    return Types.Cull.none
}
local func front_face(value:Types.FrontFace?) Types.FrontFace {
    if let selected = value { return selected }
    return Types.FrontFace.counter_clockwise
}
local func sample_count(value:Types.Samples?) Types.Samples {
    if let selected = value { return selected }
    return Types.Samples.one
}
local func blend_factor(value:Types.BlendFactor?, fallback:Types.BlendFactor) Types.BlendFactor {
    if let selected = value { return selected }
    return fallback
}
local func blend_operation(value:Types.BlendOperation?) Types.BlendOperation {
    if let selected = value { return selected }
    return Types.BlendOperation.add
}
local func required_vertex_format(value:Types.VertexFormat?) Types.VertexFormat {
    if let selected = value { return selected }
    panic("GFX.GPU vertex attribute format is required")
}
local func required_texture_format(value:Types.TextureFormat?) Types.TextureFormat {
    if let selected = value { return selected }
    panic("GFX.GPU color target format is required")
}

let sdl_create_gpu_shader = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_CreateGPUShader")
let sdl_release_gpu_shader = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_ReleaseGPUShader")
let sdl_create_gpu_graphics_pipeline = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_CreateGPUGraphicsPipeline")
let sdl_release_gpu_graphics_pipeline = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_ReleaseGPUGraphicsPipeline")
let sdl_create_gpu_compute_pipeline = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_CreateGPUComputePipeline")
let sdl_release_gpu_compute_pipeline = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_ReleaseGPUComputePipeline")
