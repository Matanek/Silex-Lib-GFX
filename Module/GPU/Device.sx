use Interop.C
use Interop.Boundary
use GFX.Window
use GFX.GPU.Types
use GFX.GPU.Properties.Properties
use GFX.GPU.Properties.property_text

public struct ShaderFormats {
    var platform_private:bool = false
    var spirv:bool = true
    var dxbc:bool = true
    var dxil:bool = true
    var msl:bool = true
    var metal_library:bool = true
}

public struct DeviceFeatures {
    var clip_distance:bool = true
    var depth_clamping:bool = true
    var indirect_first_instance:bool = true
    var anisotropy:bool = true
}

public struct D3D12DeviceSettings {
    var semantic_name:str? = null
    var allow_fewer_resource_slots:bool = false
    var agility_sdk_version:int? = null
    var agility_sdk_path:str? = null
}

public struct VulkanDeviceSettings {
    var require_hardware_acceleration:bool = false
    var api_version:uint32 = 0
    var feature_chain_address:uint = 0
    var version_1_0_features_address:uint = 0
    var device_extensions:str[]? = null
    var instance_extensions:str[]? = null
}

public struct MetalDeviceSettings {
    var allow_mac_family1:bool = false
}

public struct DeviceInfo {
    var name:str? = null
    var driver_name:str? = null
    var driver_version:str? = null
    var driver_details:str? = null
}

public struct DeviceSettings {
    var shader_formats:ShaderFormats? = null
    var debug:bool = false
    var driver:str? = null
    var prefer_low_power:bool = false
    var verbose:bool = false
    var features:DeviceFeatures = DeviceFeatures()
    var d3d12:D3D12DeviceSettings = D3D12DeviceSettings()
    var vulkan:VulkanDeviceSettings = VulkanDeviceSettings()
    var metal:MetalDeviceSettings = MetalDeviceSettings()
}

public struct SurfaceSettings {
    var present_mode:Types.PresentMode? = null
    var color_space:Types.ColorSpace? = null
}

package struct CommandStats {
    var render_passes:int
    var draw_calls:int
    var pipeline_bindings:int
    var triangles:int
    var vertices:int
    var indices:int
    var instances:int
    var uniform_bytes:int
    var texture_bindings:int
    var shadow_draw_calls:int
    var shadow_triangles:int
    var shadow_instances:int

    init() {
        self.render_passes = 0
        self.draw_calls = 0
        self.pipeline_bindings = 0
        self.triangles = 0
        self.vertices = 0
        self.indices = 0
        self.instances = 0
        self.uniform_bytes = 0
        self.texture_bindings = 0
        self.shadow_draw_calls = 0
        self.shadow_triangles = 0
        self.shadow_instances = 0
    }

    func pass_count() int { return self.render_passes }
    func draw_count() int { return self.draw_calls }
    func pipeline_count() int { return self.pipeline_bindings }
    func triangle_count() int { return self.triangles }
    func vertex_count() int { return self.vertices }
    func index_count() int { return self.indices }
    func instance_count() int { return self.instances }
    func uniforms_size() int { return self.uniform_bytes }
    func texture_count() int { return self.texture_bindings }
    func shadow_draw_count() int { return self.shadow_draw_calls }
    func shadow_triangle_count() int { return self.shadow_triangles }
    func shadow_instance_count() int { return self.shadow_instances }
}

public class Device {
    private let handle:uint
    private var current_command_stats:CommandStats
    private var current_primitive:Types.Primitive

    init(settings:DeviceSettings = DeviceSettings()) {
        let flags = shader_format_flags(settings.shader_formats)
        if flags == 0 { panic("GFX.GPU requires at least one shader format") }
        initialize_runtime()
        let handle = query_device(settings, true)
        if handle == 0 as uint {
            shutdown_runtime()
            panic("GFX.GPU could not create a device: " + gpu_error())
        }
        self.handle = handle
        self.current_command_stats = CommandStats()
        self.current_primitive = Types.Primitive.triangles
    }

    drop {
        sdl_wait_for_gpu_idle(C.pointer_bits(self.handle))
        sdl_destroy_gpu_device(C.pointer_bits(self.handle))
        shutdown_runtime()
    }

    static func is_supported(settings:DeviceSettings = DeviceSettings()) bool {
        if shader_format_flags(settings.shader_formats) == 0 { return false }
        initialize_runtime()
        let supported = query_device(settings, false) != 0 as uint
        shutdown_runtime()
        return supported
    }

    static func drivers() str[] {
        var result:str[] = []
        let count = sdl_get_num_gpu_drivers()
        var index:int32 = 0
        while index < count {
            result.append(copy_text(C.address_bits(sdl_get_gpu_driver(index))))
            index++
        }
        return result
    }

    func driver() str {
        return copy_text(C.address_bits(sdl_get_gpu_device_driver(C.pointer_bits(self.handle))))
    }

    func shader_formats() ShaderFormats {
        let flags = sdl_get_gpu_shader_formats(C.pointer_bits(self.handle))
        return ShaderFormats(
            platform_private:(flags & (1 as uint32)) != 0,
            spirv:(flags & ((1 as uint32) << 1)) != 0,
            dxbc:(flags & ((1 as uint32) << 2)) != 0,
            dxil:(flags & ((1 as uint32) << 3)) != 0,
            msl:(flags & ((1 as uint32) << 4)) != 0,
            metal_library:(flags & ((1 as uint32) << 5)) != 0
        )
    }

    func info() DeviceInfo {
        let properties = sdl_get_gpu_device_properties(C.pointer_bits(self.handle))
        if properties == 0 { panic("GFX.GPU could not inspect the device: " + gpu_error()) }
        return DeviceInfo(
            name:property_text(properties, "SDL.gpu.device.name"),
            driver_name:property_text(properties, "SDL.gpu.device.driver_name"),
            driver_version:property_text(properties, "SDL.gpu.device.driver_version"),
            driver_details:property_text(properties, "SDL.gpu.device.driver_info")
        )
    }

    func present(window:Window, settings:SurfaceSettings = SurfaceSettings()) Surface {
        return Surface(self, window, settings)
    }

    func allows_frames_in_flight(count:int) bool {
        if count < 1 || count > 3 { panic("GFX.GPU frames in flight must be between 1 and 3") }
        return sdl_set_gpu_allowed_frames_in_flight(C.pointer_bits(self.handle), count as uint32) != 0
    }

    func supports(feature:Types.TextureFormat, options:Types.TextureUsage, type:Types.TextureType = Types.TextureType.texture_2d) bool {
        return sdl_gpu_texture_supports_format(
            C.pointer_bits(self.handle),
            feature.raw_value as int32,
            type.raw_value as int32,
            Types.texture_usage_flags(options)
        ) != 0
    }

    func supports(feature:Types.TextureFormat, options:Types.Samples) bool {
        return sdl_gpu_texture_supports_sample_count(
            C.pointer_bits(self.handle),
            feature.raw_value as int32,
            options.raw_value as int32
        ) != 0
    }

    func wait_until_idle() {
        require_gpu_action(sdl_wait_for_gpu_idle(C.pointer_bits(self.handle)) != 0, "wait until idle")
    }

    func suspend() { sdl_gdk_suspend_gpu(C.pointer_bits(self.handle)) }
    func resume() { sdl_gdk_resume_gpu(C.pointer_bits(self.handle)) }

    package func reset_command_stats() {
        self.current_command_stats = CommandStats()
    }
    package func command_stats() CommandStats { return self.current_command_stats }
    module func record_render_pass() { self.current_command_stats.render_passes++ }
    module func record_pipeline_binding(primitive:Types.Primitive) {
        self.current_command_stats.pipeline_bindings++
        self.current_primitive = primitive
    }
    module func record_uniform(byte_count:int) { self.current_command_stats.uniform_bytes += byte_count }
    module func record_texture_binding() { self.current_command_stats.texture_bindings++ }
    module func record_draw(
        elements:int,
        instances:int,
        indexed:bool,
        shadow:bool
    ) {
        self.current_command_stats.draw_calls++
        self.current_command_stats.instances += instances
        if indexed { self.current_command_stats.indices += elements * instances }
        else { self.current_command_stats.vertices += elements * instances }

        var triangles = 0
        if self.current_primitive == Types.Primitive.triangles { triangles = elements / 3 }
        else if self.current_primitive == Types.Primitive.triangle_strip && elements > 2 { triangles = elements - 2 }
        self.current_command_stats.triangles += triangles * instances
        if shadow {
            self.current_command_stats.shadow_draw_calls++
            self.current_command_stats.shadow_triangles += triangles * instances
            self.current_command_stats.shadow_instances += instances
        }
    }
    module func record_indirect_draw(count:int) {
        self.current_command_stats.draw_calls += count
    }

    module func native_handle() uint { return self.handle }
}

public class Surface {
    private let device_handle:uint
    private let window_handle:uint
    private var device_owner:Device? = null
    private var window_owner:Window? = null
    private var current_present_mode:Types.PresentMode? = null
    private var current_color_space:Types.ColorSpace? = null

    module init(device:Device, window:Window, settings:SurfaceSettings) {
        let device_handle = device.native_handle()
        let window_handle = window.native_handle()
        require_gpu_action(
            sdl_claim_window_for_gpu_device(C.pointer_bits(device_handle), C.pointer_bits(window_handle)) != 0,
            "attach the device to the window"
        )
        var present_mode = Types.PresentMode.synchronized
        var color_space = Types.ColorSpace.standard
        if let configured = settings.present_mode { present_mode = configured }
        if let configured = settings.color_space { color_space = configured }
        if sdl_set_gpu_swapchain_parameters(
            C.pointer_bits(device_handle), C.pointer_bits(window_handle),
            color_space.raw_value as int32, present_mode.raw_value as int32
        ) == 0 {
            sdl_release_window_from_gpu_device(C.pointer_bits(device_handle), C.pointer_bits(window_handle))
            panic("GFX.GPU could not configure window presentation: " + gpu_error())
        }
        self.device_handle = device_handle
        self.window_handle = window_handle
        self.device_owner = device
        self.window_owner = window
        self.current_present_mode = present_mode
        self.current_color_space = color_space
    }

    drop {
        sdl_release_window_from_gpu_device(C.pointer_bits(self.device_handle), C.pointer_bits(self.window_handle))
        self.window_owner = null
        self.device_owner = null
    }

    func format() Types.TextureFormat {
        return texture_format(sdl_get_gpu_swapchain_texture_format(
            C.pointer_bits(self.device_handle), C.pointer_bits(self.window_handle)
        ))
    }

    func present_mode() Types.PresentMode { return required_present_mode(self.current_present_mode) }
    func color_space() Types.ColorSpace { return required_color_space(self.current_color_space) }
    func is_presentable() bool { return self.format() != Types.TextureFormat.invalid }

    func supports(feature:Types.PresentMode) bool {
        return sdl_window_supports_gpu_present_mode(
            C.pointer_bits(self.device_handle), C.pointer_bits(self.window_handle), feature.raw_value as int32
        ) != 0
    }

    func supports(feature:Types.ColorSpace) bool {
        return sdl_window_supports_gpu_swapchain_composition(
            C.pointer_bits(self.device_handle), C.pointer_bits(self.window_handle), feature.raw_value as int32
        ) != 0
    }

    func configure(settings:SurfaceSettings) {
        var present_mode = required_present_mode(self.current_present_mode)
        var color_space = required_color_space(self.current_color_space)
        if let configured = settings.present_mode { present_mode = configured }
        if let configured = settings.color_space { color_space = configured }
        require_gpu_action(sdl_set_gpu_swapchain_parameters(
            C.pointer_bits(self.device_handle), C.pointer_bits(self.window_handle),
            color_space.raw_value as int32, present_mode.raw_value as int32
        ) != 0, "configure window presentation")
        self.current_present_mode = present_mode
        self.current_color_space = color_space
    }

    func wait_until_ready() {
        require_gpu_action(sdl_wait_for_gpu_swapchain(
            C.pointer_bits(self.device_handle), C.pointer_bits(self.window_handle)
        ) != 0, "wait for window presentation")
    }

    module func native_window() uint { return self.window_handle }
    module func owner_handle() uint { return self.device_handle }
}

func require_gpu_action(success:bool, action:str) {
    if !success { panic("GFX.GPU could not " + action + ": " + gpu_error()) }
}

func gpu_error() str {
    return copy_text(C.address_bits(sdl_get_error()))
}

local func shader_format_flags(configured:ShaderFormats?) uint32 {
    var result:uint32 = 62
    if let formats = configured {
        result = 0
        if formats.platform_private { result += 1 as uint32 }
        if formats.spirv { result += (1 as uint32) << 1 }
        if formats.dxbc { result += (1 as uint32) << 2 }
        if formats.dxil { result += (1 as uint32) << 3 }
        if formats.msl { result += (1 as uint32) << 4 }
        if formats.metal_library { result += (1 as uint32) << 5 }
    }
    return result
}

local func configure_device(properties:@Properties, settings:DeviceSettings) {
    let formats = resolved_shader_formats(settings.shader_formats)
    properties.boolean("SDL.gpu.device.create.debugmode", settings.debug)
    properties.boolean("SDL.gpu.device.create.preferlowpower", settings.prefer_low_power)
    properties.boolean("SDL.gpu.device.create.verbose", settings.verbose)
    properties.boolean("SDL.gpu.device.create.shaders.private", formats.platform_private)
    properties.boolean("SDL.gpu.device.create.shaders.spirv", formats.spirv)
    properties.boolean("SDL.gpu.device.create.shaders.dxbc", formats.dxbc)
    properties.boolean("SDL.gpu.device.create.shaders.dxil", formats.dxil)
    properties.boolean("SDL.gpu.device.create.shaders.msl", formats.msl)
    properties.boolean("SDL.gpu.device.create.shaders.metallib", formats.metal_library)
    properties.boolean("SDL.gpu.device.create.feature.clip_distance", settings.features.clip_distance)
    properties.boolean("SDL.gpu.device.create.feature.depth_clamping", settings.features.depth_clamping)
    properties.boolean("SDL.gpu.device.create.feature.indirect_draw_first_instance", settings.features.indirect_first_instance)
    properties.boolean("SDL.gpu.device.create.feature.anisotropy", settings.features.anisotropy)
    properties.boolean("SDL.gpu.device.create.d3d12.allowtier1resourcebinding", settings.d3d12.allow_fewer_resource_slots)
    properties.boolean("SDL.gpu.device.create.vulkan.requirehardwareacceleration", settings.vulkan.require_hardware_acceleration)
    properties.boolean("SDL.gpu.device.create.metal.allowmacfamily1", settings.metal.allow_mac_family1)
    if let driver = settings.driver { properties.text("SDL.gpu.device.create.name", driver) }
    if let semantic = settings.d3d12.semantic_name { properties.text("SDL.gpu.device.create.d3d12.semantic", semantic) }
    if let version = settings.d3d12.agility_sdk_version { properties.number("SDL.gpu.device.create.d3d12.agility_sdk_version", version) }
    if let path = settings.d3d12.agility_sdk_path { properties.text("SDL.gpu.device.create.d3d12.agility_sdk_path", path) }
}

local func query_device(settings:DeviceSettings, create:bool) uint {
    var properties = Properties()
    configure_device(properties, settings)
    var device_extensions:uint[64]
    var instance_extensions:uint[64]
    var device_count = 0
    var instance_count = 0
    if let names = settings.vulkan.device_extensions {
        if names.count() > 64 { panic("GFX.GPU Vulkan settings support at most 64 device extensions") }
        for name in names {
            device_extensions[device_count] = C.address_bits(C.terminated_pointer(name))
            device_count++
        }
    }
    if let names = settings.vulkan.instance_extensions {
        if names.count() > 64 { panic("GFX.GPU Vulkan settings support at most 64 instance extensions") }
        for name in names {
            instance_extensions[instance_count] = C.address_bits(C.terminated_pointer(name))
            instance_count++
        }
    }
    if settings.vulkan.api_version != 0 || settings.vulkan.feature_chain_address != 0 as uint ||
        settings.vulkan.version_1_0_features_address != 0 as uint || device_count != 0 || instance_count != 0 {
        if settings.vulkan.api_version == 0 { panic("GFX.GPU Vulkan options require an API version") }
        var options:uint[7]
        let address = C.address_bits(C.mutable_pointer(options))
        let version = C.store<uint32>(address, 0 as uint, settings.vulkan.api_version)
        let feature_chain = C.store<uint>(address, 8 as uint, settings.vulkan.feature_chain_address)
        let version_1_0 = C.store<uint>(address, 16 as uint, settings.vulkan.version_1_0_features_address)
        let stored_device_count = C.store<uint32>(address, 24 as uint, device_count as uint32)
        var device_names:uint = 0
        if device_count != 0 { device_names = C.address_bits(C.mutable_pointer(device_extensions)) }
        let stored_device_names = C.store<uint>(address, 32 as uint, device_names)
        let stored_instance_count = C.store<uint32>(address, 40 as uint, instance_count as uint32)
        var instance_names:uint = 0
        if instance_count != 0 { instance_names = C.address_bits(C.mutable_pointer(instance_extensions)) }
        let stored_instance_names = C.store<uint>(address, 48 as uint, instance_names)
        properties.pointer("SDL.gpu.device.create.vulkan.options", address)
        if create { return C.address_bits(sdl_create_gpu_device_with_properties(properties.native_handle())) }
        if sdl_gpu_supports_properties(properties.native_handle()) != 0 { return 1 as uint }
        return 0 as uint
    }
    if create { return C.address_bits(sdl_create_gpu_device_with_properties(properties.native_handle())) }
    if sdl_gpu_supports_properties(properties.native_handle()) != 0 { return 1 as uint }
    return 0 as uint
}

local func resolved_shader_formats(configured:ShaderFormats?) ShaderFormats {
    if let formats = configured { return formats }
    return ShaderFormats()
}

local func required_present_mode(value:Types.PresentMode?) Types.PresentMode {
    if let selected = value { return selected }
    panic("GFX.GPU surface has no presentation mode")
}

local func required_color_space(value:Types.ColorSpace?) Types.ColorSpace {
    if let selected = value { return selected }
    panic("GFX.GPU surface has no color space")
}

func texture_format(value:int32) Types.TextureFormat {
    if value == 4 { return Types.TextureFormat.rgba8_unorm }
    if value == 8 { return Types.TextureFormat.rgb10a2_unorm }
    if value == 12 { return Types.TextureFormat.bgra8_unorm }
    if value == 29 { return Types.TextureFormat.rgba16_float }
    if value == 52 { return Types.TextureFormat.rgba8_srgb }
    if value == 53 { return Types.TextureFormat.bgra8_srgb }
    return Types.TextureFormat.invalid
}

local func copy_text(address:uint) str {
    if address == 0 as uint { return "unknown platform value" }
    var bytes:uint8[] = []
    var index = 0
    while index < 4096 {
        let byte = C.load<uint8>(address, index as uint)
        if byte == 0 { return C.string(@bytes[0:bytes.count()]) }
        bytes.append(byte)
        index++
    }
    return "invalid platform value"
}

let sdl_gpu_supports_shader_formats = C.function<func(uint32, C.Pointer<uint8>) int32>(library:Boundary.SDL3, name:"SDL_GPUSupportsShaderFormats")
let sdl_create_gpu_device = C.function<func(uint32, int32, C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_CreateGPUDevice")
let sdl_gpu_supports_properties = C.function<func(uint32) int32>(library:Boundary.SDL3, name:"SDL_GPUSupportsProperties")
let sdl_create_gpu_device_with_properties = C.function<func(uint32) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_CreateGPUDeviceWithProperties")
let sdl_destroy_gpu_device = C.function<func(C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_DestroyGPUDevice")
let sdl_get_num_gpu_drivers = C.function<func() int32>(library:Boundary.SDL3, name:"SDL_GetNumGPUDrivers")
let sdl_get_gpu_driver = C.function<func(int32) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_GetGPUDriver")
let sdl_get_gpu_device_driver = C.function<func(C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_GetGPUDeviceDriver")
let sdl_get_gpu_shader_formats = C.function<func(C.Pointer<uint8>) uint32>(library:Boundary.SDL3, name:"SDL_GetGPUShaderFormats")
let sdl_get_gpu_device_properties = C.function<func(C.Pointer<uint8>) uint32>(library:Boundary.SDL3, name:"SDL_GetGPUDeviceProperties")
let sdl_wait_for_gpu_idle = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.SDL3, name:"SDL_WaitForGPUIdle")
let sdl_claim_window_for_gpu_device = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) int32>(library:Boundary.SDL3, name:"SDL_ClaimWindowForGPUDevice")
let sdl_release_window_from_gpu_device = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_ReleaseWindowFromGPUDevice")
let sdl_set_gpu_swapchain_parameters = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>, int32, int32) int32>(library:Boundary.SDL3, name:"SDL_SetGPUSwapchainParameters")
let sdl_set_gpu_allowed_frames_in_flight = C.function<func(C.Pointer<uint8>, uint32) int32>(library:Boundary.SDL3, name:"SDL_SetGPUAllowedFramesInFlight")
let sdl_get_gpu_swapchain_texture_format = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) int32>(library:Boundary.SDL3, name:"SDL_GetGPUSwapchainTextureFormat")
let sdl_wait_for_gpu_swapchain = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) int32>(library:Boundary.SDL3, name:"SDL_WaitForGPUSwapchain")
let sdl_window_supports_gpu_present_mode = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>, int32) int32>(library:Boundary.SDL3, name:"SDL_WindowSupportsGPUPresentMode")
let sdl_window_supports_gpu_swapchain_composition = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>, int32) int32>(library:Boundary.SDL3, name:"SDL_WindowSupportsGPUSwapchainComposition")
let sdl_gpu_texture_supports_format = C.function<func(C.Pointer<uint8>, int32, int32, uint32) int32>(library:Boundary.SDL3, name:"SDL_GPUTextureSupportsFormat")
let sdl_gpu_texture_supports_sample_count = C.function<func(C.Pointer<uint8>, int32, int32) int32>(library:Boundary.SDL3, name:"SDL_GPUTextureSupportsSampleCount")
let sdl_gdk_suspend_gpu = C.function<func(C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_GDKSuspendGPU")
let sdl_gdk_resume_gpu = C.function<func(C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_GDKResumeGPU")
let sdl_get_error = C.function<func() C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_GetError")

func initialize_runtime() {
    if sdl_init_subsystem(0x0000_4020 as uint32) == 0 {
        panic("GFX.GPU could not initialize the SDL platform subsystems")
    }
}

func shutdown_runtime() { sdl_quit_subsystem(0x0000_4020 as uint32) }

let sdl_init_subsystem = C.function<func(uint32) int32>(library:Boundary.SDL3, name:"SDL_InitSubSystem")
let sdl_quit_subsystem = C.function<func(uint32) void>(library:Boundary.SDL3, name:"SDL_QuitSubSystem")
