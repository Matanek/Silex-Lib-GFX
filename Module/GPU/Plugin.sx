use GFX.Application.Plugin as PluginProtocol
use GFX.Application
use GFX.Application.Schedule
use Interop.C
use Interop.Boundary
use GFX.GPU as GPUApi
use GFX.GPU.Commands
use GFX.Color
use GFX.Window

public struct Settings {
    var device:GPUApi.DeviceSettings? = null
    var surface:GPUApi.SurfaceSettings? = null
    var present_on_start:bool = true
    var frame_interval_ms:int = 0
}

struct Configuration {
    let device:GPUApi.DeviceSettings
    let surface:GPUApi.SurfaceSettings
}

struct FramePacing {
    let milliseconds:uint32

    func wait() { sdl_delay(self.milliseconds) }
}

public struct Plugin:PluginProtocol {
    private let settings:Settings

    public init(settings:Settings = Settings()) {
        self.settings = settings
    }

    func id() str { return "GFX.GPU.Plugin" }

    func build(application:Application) {
        var device = GPUApi.DeviceSettings()
        var surface = GPUApi.SurfaceSettings()
        if let configured_device = self.settings.device { device = configured_device }
        if let configured_surface = self.settings.surface { surface = configured_surface }
        if !application.has_plugin("GFX.Window.Plugin") {
            panic("GFX.GPU.Plugin requires GFX.Window.Plugin to be added first")
        }
        application.resources().insert(Configuration(
            device:device,
            surface:surface
        ))
        application.add_system(Schedule.startup, start_gpu)
        if self.settings.present_on_start {
            application.add_system(Schedule.startup, present_window)
        }
        if self.settings.frame_interval_ms < 0 || self.settings.frame_interval_ms > 1000 {
            panic("GFX.GPU.Plugin frame interval must be between 0 and 1000 milliseconds")
        }
        if self.settings.frame_interval_ms > 0 {
            application.resources().insert(FramePacing(milliseconds:self.settings.frame_interval_ms as uint32))
            application.add_after_system(Schedule.render, pace_frame)
        }
        application.add_system(Schedule.shutdown, stop_gpu)
    }
}

func start_gpu(application:Application) {
    var resources = application.resources()
    let configuration = resources.remove<Configuration>()
    if let settings = configuration {
        var stored_window = resources.remove<Window>()
        if var window = stored_window {
            var device = GPUApi.Device(settings.device)
            var surface = device.present(window, settings.surface)
            resources.insert(window)
            resources.insert(device)
            resources.insert(surface)
            return
        }
        panic("GFX.GPU.Plugin requires a window")
    }
    panic("GFX.GPU.Plugin has no GPU settings")
}

func present_window(device:@GPUApi.Device, surface:@GPUApi.Surface) {
    var commands = device.commands()
    commands.clear(surface, Color.black())
    commands.submit()
}

func pace_frame(pacing:@FramePacing) {
    pacing.wait()
}

func stop_gpu(application:Application) {
    var resources = application.resources()
    var removed_surface = resources.remove<GPUApi.Surface>()
    assert(removed_surface != null)
    var removed_device = resources.remove<GPUApi.Device>()
    assert(removed_device != null)
    var pacing = resources.remove<FramePacing>()
}

let sdl_delay = C.function<func(uint32) void>(library:Boundary.SDL3, name:"SDL_Delay")
