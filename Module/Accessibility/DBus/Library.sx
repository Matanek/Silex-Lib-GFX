use GFX.Accessibility.BusValue.Value
use GFX.Accessibility.BusValue.Reply
use GFX.Accessibility.DBus.Codec.Codec
use GFX.Accessibility.DBus.Codec.read_string
use STD.Collections.Dictionary
use Interop.C
use Interop.Boundary

// A private optional runtime dependency, not a link-time GTK/GLib dependency.
// SDL_LoadObject does not initialize video. The owner joins its I/O worker
// before releasing this object or closing a connection.
package nocopy class Library {
    private var handle:uint
    private var symbols:Dictionary<str,uint> = Dictionary<str,uint>()
    private var codec:Codec
    init(name:str = "libdbus-1.so.3") {
        self.handle = load_object(C.terminated_pointer(name))
        let names:str[] = ["dbus_threads_init_default","dbus_bus_get_private","dbus_bus_register","dbus_bus_get_unique_name",
            "dbus_connection_open_private","dbus_connection_set_exit_on_disconnect","dbus_connection_close","dbus_connection_unref",
            "dbus_connection_send","dbus_connection_send_with_reply_and_block","dbus_connection_read_write",
            "dbus_connection_get_dispatch_status","dbus_connection_pop_message","dbus_message_new_method_call",
            "dbus_message_new_method_return","dbus_message_new_error","dbus_message_new_signal","dbus_message_unref","dbus_message_get_type",
            "dbus_message_get_path","dbus_message_get_interface","dbus_message_get_member","dbus_message_get_reply_serial",
            "dbus_message_get_no_reply","dbus_message_set_no_reply","dbus_message_iter_init","dbus_message_iter_init_append",
            "dbus_message_iter_get_arg_type","dbus_message_iter_get_signature","dbus_message_iter_get_basic",
            "dbus_message_iter_next","dbus_message_iter_recurse","dbus_message_iter_append_basic",
            "dbus_message_iter_open_container","dbus_message_iter_close_container","dbus_message_iter_abandon_container","dbus_free"]
        var complete = self.handle != 0
        if complete {
            for symbol_name in names {
                let address = load_function(self.handle,C.terminated_pointer(symbol_name))
                self.symbols.set(symbol_name,address)
                if address == 0 { complete = false }
            }
        }
        if !complete && self.handle != 0 { unload_object(self.handle); self.handle = 0; self.symbols.clear() }
        let native_handle = self.handle
        self.codec = Codec(func(symbol_name:str) uint {
            if native_handle == 0 { return 0 as uint }
            return load_function(native_handle,C.terminated_pointer(symbol_name))
        })
    }
    func available() bool { return self.handle != 0 && self.codec.available() }
    func encode(message:uint, values:Value[]) bool { return self.codec.encode(message,values) }
    func decode(message:uint) Value[]? { return self.codec.decode(message) }
    func symbol(name:str) uint { return self.symbols.find(name) ?? 0 as uint }
    func method(destination:str, path:str, interface:str, name:str) uint {
        return C.call<func(C.Pointer<uint8>,C.Pointer<uint8>,C.Pointer<uint8>,C.Pointer<uint8>) uint>(self.symbol("dbus_message_new_method_call"),
            C.terminated_pointer(destination),C.terminated_pointer(path),C.terminated_pointer(interface),C.terminated_pointer(name))
    }
    func release(message:uint) { if message != 0 { C.call<func(uint) void>(self.symbol("dbus_message_unref"),message) } }
    func close(connection:uint) {
        if connection == 0 { return }
        C.call<func(uint) void>(self.symbol("dbus_connection_close"),connection)
        C.call<func(uint) void>(self.symbol("dbus_connection_unref"),connection)
    }
    func open() uint {
        if !self.available() { return 0 as uint }
        if C.call<func() uint32>(self.symbol("dbus_threads_init_default")) == 0 { return 0 as uint }
        let session = C.call<func(int32,uint) uint>(self.symbol("dbus_bus_get_private"),0,0 as uint)
        if session == 0 { return 0 as uint }
        C.call<func(uint,uint32) void>(self.symbol("dbus_connection_set_exit_on_disconnect"),session,0 as uint32)
        let request = self.method("org.a11y.Bus","/org/a11y/bus","org.a11y.Bus","GetAddress")
        var answer = 0 as uint
        if request != 0 {
            answer = C.call<func(uint,uint,int32,uint) uint>(self.symbol("dbus_connection_send_with_reply_and_block"),session,request,1000,0 as uint)
            self.release(request)
        }
        var address = ""
        if answer != 0 && self.type(answer) == 2 {
            if var values = self.codec.decode(answer) {
                if values.count() == 1 && values[0].signature == "s" { address = values[0].string_value }
            }
        }
        self.release(answer); self.close(session)
        if address == "" { return 0 as uint }
        let connection = C.call<func(C.Pointer<uint8>,uint) uint>(self.symbol("dbus_connection_open_private"),C.terminated_pointer(address),0 as uint)
        if connection == 0 { return 0 as uint }
        C.call<func(uint,uint32) void>(self.symbol("dbus_connection_set_exit_on_disconnect"),connection,0 as uint32)
        if C.call<func(uint,uint) uint32>(self.symbol("dbus_bus_register"),connection,0 as uint) == 0 { self.close(connection); return 0 as uint }
        return connection
    }
    func unique_name(connection:uint) str { return read_string(C.call<func(uint) uint>(self.symbol("dbus_bus_get_unique_name"),connection)) }
    func type(message:uint) int32 { return C.call<func(uint) int32>(self.symbol("dbus_message_get_type"),message) }
    func path(message:uint) str { return read_string(C.call<func(uint) uint>(self.symbol("dbus_message_get_path"),message)) }
    func interface(message:uint) str { return read_string(C.call<func(uint) uint>(self.symbol("dbus_message_get_interface"),message)) }
    func member(message:uint) str { return read_string(C.call<func(uint) uint>(self.symbol("dbus_message_get_member"),message)) }
    func reply_serial(message:uint) uint32 { return C.call<func(uint) uint32>(self.symbol("dbus_message_get_reply_serial"),message) }
    func pop(connection:uint) uint { return C.call<func(uint) uint>(self.symbol("dbus_connection_pop_message"),connection) }
    func send(connection:uint, message:uint) uint32 {
        var serial:uint32 = 0
        let success = C.call<func(uint,uint,C.MutablePointer<uint32>) uint32>(self.symbol("dbus_connection_send"),connection,message,C.mutable_pointer(serial))
        if success == 0 { return 0 as uint32 }
        return serial
    }
    func new_signal(path:str, interface:str, name:str) uint {
        return C.call<func(C.Pointer<uint8>,C.Pointer<uint8>,C.Pointer<uint8>) uint>(self.symbol("dbus_message_new_signal"),C.terminated_pointer(path),C.terminated_pointer(interface),C.terminated_pointer(name))
    }
    func signal(connection:uint, path:str, interface:str, name:str, values:Value[]) bool {
        let message = self.new_signal(path,interface,name)
        if message == 0 { return false }
        var success = self.codec.encode(message,values)
        if success { success = self.send(connection,message) != 0 as uint32 }
        self.release(message); return success
    }
    func reply(connection:uint, message:uint, result:Reply) {
        if C.call<func(uint) uint32>(self.symbol("dbus_message_get_no_reply"),message) != 0 { return }
        var response = 0 as uint
        if let error = result.error {
            response = C.call<func(uint,C.Pointer<uint8>,C.Pointer<uint8>) uint>(self.symbol("dbus_message_new_error"),message,C.terminated_pointer(error),C.terminated_pointer(result.detail))
        } else {
            response = C.call<func(uint) uint>(self.symbol("dbus_message_new_method_return"),message)
            if response != 0 && !self.codec.encode(response,result.values) {
                self.release(response)
                response = C.call<func(uint,C.Pointer<uint8>,C.Pointer<uint8>) uint>(self.symbol("dbus_message_new_error"),message,
                    C.terminated_pointer("org.freedesktop.DBus.Error.Failed"),C.terminated_pointer("Cannot encode accessibility response"))
            }
        }
        if response != 0 { let serial = self.send(connection,response); self.release(response) }
    }
    drop { if self.handle != 0 { unload_object(self.handle) } }
}

let load_object = C.function<func(C.Pointer<uint8>) uint>(library:Boundary.SDL3,name:"SDL_LoadObject")
let load_function = C.function<func(uint,C.Pointer<uint8>) uint>(library:Boundary.SDL3,name:"SDL_LoadFunction")
let unload_object = C.function<func(uint) void>(library:Boundary.SDL3,name:"SDL_UnloadObject")
