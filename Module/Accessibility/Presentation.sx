use GFX.Accessibility
use STD.Math

// Package-private lifetime boundary shared by Window and its selected adapter.
package nocopy class Presentation {
    private var host:Platform.Host
    init(source:Accessibility.Source, view:uint, window:uint, height:float, flipped:bool, origin:Math.Vec2 = Math.Vec2()) {
        self.host = Platform.Host(source, view, window, height, flipped, origin)
    }
    static func for_window(source:Accessibility.Source, window:uint, height:float, origin:Math.Vec2 = Math.Vec2()) Presentation {
        let view = Platform.view(window)
        return Presentation(source, view, window, height, Platform.flipped(view), origin)
    }
    func synchronize(height:float, origin:Math.Vec2? = null) bool { return self.host.synchronize(height, origin) }
    func remove() { self.host.remove() }
    package func root_handle() uint { return self.host.root_handle() }
    package func peer_count() int { return self.host.peer_count() }
}
