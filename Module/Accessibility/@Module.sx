// Platform-neutral descriptions for accessibility providers. Native adapters
// remain private to GFX; a source is read and acted on its owning UI thread.
public enum Role {
    group
    text
    button
    checkbox
    radio
    radio_group
    text_field
    text_area
    slider
    scrollbar
    scroll_view
    list
    list_item
    tree
    tree_item
    table
    row
    column_header
    column
    cell
    tab_group
    tab
    menu
    menu_item
    combo_box
    dialog
    tooltip
    image
    progress
    separator
}

public enum Action {
    activate
    focus
    set_value
    select
    deselect
    expand
    collapse
    increment
    decrement
    reveal
    dismiss
    scroll_forward
    scroll_backward
    set_text_selection
}

public struct Request {
    let action:Action
    let text:str?
    let number:float?
    // Text selection indices count complete Unicode graphemes.
    let anchor:int
    let cursor:int
    init(action:Action, text:str? = null, number:float? = null, anchor:int = 0, cursor:int = 0) {
        self.action = action; self.text = text; self.number = number
        self.anchor = anchor; self.cursor = cursor
    }
}

public struct Bounds {
    let x:float
    let y:float
    let width:float
    let height:float
    init(x:float = 0.0, y:float = 0.0, width:float = 0.0, height:float = 0.0) {
        self.x = x; self.y = y; self.width = width; self.height = height
    }
}

// IDs are opaque source-scoped values. Providers must not decode or manufacture
// them. Queries can describe logical items which have no mounted visual view.
public struct Element {
    let id:str
    let parent:str? = null
    let role:Role = Role.group
    let name:str = ""
    let description:str = ""
    let value:str? = null
    let number:float? = null
    let minimum:float? = null
    let maximum:float? = null
    let enabled:bool = true
    let focusable:bool = false
    let focused:bool = false
    let checked:bool? = null
    let selected:bool? = null
    let expanded:bool? = null
    let editable:bool = false
    let multiline:bool = false
    let horizontal:bool = false
    let selection_anchor:int? = null
    let selection_cursor:int? = null
    let invalid:bool = false
    let offscreen:bool = false
    let bounds:Bounds = Bounds()
    let child_count:int = 0
    let index:int = 0
    let level:int = 0
    let row_index:int? = null
    let column_index:int? = null
    let row_count:int? = null
    let column_count:int? = null
    let header:str? = null
    let labelled_by:str? = null
    let labels:str? = null
    let sorted_descending:bool? = null
    let shortcut:str? = null
    let actions:Action[] = []
    let multiple_selection:bool = false
}

public enum ChangeKind { structure; name; value; relations; state; selection; focus; bounds; removed }
public struct Change {
    let id:str
    let kind:ChangeKind
    init(id:str, kind:ChangeKind) { self.id = id; self.kind = kind }
}

// A live row view has model order, independently of visual wrappers or tree
// parentage. Reading its size must not enumerate or construct its rows.
public protocol Rows {
    func count() int
    func row(index:int) str?
    func selected() str[] { return [] }
}

// Column identities and their header relation are independent of row order.
// Like Rows, this view is live and only realizes a requested identity.
public protocol Columns {
    func count() int
    func column(index:int) str?
}

// Text indices count graphemes, like Request's selection. Geometry uses the
// same top-left coordinates as Element.bounds, is live and queried on demand.
public struct TextRange {
    let start:int
    let length:int
    init(start:int, length:int) { self.start = start; self.length = length }
}
public protocol TextGeometry {
    func bounds(selection:TextRange) Bounds?
    func range_at(x:float, y:float) TextRange?
    func line_for_index(index:int) int?
    func range_for_line(line:int) TextRange?
    func visible_range() TextRange?
}

// Children are requested by index, never returned as an eagerly built tree.
// Invalid/stale IDs and unsupported actions return null/false.
public protocol Source {
    func root() str?
    func focused() str?
    func read(id:str) Element?
    func child(id:str, index:int) str?
    func rows(id:str) Rows? { return null }
    func columns(id:str) Columns? { return null }
    func text_geometry(id:str) TextGeometry? { return null }
    func perform(id:str, request:Request) bool
    func changes() Change[]
    // A semantic query, including disabled/static elements, in the same
    // coordinates as bounds. A producer can use its retained visible layout.
    func element_at(x:float, y:float) str? { return null }
}

package struct EmptySource:Source {
    func root() str? { return null }
    func focused() str? { return null }
    func read(id:str) Element? { return null }
    func child(id:str, index:int) str? { return null }
    func perform(id:str, request:Request) bool { return false }
    func changes() Change[] { return [] }
}
