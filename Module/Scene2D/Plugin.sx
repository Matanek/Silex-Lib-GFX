use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.Assets
use GFX.ECS
use GFX.GPU
use GFX.Rendering
use GFX.Scene2D.Renderer
use GFX.Window

public struct Plugin:PluginProtocol {
    func id() str { return "GFX.Scene2D.Plugin" }

    func build(application:Application) {
        application.add_plugin(ECS.Plugin())
        application.add_plugin(Assets.Plugin())
        application.add_plugin(Rendering.Plugin())
        {
            var resources = application.resources()
            resources.insert(Renderer())
            var renderer = resources.get_mut<Rendering.Renderer>()
            renderer.add_pass("GFX.Scene2D", render_scene)
        }
        application.add_system(Schedule.startup, start_scene)
        application.add_system(Schedule.render, prepare_scene)
        application.add_system(Schedule.shutdown, stop_scene)
    }
}

func start_scene(device:@GPU.Device, surface:@GPU.Surface, renderer:&Renderer) {
    renderer.start(device, surface)
}

func prepare_scene(
    device:@GPU.Device,
    world:@ECS.World,
    window:@Window,
    images:@Assets.Images,
    renderer:&Renderer
) {
    renderer.prepare(device, world, window, images)
}

func render_scene(pass:@GPU.RenderPass, application:@Application) {
    var renderer = application.resources().get<Renderer>()
    renderer.draw(pass)
}

func stop_scene(application:Application) {
    var removed = application.resources().remove<Renderer>()
    assert(removed != null)
}
