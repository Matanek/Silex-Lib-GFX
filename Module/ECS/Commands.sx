use GFX.ECS.Entity.Entity
use GFX.ECS.EntityRecipe.EntityRecipe
use GFX.ECS.World.World
use Interop.C

protocol StructuralCommand {
    func apply(world:&World)
}

// Keeps the erased command family concrete even in programs that only use
// spawn/destroy. Generic insert/remove implementations are added on demand.
struct EmptyStructuralCommand:StructuralCommand {
    func apply(world:&World) {}
}

enum Command {
    spawn(EntityRecipe)
    destroy(Entity)
    structural(StructuralCommand)
}

struct CommandEntry {
    let system_order:int
    let interval_order:int
    let sequence:int
    var command:Command
}

struct InsertCommand<T>:StructuralCommand {
    private let entity:Entity
    private var component:T?

    init(entity:Entity, component:T) {
        self.entity = entity
        self.component = component
    }

    func apply(world:&World) {
        if !world.is_alive(self.entity) { return }
        var pending = self.component
        self.component = null
        if var component = pending {
            world.insert(self.entity, move component)
            return
        }
        panic("GFX.ECS insert command was already applied")
    }
}

struct RemoveCommand<T>:StructuralCommand {
    private let entity:Entity

    init(entity:Entity) { self.entity = entity }

    func apply(world:&World) {
        if world.is_alive(self.entity) { world.remove<T>(self.entity) }
    }
}

public class Commands {
    private var pending:CommandEntry[]
    private var parent_address:uint
    private var system_order:int
    private var interval_order:int
    private var next_sequence:int

    module init() {
        self.pending = []
        self.parent_address = 0
        self.system_order = -1
        self.interval_order = 0
        self.next_sequence = 0
    }

    module init(parent_address:uint, system_order:int, interval_order:int) {
        self.pending = []
        self.parent_address = parent_address
        self.system_order = system_order
        self.interval_order = interval_order
        self.next_sequence = 0
    }

    module func __silex_address() uint { return C.object_address(self) }

    module static func __silex_writer(parent_address:uint, system_order:int, interval_order:int) Commands {
        return Commands(parent_address, system_order, interval_order)
    }

    module func __silex_finish() {
        if self.parent_address == 0 { return }
        var root = C.object_from_address<Commands>(self.parent_address)
        var entries = self.pending
        self.pending = []
        root.accept(entries)
    }

    func spawn(recipe:EntityRecipe) {
        self.append(Command.spawn(recipe))
    }

    func destroy(entity:Entity) {
        self.append(Command.destroy(entity))
    }

    func insert<T>(entity:Entity, component:T) {
        self.append(Command.structural(InsertCommand<T>(entity, component)))
    }

    func remove<T>(entity:Entity) {
        self.append(Command.structural(RemoveCommand<T>(entity)))
    }

    module func flush(world:&World) {
        if self.parent_address != 0 {
            var root = C.object_from_address<Commands>(self.parent_address)
            root.flush(world)
            return
        }
        var commands = self.pending
        self.pending = []
        sort_commands(commands)
        for var entry in commands {
            match entry.command {
                spawn(recipe) => { world.spawn(recipe) }
                destroy(entity) => { if world.is_alive(entity) { world.destroy(entity) } }
                structural(var change) => { change.apply(world) }
            }
        }
    }

    private func append(command:Command) {
        self.pending.append(CommandEntry(
            system_order:self.system_order,
            interval_order:self.interval_order,
            sequence:self.next_sequence,
            command:command
        ))
        self.next_sequence++
    }

    private func accept(entries:CommandEntry[]) {
        mutex {
            var pending = self.pending
            var incoming = entries
            for var entry in incoming { pending.append(entry) }
            self.pending = pending
        }
    }
}

func sort_commands(commands:&CommandEntry[]) {
    var right = 1
    while right < commands.count() {
        var left = right
        while left > 0 && command_after(commands[left - 1], commands[left]) {
            commands.swap(left - 1, left)
            left--
        }
        right++
    }
}

func command_after(left:@CommandEntry, right:@CommandEntry) bool {
    if left.system_order != right.system_order { return left.system_order > right.system_order }
    if left.interval_order != right.interval_order { return left.interval_order > right.interval_order }
    return left.sequence > right.sequence
}
