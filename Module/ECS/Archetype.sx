use GFX.ECS.Entity.Entity

class Archetype {
    private let signature:int[]
    private var members:Entity[]

    init(signature:int[]) {
        self.signature = signature
        self.members = []
    }

    func is_exact(signature:@int[]) bool {
        if self.signature.count() != signature.count() { return false }
        var index = 0
        while index < signature.count() {
            if self.signature[index] != signature[index] { return false }
            index++
        }
        return true
    }

    func matches(required:@int[]) bool {
        for expected in required {
            var present = false
            for available in self.signature {
                if available == expected { present = true }
            }
            if !present { return false }
        }
        return true
    }

    func has(component:int) bool {
        for available in self.signature {
            if available == component { return true }
        }
        return false
    }

    func components() int[] { return self.signature }
    func count() int { return self.members.count() }
    func entity(index:int) Entity { return self.members[index] }

    func append(entity:Entity) int {
        self.members.append(entity)
        return self.members.count() - 1
    }

    func remove(index:int) Entity? {
        let last = self.members.count() - 1
        if index == last {
            self.members.take_last()
            return null
        }
        let moved = self.members[last]
        self.members[index] = moved
        self.members.take_last()
        return moved
    }
}
