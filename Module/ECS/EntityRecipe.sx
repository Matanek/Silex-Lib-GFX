use GFX.ECS.ComponentStore.ComponentStore
use GFX.ECS.Entity.Entity

internal protocol ComponentValue {
    func apply(store:&ComponentStore, entity:Entity) int
}

// Keeps the erased component family concrete in programs that construct a
// World but never add a component. Real values always use TypedComponentValue.
internal struct EmptyComponentValue:ComponentValue {
    func apply(store:&ComponentStore, entity:Entity) int { return -1 }
}

internal struct TypedComponentValue<T>:ComponentValue {
    private var value:T?

    internal init(value:T) { self.value = value }

    func apply(store:&ComponentStore, entity:Entity) int {
        var component = self.value
        self.value = null
        if var present = component { return store.insert(entity, move present) }
        panic("GFX.ECS component value was already consumed")
    }
}

public class EntityRecipe {
    private var spawned:bool
    private var components:ComponentValue[]

    public init() {
        self.spawned = false
        self.components = []
    }

    public func with<T>(component:T) EntityRecipe {
        if self.spawned {
            panic("GFX.ECS cannot change an entity recipe after it was spawned")
        }
        self.components.append(TypedComponentValue<T>(component))
        return self
    }

    internal func take_components() ComponentValue[] {
        if self.spawned {
            panic("GFX.ECS entity recipe was already spawned")
        }
        self.spawned = true
        var components = self.components
        self.components = []
        return components
    }
}
