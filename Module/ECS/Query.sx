use GFX.ECS.World.World

// Public opaque, compiler-derived system capability. Systems name Query in
// their parameters and iterate it, while ECS owns its construction and state.
// Pattern is a tuple whose fields carry read (`@`) or mutable (`&`) access.
public class Query<Pattern> {
    module var world:World
    module let range_start:int
    module let range_end:int

    module init(world:World) {
        self.world = world
        self.range_start = 0
        self.range_end = -1
    }

    module init(world:World, range_start:int, range_end:int) {
        self.world = world
        self.range_start = range_start
        self.range_end = range_end
    }
}
