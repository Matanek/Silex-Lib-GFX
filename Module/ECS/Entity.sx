public struct Entity {
    public let index:int
    public let generation:int

    public init() {
        self.index = -1
        self.generation = 0
    }

    internal init(index:int, generation:int) {
        self.index = index
        self.generation = generation
    }

    public func is_valid() bool {
        return self.index >= 0 && self.generation > 0
    }
}
