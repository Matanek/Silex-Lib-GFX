public struct Entity {
    let index:int
    let generation:int

    init() {
        self.index = -1
        self.generation = 0
    }

    module init(index:int, generation:int) {
        self.index = index
        self.generation = generation
    }

    func is_valid() bool {
        return self.index >= 0 && self.generation > 0
    }
}
