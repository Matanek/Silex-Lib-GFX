use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.ECS.Commands
use GFX.ECS.World

public struct Plugin:PluginProtocol {
    func id() str { return "GFX.ECS.Plugin" }

    func build(application:Application) {
        application.add_resource(World())
        application.add_resource(Commands())
        application.add_after_system(Schedule.post_update, flush_commands)
        application.add_after_system(Schedule.shutdown, stop_ecs)
    }
}

func flush_commands(world:&World, commands:&Commands) {
    commands.flush(world)
}

func stop_ecs(application:Application) {
    var resources = application.resources()
    var commands = resources.remove<Commands>()
    var world = resources.remove<World>()
    assert(commands != null)
    assert(world != null)
}
