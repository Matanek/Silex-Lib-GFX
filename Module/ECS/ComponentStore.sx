use GFX.ECS.ComponentPool.ComponentPool
use GFX.ECS.Entity.Entity

// Compiler-provided typed storage used only for ECS component pools.
intrinsic class ComponentPools {
    func insert<T>(value:T)
    func has<T>() bool
    func get<T>() @T
    func get_mut<T>() &T
    func try_get<T>() @T?
    func try_get_mut<T>() &T?
    func remove<T>() T?
    func clear()
}

protocol ComponentKind {
    func remove_from(resources:&ComponentPools, entity:Entity)
}

struct TypedComponentKind<T>:ComponentKind {
    func remove_from(resources:&ComponentPools, entity:Entity) {
        if !resources.has<ComponentPool<T>>() { return }
        var pool:&ComponentPool<T> = resources.get_mut<ComponentPool<T>>()
        pool.remove(entity)
    }
}

struct ComponentStore {
    private var resources:ComponentPools
    private var kinds:ComponentKind[]

    init() {
        self.resources = ComponentPools()
        self.kinds = []
    }

    func insert<T>(entity:Entity, component:T) int {
        let id = self.ensure<T>()
        var pool:&ComponentPool<T> = self.resources.get_mut<ComponentPool<T>>()
        pool.insert(entity, component)
        return id
    }

    func has<T>(entity:Entity) bool {
        if !self.resources.has<ComponentPool<T>>() { return false }
        let pool:@ComponentPool<T> = self.resources.get<ComponentPool<T>>()
        return pool.has(entity)
    }

    func get<T>(entity:Entity) @self:T {
        if !self.resources.has<ComponentPool<T>>() {
            panic("GFX.ECS component type is not present in this world")
        }
        let pool:@ComponentPool<T> = self.resources.get<ComponentPool<T>>()
        return pool.get(entity)
    }

    func get_known<T>(entity:Entity) @self:T {
        let pool:@ComponentPool<T> = self.resources.get<ComponentPool<T>>()
        return pool.get_known(entity)
    }

    // Lowered by the compiler so a reference can retain ComponentStore
    // provenance across the typed Resources slot and dense pool.
    func get_mut<T>(entity:Entity) &self:T {
        var pool:&ComponentPool<T> = self.resources.get_mut<ComponentPool<T>>()
        return pool.get_mut(entity)
    }

    func update<T>(entity:Entity, callback:func(&T)) {
        var component:&T = self.get_mut<T>(entity)
        callback(component)
    }

    func remove<T>(entity:Entity) T? {
        if !self.resources.has<ComponentPool<T>>() { return null }
        var pool:&ComponentPool<T> = self.resources.get_mut<ComponentPool<T>>()
        return pool.remove(entity)
    }

    func type_id<T>() int {
        if !self.resources.has<ComponentPool<T>>() { return -1 }
        let pool:@ComponentPool<T> = self.resources.get<ComponentPool<T>>()
        return pool.id()
    }

    func remove_all(entity:Entity) {
        var resources = self.resources
        var kinds = self.kinds
        for var kind in kinds { kind.remove_from(resources, entity) }
    }

    private func ensure<T>() int {
        if let pool = self.resources.try_get<ComponentPool<T>>() { return pool.id() }
        let id = self.kinds.count()
        self.resources.insert(ComponentPool<T>(id))
        self.kinds.append(TypedComponentKind<T>())
        return id
    }
}
