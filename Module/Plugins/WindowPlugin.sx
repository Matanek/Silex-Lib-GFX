use GFX.Bootstrap.Plugin
use GFX.Bootstrap.Application
use GFX.Bootstrap.Controller
use GFX.Bootstrap.Schedule
use GFX.Session
use GFX.Window
use GFX.Input
use GFX.Input.State as InputState
use GFX.Plugins.InputPlugin

public use GFX.Window.Settings as Settings

public enum CloseBehavior {
    automatic
    manual
}

struct Configuration {
    let settings:Settings
}

public struct WindowPlugin:Plugin {
    private let settings:Settings
    private let automatic_close:bool

    public init(
        settings:Settings = Settings(),
        close_behavior:CloseBehavior = CloseBehavior.automatic
    ) {
        self.settings = settings
        self.automatic_close = close_behavior == CloseBehavior.automatic
    }

    func id() str { return "GFX.Plugins.WindowPlugin" }

    func build(application:Application) {
        application.install(InputPlugin())
        application.resources().insert(Configuration(settings:self.settings))
        application.add_system(Schedule.startup, start_window)
        application.add_system(Schedule.pre_update, pump_window_events)
        if self.automatic_close {
            application.add_after_system(Schedule.pre_update, handle_close_request)
        }
        application.add_system(Schedule.shutdown, stop_window)
    }
}

func start_window(application:Application) {
    var resources = application.resources()
    let stored_configuration = resources.remove<Configuration>()
    if let configuration = stored_configuration {
        var stored_session = resources.remove<Session>()
        if var session = stored_session {
            var window = Window(session, configuration.settings)
            if !configuration.settings.hidden {
                window.show()
                window.raise()
                window.sync()
            }
            resources.insert(move session)
            resources.insert(window)
            return
        }
        panic("GFX.WindowPlugin requires GFX.Session")
    }
    panic("GFX.WindowPlugin has no window settings")
}

func pump_window_events() {
    Platform.pump_events()
}

func handle_close_request(
    input:@InputState,
    window:@Window,
    controller:&Controller
) {
    for event in input.events() {
        match event {
            quit => {
                controller.stop()
                return
            }
            window_close_requested(id) => {
                if id == window.id() {
                    controller.stop()
                    return
                }
            }
            else => {}
        }
    }
}

func stop_window(application:Application) {
    var resources = application.resources()
    var removed = resources.remove<Window>()
    assert(removed != null)
}
