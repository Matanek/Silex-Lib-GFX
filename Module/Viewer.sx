use GFX.Application.Plugin as PluginProtocol
use GFX.Application
use GFX.Application.Schedule
use GFX.Assets.Image
use GFX.Canvas.Canvas as AuthoredCanvas
use GFX.Color
use GFX.ECS
use GFX.GPU
use GFX.GPU.Plugin as GPUPlugin
use GFX.Rendering.Plugin as RenderingPlugin
use GFX.Rendering.Plugin.Settings as RenderingSettings
use GFX.Scene2D
use GFX.Scene2D.Plugin as Scene2DPlugin
use GFX.Window as WindowApi
use GFX.Window.Plugin as WindowPlugin
use STD.Math

public struct Settings {
    var title:str
    var width:int
    var height:int
    var background:Color
    var smooth:bool

    init(
        title:str = "GFX viewer",
        width:int = 0,
        height:int = 0,
        background:Color = Color.slate_950(),
        smooth:bool = true
    ) {
        self.title = title
        self.width = width
        self.height = height
        self.background = background
        self.smooth = smooth
    }
}

public class View {
    private var current_image:Image
    private var current_revision:int

    init(image:Image) {
        self.current_image = image
        self.current_revision = 1
    }

    func image() @Image { return self.current_image }
    func revision() int { return self.current_revision }

    func replace(image:Image) {
        self.current_image = image
        self.current_revision++
    }
}

class DrawingPresentation {
    let authored_width:int
    let authored_height:int
    var display:ECS.Entity? = null
    var display_width:int
    var display_height:int

    init(width:int, height:int) {
        self.authored_width = width
        self.authored_height = height
        self.display_width = 0
        self.display_height = 0
    }
}

class RenderState {
    private var texture:GPU.Texture? = null
    private var sampler:GPU.Sampler? = null
    private var pipeline:GPU.GraphicsPipeline? = null
    private let background:Color
    private var uploaded_revision:int

    init(
        device:@GPU.Device,
        surface:@GPU.Surface,
        view:@View,
        settings:Settings
    ) {
        let image = view.image()
        var texture = image_texture(device, image)
        upload_image(device, texture, image)
        var filter = GPU.Filter.nearest
        if settings.smooth { filter = GPU.Filter.linear }
        var sampler = device.sampler(GPU.SamplerSettings(
            min_filter:filter,
            mag_filter:filter,
            address_u:GPU.AddressMode.clamp_to_edge,
            address_v:GPU.AddressMode.clamp_to_edge,
            name:"GFX.Viewer sampler"
        ))
        let program = GPU.ShaderProgram.hlsl(file:"../Shaders/Viewer/Image.hlsl")
        var targets:GPU.ColorTargetFormat[] = []
        targets.append(GPU.ColorTargetFormat(format:surface.format()))
        var pipeline = device.graphics_pipeline(
            program,
            GPU.GraphicsPipelineSettings(
                color_targets:targets,
                name:"GFX.Viewer image pipeline"
            )
        )
        self.texture = texture
        self.sampler = sampler
        self.pipeline = pipeline
        self.background = settings.background
        self.uploaded_revision = view.revision()
    }

    func refresh(device:@GPU.Device, view:@View) {
        if self.uploaded_revision == view.revision() { return }
        let image = view.image()
        var replace_texture = true
        if let current = self.texture {
            replace_texture = current.width() != image.width() || current.height() != image.height()
        }
        if replace_texture {
            device.wait_until_idle()
            self.texture = image_texture(device, image)
        }
        if let current = self.texture {
            upload_image(device, current, image)
            self.uploaded_revision = view.revision()
            return
        }
        panic("GFX.Viewer has no image texture")
    }

    func draw(pass:&GPU.RenderPass, image:@Image) {
        let drawable = pass.size()
        let available_width = drawable.width as float
        let available_height = drawable.height as float
        let image_width = image.width() as float
        let image_height = image.height() as float
        var scale = Math.min(
            available_width / image_width,
            available_height / image_height
        )
        // An image viewer must preserve the image's pixels by default. The
        // historical Viewer never enlarged a small image; doing so made the
        // rasterized Drawing examples look aliased and hid their real output.
        scale = Math.min(scale, 1.0)
        let width = image_width * scale
        let height = image_height * scale
        pass.viewport(
            (available_width - width) * 0.5,
            (available_height - height) * 0.5,
            width,
            height
        )
        if let pipeline = self.pipeline {
            if let texture = self.texture {
                if let sampler = self.sampler {
                    pass.bind(pipeline)
                    pass.fragment_sampler(0, texture, sampler)
                    pass.draw(6)
                    return
                }
            }
        }
        panic("GFX.Viewer has no GPU presentation state")
    }

    func clear_color() Color { return self.background }
}

public struct Plugin:PluginProtocol {
    private let initial_image:Image?
    private var initial_drawing:AuthoredCanvas?
    private let drawing_width:int
    private let drawing_height:int
    private let settings:Settings

    init(image:Image, settings:Settings = Settings()) {
        self.initial_image = image
        self.initial_drawing = null
        self.drawing_width = 0
        self.drawing_height = 0
        self.settings = settings
    }

    init(
        drawing:AuthoredCanvas,
        width:int,
        height:int,
        settings:Settings = Settings()
    ) {
        if width <= 0 || height <= 0 {
            panic("GFX.Viewer drawing dimensions must be positive")
        }
        self.initial_image = null
        self.initial_drawing = drawing
        self.drawing_width = width
        self.drawing_height = height
        self.settings = settings
    }

    func id() str { return "GFX.Viewer.Plugin" }

    func build(application:&Application) {
        if let drawing = self.initial_drawing {
            self.build_drawing(application, drawing)
            return
        }
        if let image = self.initial_image {
            self.build_image(application, image)
            return
        }
        panic("GFX.Viewer requires image or drawing content")
    }

    private func build_image(application:&Application, image:Image) {
        let width = viewer_extent(
            self.settings.width,
            image.width(),
            48,
            320,
            1280
        )
        let height = viewer_extent(
            self.settings.height,
            image.height(),
            48,
            240,
            800
        )
        application.add_plugin(WindowPlugin(WindowPlugin.Settings()
            ..title = self.settings.title
            ..width = width
            ..height = height
        ))
        application.add_plugin(GPUPlugin(GPUPlugin.Settings()
            ..present_on_start = false
        ))
        application.add_resource(View(image))
        application.add_resource(self.settings)
        application.add_system(Schedule.startup, start_viewer)
        application.add_system(Schedule.render, render_viewer)
        application.add_system(Schedule.shutdown, stop_viewer)
    }

    private func build_drawing(application:&Application, drawing:AuthoredCanvas) {
        let width = viewer_extent(
            self.settings.width,
            self.drawing_width,
            48,
            320,
            1280
        )
        let height = viewer_extent(
            self.settings.height,
            self.drawing_height,
            48,
            240,
            800
        )
        application.add_plugin(WindowPlugin(WindowPlugin.Settings()
            ..title = self.settings.title
            ..width = width
            ..height = height
        ))
        application.add_plugin(RenderingPlugin(RenderingSettings()
            ..clear = self.settings.background
        ))
        application.add_plugin(Scene2DPlugin())
        application.add_resource(drawing)
        application.add_resource(DrawingPresentation(
            self.drawing_width,
            self.drawing_height
        ))
        application.add_system(Schedule.startup, start_drawing_viewer)
        application.add_system(Schedule.update, resize_drawing_viewer)
        application.add_system(Schedule.shutdown, stop_drawing_viewer)
    }
}

public func show(
    image:Image,
    title:str = "GFX image viewer"
) int {
    var application = Application()
    application.add_plugin(Plugin(image, Settings(title:title)))
    return application.run()
}

public func show(
    drawing:AuthoredCanvas,
    width:int,
    height:int,
    title:str = "GFX canvas viewer"
) int {
    var application = Application()
    application.add_plugin(Plugin(
        drawing,
        width,
        height,
        Settings(title:title, width:width, height:height)
    ))
    return application.run()
}

func start_drawing_viewer(application:Application) {
    var resources = application.resources()
    var stored_drawing = resources.remove<AuthoredCanvas>()
    if var drawing = stored_drawing {
        let size = resources.get<WindowApi>().size()
        var authored_width = 0
        var authored_height = 0
        {
            let presentation = resources.get<DrawingPresentation>()
            authored_width = presentation.authored_width
            authored_height = presentation.authored_height
        }
        var display:ECS.Entity? = null
        {
            var world = resources.get_mut<ECS.World>()
            display = world.spawn(ECS.EntityRecipe()
                ..with(Scene2D.Overlay(drawing, authored_width, authored_height)
                    ..size = size
                )
            )
        }
        if let entity = display {
            var presentation = resources.get_mut<DrawingPresentation>()
            presentation.display = entity
            presentation.display_width = size.x as int
            presentation.display_height = size.y as int
            return
        }
    }
    panic("GFX.Viewer has no drawing")
}

func resize_drawing_viewer(
    window:@WindowApi,
    world:&ECS.World,
    presentation:&DrawingPresentation
) {
    let size = window.size()
    let width = size.x as int
    let height = size.y as int
    if width <= 0 || height <= 0 { return }
    if width == presentation.display_width && height == presentation.display_height { return }
    if let display = presentation.display {
        world.update<Scene2D.Overlay>(display, func(overlay:&Scene2D.Overlay) {
            overlay.size = size
        })
    }
    presentation.display_width = width
    presentation.display_height = height
}

func stop_drawing_viewer(application:Application) {
    var presentation = application.resources().remove<DrawingPresentation>()
    assert(presentation != null)
}

func start_viewer(application:Application) {
    var resources = application.resources()
    let settings = resources.remove<Settings>()
    if let configured = settings {
        var state:RenderState? = null
        {
            let device = resources.get<GPU.Device>()
            let surface = resources.get<GPU.Surface>()
            let view = resources.get<View>()
            state = RenderState(device, surface, view, configured)
        }
        if let ready = state {
            resources.insert(ready)
            return
        }
    }
    panic("GFX.Viewer has no settings")
}

func render_viewer(
    device:@GPU.Device,
    surface:@GPU.Surface,
    view:@View,
    state:&RenderState
) {
    state.refresh(device, view)
    var commands = device.commands()
    if var pass = commands.render(surface, state.clear_color()) {
        state.draw(pass, view.image())
        pass.finish()
    }
    commands.submit()
}

func stop_viewer(application:Application) {
    var resources = application.resources()
    var state = resources.remove<RenderState>()
    assert(state != null)
    var view = resources.remove<View>()
    assert(view != null)
}

func image_texture(device:@GPU.Device, image:@Image) GPU.Texture {
    return device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.rgba8_unorm,
        width:image.width(),
        height:image.height(),
        usage:GPU.TextureUsage.for_sampling(),
        name:"GFX.Viewer image"
    ))
}

func upload_image(device:@GPU.Device, texture:GPU.Texture, image:@Image) {
    var pixels = image.pixels()
    var upload = device.upload_buffer(pixels.count(), "GFX.Viewer image upload")
    upload.write(@pixels[0:pixels.count()])
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(
        upload,
        GPU.TextureRegion(
            texture:texture,
            width:image.width(),
            height:image.height()
        ),
        image.width(),
        image.height()
    )
    transfer.finish()
    commands.submit()
}

func viewer_extent(
    requested:int,
    content:int,
    padding:int,
    minimum:int,
    maximum:int
) int {
    if requested > 0 { return requested }
    let padded = content + padding
    if padded < minimum { return minimum }
    if padded > maximum { return maximum }
    return padded
}
