use Interop.C
use Interop.Boundary
use GFX.Bootstrap.Plugin as PluginProtocol
use GFX.Bootstrap.Application
use GFX.Bootstrap.Controller
use GFX.Bootstrap.Schedule
use GFX.Window
use GFX.Window.PluginSettings
use GFX.Window.PluginCloseBehavior
use GFX.Input
use GFX.Input.State as InputState
use GFX.Input.Plugin as InputPlugin

struct Configuration {
    let settings:Window.Settings
}

public struct Plugin:PluginProtocol {
    private let settings:PluginSettings
    private let automatic_close:bool

    public init(settings:PluginSettings = PluginSettings()) {
        self.settings = settings
        self.automatic_close = settings.close_behavior == PluginCloseBehavior.automatic
    }

    func id() str { return "GFX.Plugins.Window" }

    func build(application:Application) {
        application.install(InputPlugin())
        application.resources().insert(Configuration(settings:Window.Settings(
            title:self.settings.title,
            width:self.settings.width,
            height:self.settings.height,
            resizable:self.settings.resizable,
            fullscreen:self.settings.fullscreen,
            borderless:self.settings.borderless,
            high_pixel_density:self.settings.high_pixel_density,
            hidden:self.settings.hidden,
            maximized:self.settings.maximized,
            minimized:self.settings.minimized,
            always_on_top:self.settings.always_on_top,
            transparent:self.settings.transparent,
            focusable:self.settings.focusable,
            utility:self.settings.utility
        )))
        application.add_system(Schedule.startup, start_window)
        application.add_system(Schedule.pre_update, pump_window_events)
        if self.automatic_close {
            application.add_after_system(Schedule.pre_update, handle_close_request)
        }
        application.add_system(Schedule.shutdown, stop_window)
    }
}

func start_window(application:Application) {
    var resources = application.resources()
    let stored_configuration = resources.remove<Configuration>()
    if let configuration = stored_configuration {
        var window = Window(configuration.settings)
        if !configuration.settings.hidden {
            window.show()
            window.raise()
            window.sync()
        }
        resources.insert(window)
        return
    }
    panic("GFX.WindowPlugin has no window settings")
}

func pump_window_events() {
    sdl_pump_events()
}

func handle_close_request(
    input:@InputState,
    window:@Window,
    controller:&Controller
) {
    for event in input.events() {
        match event {
            quit(meta) => {
                controller.stop()
                return
            }
            window_close_requested(request) => {
                if request.window == window.id() {
                    controller.stop()
                    return
                }
            }
            else => {}
        }
    }
}

func stop_window(application:Application) {
    var resources = application.resources()
    var removed = resources.remove<Window>()
    assert(removed != null)
}

let sdl_pump_events = C.function<func() void>(
    library:Boundary.SDL3,
    name:"SDL_PumpEvents"
)
