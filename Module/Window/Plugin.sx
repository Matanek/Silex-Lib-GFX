use GFX.Application.Plugin as PluginProtocol
use GFX.Application
use GFX.Application.Schedule
use GFX.Input.Plugin as InputPlugin
use GFX.Input.State as InputState
use GFX.Input.Native
use GFX.Application.NativeLoop.FrameLoop
use GFX.Window as WindowApi

public enum CloseBehavior {
    automatic
    manual
}

struct ClosePolicy {
    let behavior:CloseBehavior

    init(behavior:CloseBehavior) {
        self.behavior = behavior
    }
}

struct Configuration {
    let settings:WindowApi.Settings
    let visible_on_ready:bool
}

public class Presentation {
    private let requested:bool
    private var completed:bool

    module init(requested:bool) {
        self.requested = requested
        self.completed = false
    }

    func present(window:&WindowApi) {
        if self.completed || !self.requested { return }
        window.show()
        if window.state().focusable { window.raise() }
        self.completed = true
    }
}

public struct Plugin:PluginProtocol {
    struct Settings {
        var title:str
        var width:int
        var height:int
        var resizable:bool
        var fullscreen:bool
        var borderless:bool
        var high_pixel_density:bool
        var hidden:bool
        var maximized:bool
        var minimized:bool
        var always_on_top:bool
        var transparent:bool
        var focusable:bool
        var utility:bool
        var close_behavior:CloseBehavior

        init() {
            self.title = "Window"
            self.width = 1280
            self.height = 720
            self.resizable = true
            self.fullscreen = false
            self.borderless = false
            self.high_pixel_density = true
            self.hidden = false
            self.maximized = false
            self.minimized = false
            self.always_on_top = false
            self.transparent = false
            self.focusable = true
            self.utility = false
            self.close_behavior = CloseBehavior.automatic
        }
    }

    private let settings:Settings

    init(settings:Settings = Settings()) {
        self.settings = settings
    }

    func id() str { return "GFX.Window.Plugin" }

    func build(application:&Application) {
        application.add_plugin(InputPlugin())
        application.add_resource(Configuration(
            settings:WindowApi.Settings(
                title:self.settings.title,
                width:self.settings.width,
                height:self.settings.height,
                resizable:self.settings.resizable,
                fullscreen:self.settings.fullscreen,
                borderless:self.settings.borderless,
                high_pixel_density:self.settings.high_pixel_density,
                hidden:true,
                maximized:self.settings.maximized,
                minimized:self.settings.minimized,
                always_on_top:self.settings.always_on_top,
                transparent:self.settings.transparent,
                focusable:self.settings.focusable,
                utility:self.settings.utility
            ),
            visible_on_ready:!self.settings.hidden
        ))
        application.add_resource(ClosePolicy(self.settings.close_behavior))
        application.add_system(Schedule.startup, start_window)
        application.add_after_system(Schedule.startup, present_without_renderer)
        application.add_after_system(Schedule.pre_update, handle_close_request, process_mode:GFX.Application.ProcessMode.always)
        application.add_system(Schedule.shutdown, stop_window)
    }
}

func start_window(application:Application) {
    var resources = application.resources()
    let stored_configuration = resources.remove<Configuration>()
    if let configuration = stored_configuration {
        var window = WindowApi(configuration.settings)
        resources.insert(Presentation(configuration.visible_on_ready))
        resources.insert(window)
        observe_controlled_close(application)
        return
    }
    panic("GFX.Window.Plugin has no window settings")
}

// Idle controlled loops must honor automatic close without running pre_update.
// A separate watcher leaves the Input event stream intact for the next step.
class CloseObserver {
    private var application:Application
    private let identifier:WindowApi.Id
    private var watcher:Native.Watcher = Native.Watcher()

    init(application:Application, identifier:WindowApi.Id) {
        self.application = application
        self.identifier = identifier
    }

    func poll() {
        for event in self.watcher.take() {
            match event {
                quit(meta) => { self.application.stop(); return }
                window_close_requested(request) => {
                    if request.window == self.identifier { self.application.stop(); return }
                }
                else => {}
            }
        }
    }
}

func observe_controlled_close(application:Application) {
    var resources = application.resources()
    {
        let policy = resources.get<ClosePolicy>()
        if policy.behavior != CloseBehavior.automatic { return }
    }
    var controlled = false
    {
        if let loop = resources.try_get<FrameLoop>() { controlled = loop.is_controlled() }
    }
    if !controlled { return }
    let identifier = resources.get<WindowApi>().id()
    var observer = CloseObserver(application, identifier)
    var loop = resources.get_mut<FrameLoop>()
    loop.on_poll(identifier.value, observer.poll)
}

func present_without_renderer(application:Application) {
    var resources = application.resources()
    var stored_window = resources.remove<WindowApi>()
    if var window = stored_window {
        var stored_presentation = resources.remove<Presentation>()
        if var presentation = stored_presentation {
            presentation.present(window)
            resources.insert(presentation)
        } else {
            panic("GFX.Window.Plugin has no presentation state")
        }
        resources.insert(window)
        return
    }
    panic("GFX.Window.Plugin could not present its window")
}

func handle_close_request(application:Application) {
    var resources = application.resources()
    let policy = resources.get<ClosePolicy>()
    if policy.behavior != CloseBehavior.automatic { return }
    let input = resources.get<InputState>()
    let window = resources.get<WindowApi>()
    for event in input.events() {
        match event {
            quit(meta) => {
                application.stop()
                return
            }
            window_close_requested(request) => {
                if request.window == window.id() {
                    application.stop()
                    return
                }
            }
            else => {}
        }
    }
}

func stop_window(application:Application) {
    var resources = application.resources()
    let identifier = resources.get<WindowApi>().id()
    {
        if var loop = resources.try_get_mut<FrameLoop>() { loop.remove_poll(identifier.value) }
    }
    var removed = resources.remove<WindowApi>()
    assert(removed != null)
    var presentation = resources.remove<Presentation>()
    assert(presentation != null)
    var close_policy = resources.remove<ClosePolicy>()
    assert(close_policy != null)
}
