use GFX.Assets.Image
use GFX.Canvas.Geometry.Mesh
use GFX.Canvas.Command
use GFX.Canvas.Rasterizer
use STD.Math

public class Snapshot {
    private static var next_identity:int = 1
    private let identity:int
    private let retained_geometry:Mesh
    private var retained_text:Rasterizer.TextImage? = null
    private let text_commands:Command[]
    private let text_width:int
    private let text_height:int
    private var text_scale:float

    public init() {
        self.identity = Snapshot.next_identity
        Snapshot.next_identity++
        self.retained_geometry = Mesh()
        self.text_commands = []
        self.text_width = 1
        self.text_height = 1
        self.text_scale = 1.0
    }

    internal init(geometry:Mesh, commands:Command[], width:int, height:int) {
        self.identity = Snapshot.next_identity
        Snapshot.next_identity++
        self.retained_geometry = geometry
        self.text_commands = retained_text_commands(commands)
        self.text_width = width
        self.text_height = height
        self.text_scale = 1.0
    }

    public func geometry() Mesh { return self.retained_geometry }
    public func id() int { return self.identity }
    public func has_text() bool { return self.text_commands.count() > 0 }
    public func has_cached_text() bool { return self.retained_text != null }
    public func text(scale:float = 1.0) Image {
        if !Math.nearly_equal(scale, self.text_scale) || self.retained_text == null {
            self.retained_text = Rasterizer.rasterize_cropped_text(
                self.text_commands,
                self.text_width,
                self.text_height,
                scale
            )
            self.text_scale = scale
        }
        if let layer = self.retained_text { return layer.image }
        panic("GFX retained drawing could not cache its text image")
    }

    public func text_layer(scale:float = 1.0) Rasterizer.TextImage {
        let image = self.text(scale)
        if let layer = self.retained_text { return layer }
        panic("GFX retained drawing could not cache its text layer")
    }
}

func retained_text_commands(commands:@Command[]) Command[] {
    var retained:Command[] = []
    for command in commands {
        match command {
            text(value) => { if value.value != "" { retained.append(Command.text(value)) } }
            else => {}
        }
    }
    return retained
}
