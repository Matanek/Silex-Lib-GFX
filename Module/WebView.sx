use GFX.Window
use GFX.Color
use STD.JSON
use STD.Text.UTF8.bytes as utf8_bytes
use Interop.C

public struct Asset {
    private let logical_path:str
    private let media_type_value:str
    private let embedded_text:str

    public init(text:str, path:str, media_type:str) {
        self.logical_path = path
        self.media_type_value = media_type
        self.embedded_text = text
    }

    public static func html(text:str, path:str = "/index.html") Asset {
        return Asset(text:text, path:path, media_type:"text/html; charset=utf-8")
    }

    public static func css(text:str, path:str = "/style.css") Asset {
        return Asset(text:text, path:path, media_type:"text/css; charset=utf-8")
    }

    public static func javascript(text:str, path:str = "/app.js") Asset {
        return Asset(text:text, path:path, media_type:"text/javascript; charset=utf-8")
    }

    public func path() str { return self.logical_path }
    public func media_type() str { return self.media_type_value }
    public func text() str { return self.embedded_text }
}

public struct Site {
    private let entry_path:str
    private var embedded_assets:Asset[]

    public init(entry:Asset) {
        self.entry_path = entry.path()
        self.embedded_assets = [entry]
    }

    public func add(asset:Asset) {
        for let existing in self.embedded_assets {
            if existing.path() == asset.path() {
                panic("GFX.WebView.Site cannot contain two assets with the same path")
            }
        }
        self.embedded_assets.append(asset)
    }

    public func entry() Asset {
        return self.require(self.entry_path)
    }

    public func find(path:str) Asset? {
        for let asset in self.embedded_assets {
            if asset.path() == path { return asset }
        }
        return null
    }

    public func require(path:str) Asset {
        if let asset = self.find(path) { return asset }
        panic("GFX.WebView.Site does not contain the requested asset")
    }

    public func assets() @self:Asset[..] {
        return @self.embedded_assets[0:self.embedded_assets.count()]
    }

    public func count() int { return self.embedded_assets.count() }
}

public enum Status {
    loading
    ready
}

public struct Settings {
    var background:Color = Color(r:1.0, g:1.0, b:1.0, a:1.0)
}

public struct Availability {
    private let available_value:bool
    private let reason_value:str

    internal static func available() Availability {
        return Availability(available_value:true, reason_value:"")
    }

    internal static func unavailable(reason:str) Availability {
        return Availability(available_value:false, reason_value:reason)
    }

    public func is_available() bool { return self.available_value }

    public func reason() str? {
        if self.available_value { return null }
        return self.reason_value
    }
}

public struct Message {
    let name:str
    let payload:str
}

internal class Bridge {
    private var incoming:Message[]
    private var outgoing:Message[]
    private var received_batches:int
    private var sent_batches:int

    public init() {
        self.incoming = []
        self.outgoing = []
        self.received_batches = 0
        self.sent_batches = 0
    }

    internal func record(encoded_batch:str) {
        match JSON.parse(encoded_batch) {
            failure(error) => {}
            success(var batch) => {
                if var entries = batch.as_array() {
                    self.received_batches++
                    for var entry in entries {
                        if var pair = entry.as_array() {
                            if pair.count() == 2 {
                                if let name = pair[0].as_string() {
                                    if let payload = pair[1].as_string() {
                                        var incoming = self.incoming
                                        incoming.append(Message(name:name, payload:payload))
                                        self.incoming = incoming
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    internal func queue(message:Message) {
        var outgoing = self.outgoing
        outgoing.append(message)
        self.outgoing = outgoing
    }

    internal func take_incoming() Message[] {
        let result = self.incoming
        self.incoming = []
        return result
    }

    internal func take_outgoing() Message[] {
        let result = self.outgoing
        self.outgoing = []
        return result
    }

    internal func restore_outgoing(messages:Message[]) { self.outgoing = messages }
    internal func mark_sent() { self.sent_batches++ }

    internal func received_batch_count() int { return self.received_batches }
    internal func sent_batch_count() int { return self.sent_batches }
}

func receive_bridge_message(handler:uint, command:uint, controller:uint, message:uint) {
    let context = Platform.message_context(handler)
    if context == 0 as uint { return }
    let text = Platform.message_text(message)
    if text == "" { return }
    var bridge = C.object_from_address<Bridge>(context)
    bridge.record(text)
}

public func availability() Availability {
    if Platform.available() { return Availability.available() }
    return Availability.unavailable(Platform.unavailable_reason())
}

public class View {
    private var window:Window?
    private var bridge:Bridge
    private let platform_window:uint
    private let handle:uint
    private let document_value:str

    public init(window:Window, site:Site, settings:Settings = Settings()) {
        let availability = availability()
        if !availability.is_available() {
            if let reason = availability.reason() { panic("GFX.WebView is unavailable: " + reason) }
            panic("GFX.WebView is unavailable on this platform")
        }
        let platform_window = window.presentation_handle()
        if platform_window == 0 as uint {
            panic("GFX.WebView could not access the system window")
        }
        var bridge = Bridge()
        let callback:func(uint, uint, uint, uint) void = receive_bridge_message
        let document_value = document(site)
        let handle = Platform.create(
            platform_window,
            document_value,
            C.object_address(bridge),
            C.function_address(callback)
        )
        if handle == 0 as uint {
            panic("GFX.WebView could not create the system WebView")
        }
        self.window = window
        self.bridge = bridge
        self.platform_window = platform_window
        self.handle = handle
        self.document_value = document_value
        self.set_background(settings.background)
    }

    drop {
        Platform.destroy(self.handle)
    }

    public func reload() {
        if !Platform.load(self.handle, self.document_value) {
            panic("GFX.WebView could not reload its embedded document")
        }
    }

    public func set_visible(visible:bool) {
        Platform.set_visible(self.handle, visible)
    }

    public func is_visible() bool {
        return Platform.is_visible(self.handle)
    }

    public func set_background(color:Color) {
        Platform.set_background(
            self.platform_window,
            self.handle,
            color.r,
            color.g,
            color.b,
            color.a
        )
    }

    public func status() Status {
        if Platform.loading(self.handle) { return Status.loading }
        return Status.ready
    }

    public func send(name:str, payload:str = "") {
        self.bridge.queue(Message(name:name, payload:payload))
    }

    public func flush() bool {
        if self.status() == Status.loading { return false }
        let messages = self.bridge.take_outgoing()
        if messages.count() == 0 { return false }
        if Platform.send(self.handle, encode_messages(messages)) {
            self.bridge.mark_sent()
            return true
        }
        self.bridge.restore_outgoing(messages)
        return false
    }

    public func receive() Message[] { return self.bridge.take_incoming() }

    internal func received_batch_count() int { return self.bridge.received_batch_count() }
    internal func sent_batch_count() int { return self.bridge.sent_batch_count() }

    internal func simulate_close_request() {
        Platform.simulate_close_request(self.platform_window)
    }
}

internal func document(site:Site) str {
    var result = site.entry().text() +
        "\n<script>" + Platform.bridge_script() + bridge_script() + "</script>\n"
    for let asset in site.assets() {
        if asset.path() != site.entry().path() {
            let media_type = asset.media_type()
            if media_type == "text/css" || media_type == "text/css; charset=utf-8" {
                result = result + "\n<style>\n" + asset.text() + "\n</style>\n"
            }
            if media_type == "text/javascript" || media_type == "text/javascript; charset=utf-8" {
                result = result + "\n<script>\n" + asset.text() + "\n</script>\n"
            }
        }
    }
    return result
}

func encode_messages(messages:Message[]) str {
    var output:uint8[] = []
    output.append(91 as uint8)
    var index = 0
    for message in messages {
        if index != 0 { output.append(44 as uint8) }
        output.append(91 as uint8)
        append_json_string(output, message.name)
        output.append(44 as uint8)
        append_json_string(output, message.payload)
        output.append(93 as uint8)
        index++
    }
    output.append(93 as uint8)
    return C.string(@output[0:output.count()])
}

func append_json_string(output:&uint8[], value:str) {
    output.append(34 as uint8)
    let digits = utf8_bytes("0123456789abcdef")
    for byte in utf8_bytes(value) {
        if byte == 34 { append_json_text(output, "\\\"") }
        elif byte == 92 { append_json_text(output, "\\\\") }
        elif byte == 8 { append_json_text(output, "\\b") }
        elif byte == 12 { append_json_text(output, "\\f") }
        elif byte == 10 { append_json_text(output, "\\n") }
        elif byte == 13 { append_json_text(output, "\\r") }
        elif byte == 9 { append_json_text(output, "\\t") }
        elif byte < 32 {
            append_json_text(output, "\\u00")
            output.append(digits[(byte / 16) as int])
            output.append(digits[(byte % 16) as int])
        } else { output.append(byte) }
    }
    output.append(34 as uint8)
}

func append_json_text(output:&uint8[], value:str) {
    for byte in utf8_bytes(value) { output.append(byte) }
}

func bridge_script() str {
    return "" +
        "(()=>{" +
        "const listeners=new Map();let outgoing=[];let scheduled=false;" +
        "const flush=()=>{scheduled=false;const batch=outgoing;outgoing=[];window.__silexPost(JSON.stringify(batch));};" +
        "window.silex={" +
        "send(name,payload=''){outgoing.push([String(name),String(payload)]);if(!scheduled){scheduled=true;queueMicrotask(flush);}}," +
        "on(name,listener){name=String(name);let group=listeners.get(name);if(!group){group=[];listeners.set(name,group);}group.push(listener);return()=>{const index=group.indexOf(listener);if(index>=0)group.splice(index,1);};}" +
        "};" +
        "window.__silexReceive=batch=>{for(const [name,payload] of batch){const group=listeners.get(name);if(group){for(const listener of [...group])listener(payload);}}};" +
        "})();"
}
