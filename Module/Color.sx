public struct Color {
    var r:float = 1.0
    var g:float = 1.0
    var b:float = 1.0
    var a:float = 1.0

    static func rgb(r:float, g:float, b:float) Color {
        return Color(r:r, g:g, b:b)
    }

    static func rgba(r:float, g:float, b:float, a:float) Color {
        return Color(r:r, g:g, b:b, a:a)
    }

    static func bytes(r:uint8, g:uint8, b:uint8, a:uint8 = 255) Color {
        return Color.rgba(
            r as float / 255.0,
            g as float / 255.0,
            b as float / 255.0,
            a as float / 255.0
        )
    }

    func with_alpha(alpha:float) Color {
        return Color.rgba(self.r, self.g, self.b, alpha)
    }

    func lerp(other:Color, amount:float) Color {
        return Color.rgba(
            self.r + (other.r - self.r) * amount,
            self.g + (other.g - self.g) * amount,
            self.b + (other.b - self.b) * amount,
            self.a + (other.a - self.a) * amount
        )
    }

    func mix(other:Color, amount:float) Color {
        return self.lerp(other, amount)
    }

    func to_str() str {
        return "{ $(self.r) $(self.g) $(self.b) $(self.a) }"
    }

