use GFX.Bootstrap.Application
use GFX.Bootstrap.Plugin as PluginProtocol
use GFX.Bootstrap.Schedule
use GFX.Camera.OrbitalCamera3D
use GFX.Camera.OrbitalPlugin3DSettings
use GFX.ECS
use GFX.Input.State as InputState
use GFX.Input.Plugin as InputPlugin
use GFX.Rendering.Plugin3D as Rendering3DPlugin
use GFX.Transform.Transform3D

public struct OrbitalPlugin3D:PluginProtocol {
    private let settings:OrbitalPlugin3DSettings

    public init(settings:OrbitalPlugin3DSettings = OrbitalPlugin3DSettings()) {
        self.settings = settings
    }

    func id() str { return "GFX.Plugins.OrbitalCamera3D" }

    func build(application:Application) {
        application.install(InputPlugin())
        application.install(Rendering3DPlugin())
        application.resources().insert(OrbitalCamera3D(self.settings))
        application.add_system(Schedule.startup, create_orbital_camera)
        application.add_system(Schedule.update, update_orbital_camera)
    }
}

func create_orbital_camera(camera:&OrbitalCamera3D, world:&ECS.World) {
    var recipe = ECS.EntityRecipe()
        ..with(camera.transform())
        ..with(camera.camera_component())
    let entity = world.spawn(recipe)
    camera.attach(entity)
}

func update_orbital_camera(
    camera:&OrbitalCamera3D,
    world:&ECS.World,
    input:@InputState
) {
    let controls = camera.controls()
    let mouse = input.mouse_delta()
    let wheel = input.mouse_wheel()
    camera.zoom_wheel(wheel.y)
    if input.is_down(controls.orbit) { camera.orbit(mouse.x, mouse.y) }
    if input.is_down(controls.pan) { camera.pan(mouse.x, mouse.y) }
    camera.advance(
        input.is_down(controls.zoom_in),
        input.is_down(controls.zoom_out)
    )
    let entity = camera.entity()
    if !world.is_alive(entity) { return }
    var removed = world.remove<Transform3D>(entity)
    if removed != null { world.insert(entity, camera.transform()) }
}
