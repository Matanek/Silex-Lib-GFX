use STD.Math
use GFX.Transform.Transform3D as Transform3D

public struct Camera3D {
    var active:bool
    var vertical_fov_radians:float
    var near_plane:float
    var far_plane:float
    var order:int

    public init(
        active:bool = true,
        vertical_fov_radians:float = 1.04719758,
        near_plane:float = 0.1,
        far_plane:float = 1000.0,
        order:int = 0
    ) {
        self.active = active
        self.vertical_fov_radians = vertical_fov_radians
        self.near_plane = near_plane
        self.far_plane = far_plane
        self.order = order
    }

    public func view(transform:@Transform3D) Math.Mat4 {
        return transform.view_matrix()
    }

    public func is_active() bool { return self.active }

    public func render_order() int { return self.order }

    public func projection(aspect_ratio:float) Math.Mat4 {
        var aspect = aspect_ratio
        if aspect <= 0.0 { aspect = 1.0 }
        var fov = self.vertical_fov_radians
        if fov <= 0.0 || fov >= Math.pi() { fov = 1.04719758 }
        var near = self.near_plane
        if near <= 0.0 { near = 0.001 }
        var far = self.far_plane
        if far <= near { far = near + 1000.0 }
        return Math.Mat4.perspective(fov, aspect, near, far)
    }
}
