func copy_text(address:uint) str {
    if address == 0 as uint { return "" }
    var bytes:uint8[] = []
    var index = 0
    while index < 1048576 {
        let byte = C.load<uint8>(address, index as uint)
        if byte == 0 { return C.string(@bytes[0:bytes.count()]) }
        bytes.append(byte)
        index++
    }
    panic("GFX.Input received an invalid platform string")
}

func copy_text_array(address:uint, count:int) str[] {
    var result:str[] = []
    if address == 0 as uint || count <= 0 { return result }
    var index = 0
    while index < count {
        result.append(copy_text(C.load<uint>(address, (index as uint) * 8)))
        index++
    }
    return result
}

func mouse_button(value:uint8) Pointer.MouseButton {
    if value == 1 { return Pointer.MouseButton.left }
    if value == 2 { return Pointer.MouseButton.middle }
    if value == 3 { return Pointer.MouseButton.right }
    if value == 4 { return Pointer.MouseButton.x1 }
    if value == 5 { return Pointer.MouseButton.x2 }
    return Pointer.MouseButton.other(value)
}

func modifiers(value:uint16) Keyboard.Modifiers {
    return Keyboard.Modifiers(
        shift:(value & 0x0003) != 0, control:(value & 0x00c0) != 0,
        alt:(value & 0x0300) != 0, system:(value & 0x0c00) != 0,
        left_shift:(value & 0x0001) != 0, right_shift:(value & 0x0002) != 0,
        level5:(value & 0x0004) != 0,
        left_control:(value & 0x0040) != 0, right_control:(value & 0x0080) != 0,
        left_alt:(value & 0x0100) != 0, right_alt:(value & 0x0200) != 0,
        left_system:(value & 0x0400) != 0, right_system:(value & 0x0800) != 0,
        num_lock:(value & 0x1000) != 0, caps_lock:(value & 0x2000) != 0,
        mode:(value & 0x4000) != 0, scroll_lock:(value & 0x8000) != 0
    )
}

