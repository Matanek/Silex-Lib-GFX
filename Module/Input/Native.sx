use Interop.C
use Interop.Boundary
use STD.Math
use GFX.Window
use GFX.Window.Display
use GFX.Input.Keyboard
use GFX.Input.Pointer
use GFX.Input.Events

public func watch_lifecycle(context:uint, raw:uint) int32 {
    let kind = C.load<uint32>(raw, 0 as uint)
    if kind < 0x101 || kind > 0x106 { return 1 }
    let timestamp = Events.Timestamp(nanoseconds:C.load<uint>(raw, 8 as uint))
    var watcher = C.object_from_address<Watcher>(context)
    if kind == 0x101 { watcher.record(Events.Event.terminating(Events.Meta(timestamp:timestamp))) }
    if kind == 0x102 { watcher.record(Events.Event.low_memory(Events.Meta(timestamp:timestamp))) }
    if kind == 0x103 { watcher.record(Events.Event.will_enter_background(Events.Meta(timestamp:timestamp))) }
    if kind == 0x104 { watcher.record(Events.Event.did_enter_background(Events.Meta(timestamp:timestamp))) }
    if kind == 0x105 { watcher.record(Events.Event.will_enter_foreground(Events.Meta(timestamp:timestamp))) }
    if kind == 0x106 { watcher.record(Events.Event.did_enter_foreground(Events.Meta(timestamp:timestamp))) }
    return 1
}

public class Watcher {
    private var spin:int32
    private var pending:Events.Event[]

    init() {
        self.spin = 0
        self.pending = []
        let callback:func(uint, uint) int32 = watch_lifecycle
        if sdl_add_event_watch(C.pointer_bits(C.function_address(callback)), C.pointer_bits(C.object_address(self))) == 0 {
            panic("GFX.Input could not observe lifecycle events")
        }
    }

    drop {
        let callback:func(uint, uint) int32 = watch_lifecycle
        sdl_remove_event_watch(C.pointer_bits(C.function_address(callback)), C.pointer_bits(C.object_address(self)))
    }

    func take() Events.Event[] {
        sdl_lock_spin(C.mutable_pointer(self.spin))
        if self.pending.is_empty() {
            let empty = self.pending
            sdl_unlock_spin(C.mutable_pointer(self.spin))
            return empty
        }
        let result = self.pending
        self.pending = []
        sdl_unlock_spin(C.mutable_pointer(self.spin))
        return result
    }

    module func record(event:Events.Event) {
        sdl_lock_spin(C.mutable_pointer(self.spin))
        self.pending.append(event)
        sdl_unlock_spin(C.mutable_pointer(self.spin))
    }
}

public func global_mouse_position() Math.Vec2 {
    var x:float32 = 0.0
    var y:float32 = 0.0
    let buttons = sdl_get_global_mouse_state(C.mutable_pointer(x), C.mutable_pointer(y))
    return Math.Vec2(x as float, y as float)
}

public func keyboard_focus() Window.Id? { return focus_id(C.address_bits(sdl_get_keyboard_focus())) }
public func mouse_focus() Window.Id? { return focus_id(C.address_bits(sdl_get_mouse_focus())) }

func focus_id(address:uint) Window.Id? {
    if address == 0 as uint { return null }
    let value = sdl_get_window_id(C.pointer_bits(address))
    if value == 0 { return null }
    return Window.Id(value:value)
}

public func touch_devices() Events.TouchId[] {
    var count:int32 = 0
    let address = C.address_bits(sdl_get_touch_devices(C.mutable_pointer(count)))
    if address == 0 as uint { return [] }
    var result:Events.TouchId[] = []
    var index = 0
    while index < count as int {
        result.append(Events.TouchId(value:C.load<uint>(address, (index as uint) * 8)))
        index++
    }
    sdl_free(C.pointer_bits(address))
    return result
}

public func current_modifiers() Keyboard.Modifiers { return modifiers(sdl_get_mod_state() as uint16) }

public func keyboard_info(id:Keyboard.KeyboardId) Events.KeyboardInfo {
    return Events.KeyboardInfo(id:id, name:copy_text(C.address_bits(sdl_get_keyboard_name(id.value))))
}

public func mouse_info(id:Pointer.MouseId) Events.MouseInfo {
    return Events.MouseInfo(id:id, name:copy_text(C.address_bits(sdl_get_mouse_name(id.value))))
}

public func joystick_info(id:Events.JoystickId) Events.JoystickInfo {
    let player = sdl_get_joystick_player(id.value)
    var optional_player:int? = null
    if player >= 0 { optional_player = player as int }
    return Events.JoystickInfo(
        id:id,
        name:copy_text(C.address_bits(sdl_get_joystick_name(id.value))),
        kind:joystick_kind(sdl_get_joystick_type(id.value)),
        player:optional_player,
        connected:true
    )
}

public func gamepad_info(id:Events.GamepadId) Events.GamepadInfo {
    let player = sdl_get_joystick_player(id.value)
    var optional_player:int? = null
    if player >= 0 { optional_player = player as int }
    return Events.GamepadInfo(
        id:id,
        name:copy_text(C.address_bits(sdl_get_gamepad_name(id.value))),
        kind:gamepad_kind(sdl_get_gamepad_type(id.value)),
        player:optional_player,
        connected:true
    )
}

public func poll_event() Events.Event? {
    var storage:uint[16]
    return poll_event_at(C.address_bits(C.mutable_pointer(storage)))
}

func allocate_event_storage() uint {
    return C.address_bits(sdl_malloc(128 as C.Size))
}

func free_event_storage(address:uint) {
    if address != 0 as uint { sdl_free(C.pointer_bits(address)) }
}

func poll_event_at(address:uint) Events.Event? {
    while true {
        if sdl_poll_event_at(C.pointer_bits(address)) == 0 { return null }
        let kind = C.load<uint32>(address, 0 as uint)
        let timestamp = Events.Timestamp(nanoseconds:C.load<uint>(address, 8 as uint))

        if kind == 0 || kind == 0xffff || kind == 0x7fff_ffff || kind == 0x4000 || kind == 0x4001 || kind == 0x4002 || kind == 0x4003 || kind == 0x7f00 { continue }

        if kind == 0x100 { return Events.Event.quit(Events.Meta(timestamp:timestamp)) }
        if kind == 0x101 { return Events.Event.terminating(Events.Meta(timestamp:timestamp)) }
        if kind == 0x102 { return Events.Event.low_memory(Events.Meta(timestamp:timestamp)) }
        if kind == 0x103 { return Events.Event.will_enter_background(Events.Meta(timestamp:timestamp)) }
        if kind == 0x104 { return Events.Event.did_enter_background(Events.Meta(timestamp:timestamp)) }
        if kind == 0x105 { return Events.Event.will_enter_foreground(Events.Meta(timestamp:timestamp)) }
        if kind == 0x106 { return Events.Event.did_enter_foreground(Events.Meta(timestamp:timestamp)) }
        if kind == 0x107 { return Events.Event.locale_changed(Events.Meta(timestamp:timestamp)) }
        if kind == 0x108 { return Events.Event.system_theme_changed(Events.SystemThemeEvent(theme:system_theme(sdl_get_system_theme()), timestamp:timestamp)) }

        if kind >= 0x151 && kind <= 0x158 { return display_event(address, kind, timestamp) }
        if kind >= 0x202 && kind <= 0x21a { return window_event(address, kind, timestamp) }
        if kind >= 0x300 && kind <= 0x309 { return keyboard_event(address, kind, timestamp) }
        if kind >= 0x400 && kind <= 0x405 { return mouse_event(address, kind, timestamp) }
        if kind >= 0x600 && kind <= 0x608 { return joystick_event(address, kind, timestamp) }
        if kind >= 0x650 && kind <= 0x65b { return gamepad_event(address, kind, timestamp) }
        if kind >= 0x700 && kind <= 0x703 { return touch_event(address, kind, timestamp) }
        if kind >= 0x710 && kind <= 0x712 { return pinch_event(address, kind, timestamp) }
        if kind == 0x900 { return clipboard_event(address, timestamp) }
        if kind >= 0x1000 && kind <= 0x1004 { return drop_event(address, kind, timestamp) }
        if kind >= 0x1100 && kind <= 0x1102 { return audio_event(address, kind, timestamp) }
        if kind == 0x1200 { return sensor_event(address, timestamp) }
        if kind >= 0x1300 && kind <= 0x1307 { return pen_event(address, kind, timestamp) }
        if kind >= 0x1400 && kind <= 0x1403 { return camera_event(address, kind, timestamp) }
        if kind >= 0x2000 && kind <= 0x2002 { return render_event(address, kind, timestamp) }
        if kind >= 0x8000 && kind < 0xffff { return custom_event(address, kind, timestamp) }
        return Events.Event.unknown(Events.UnknownEvent(kind:kind, timestamp:timestamp))
    }
    return null
}

public func wait_for_event(timeout_milliseconds:int) {
    let result = sdl_wait_event_timeout(C.pointer_bits(0 as uint), timeout_milliseconds as int32)
}

func display_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let display = Display.Id(value:C.load<uint32>(address, 16 as uint))
    let plain = Events.DisplayEvent(display:display, timestamp:timestamp)
    if kind == 0x151 {
        return Events.Event.display_orientation_changed(Events.DisplayOrientationEvent(
            display:display,
            orientation:display_orientation(C.load<int32>(address, 20 as uint)),
            timestamp:timestamp
        ))
    }
    if kind == 0x152 { return Events.Event.display_added(plain) }
    if kind == 0x153 { return Events.Event.display_removed(plain) }
    if kind == 0x154 { return Events.Event.display_moved(plain) }
    if kind == 0x155 { return Events.Event.display_desktop_mode_changed(plain) }
    if kind == 0x156 { return Events.Event.display_current_mode_changed(plain) }
    if kind == 0x157 { return Events.Event.display_content_scale_changed(plain) }
    return Events.Event.display_usable_bounds_changed(plain)
}

func window_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let window = Window.Id(value:C.load<uint32>(address, 16 as uint))
    let plain = Events.WindowEvent(window:window, timestamp:timestamp)
    if kind == 0x202 { return Events.Event.window_shown(plain) }
    if kind == 0x203 { return Events.Event.window_hidden(plain) }
    if kind == 0x204 { return Events.Event.window_exposed(Events.WindowExposedEvent(window:window, live_resize:C.load<int32>(address, 20 as uint) != 0, timestamp:timestamp)) }
    if kind == 0x205 { return Events.Event.window_moved(Events.WindowPositionEvent(window:window, position:Math.Vec2(C.load<int32>(address, 20 as uint) as float, C.load<int32>(address, 24 as uint) as float), timestamp:timestamp)) }
    if kind == 0x206 { return Events.Event.window_resized(window_size(address, window, timestamp)) }
    if kind == 0x207 { return Events.Event.window_pixel_size_changed(window_size(address, window, timestamp)) }
    if kind == 0x208 { return Events.Event.window_metal_view_resized(window_size(address, window, timestamp)) }
    if kind == 0x209 { return Events.Event.window_minimized(plain) }
    if kind == 0x20a { return Events.Event.window_maximized(plain) }
    if kind == 0x20b { return Events.Event.window_restored(plain) }
    if kind == 0x20c { return Events.Event.window_mouse_entered(plain) }
    if kind == 0x20d { return Events.Event.window_mouse_left(plain) }
    if kind == 0x20e { return Events.Event.window_focus_gained(plain) }
    if kind == 0x20f { return Events.Event.window_focus_lost(plain) }
    if kind == 0x210 { return Events.Event.window_close_requested(plain) }
    if kind == 0x211 { return Events.Event.window_hit_test(plain) }
    if kind == 0x212 { return Events.Event.window_icc_profile_changed(plain) }
    if kind == 0x213 { return Events.Event.window_display_changed(Events.WindowDisplayEvent(window:window, display:Display.Id(value:C.load<uint32>(address, 20 as uint)), timestamp:timestamp)) }
    if kind == 0x214 { return Events.Event.window_display_scale_changed(plain) }
    if kind == 0x215 { return Events.Event.window_safe_area_changed(plain) }
    if kind == 0x216 { return Events.Event.window_occluded(plain) }
    if kind == 0x217 { return Events.Event.window_entered_fullscreen(plain) }
    if kind == 0x218 { return Events.Event.window_left_fullscreen(plain) }
    if kind == 0x219 { return Events.Event.window_destroyed(plain) }
    return Events.Event.window_hdr_state_changed(plain)
}

func window_size(address:uint, window:Window.Id, timestamp:Events.Timestamp) Events.WindowSizeEvent {
    return Events.WindowSizeEvent(
        window:window,
        size:Math.Vec2(C.load<int32>(address, 20 as uint) as float, C.load<int32>(address, 24 as uint) as float),
        timestamp:timestamp
    )
}

func keyboard_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    if kind == 0x304 { return Events.Event.keymap_changed(Events.Meta(timestamp:timestamp)) }
    if kind == 0x305 || kind == 0x306 {
        let event = Events.KeyboardDeviceEvent(keyboard:Keyboard.KeyboardId(value:C.load<uint32>(address, 16 as uint)), timestamp:timestamp)
        if kind == 0x305 { return Events.Event.keyboard_added(event) }
        return Events.Event.keyboard_removed(event)
    }
    if kind == 0x307 { return Events.Event.text_editing_candidates(Events.TextCandidatesEvent(
        window:Window.Id(value:C.load<uint32>(address, 16 as uint)),
        candidates:copy_text_array(C.load<uint>(address, 24 as uint), C.load<int32>(address, 32 as uint) as int),
        selected:C.load<int32>(address, 36 as uint) as int,
        horizontal:C.load<uint8>(address, 40 as uint) != 0,
        timestamp:timestamp
    )) }
    if kind == 0x308 { return Events.Event.screen_keyboard_shown(Events.Meta(timestamp:timestamp)) }
    if kind == 0x309 { return Events.Event.screen_keyboard_hidden(Events.Meta(timestamp:timestamp)) }
    if kind == 0x302 { return Events.Event.text_editing(Events.TextEditingEvent(
        window:Window.Id(value:C.load<uint32>(address, 16 as uint)),
        text:copy_text(C.load<uint>(address, 24 as uint)),
        start:C.load<int32>(address, 32 as uint) as int,
        length:C.load<int32>(address, 36 as uint) as int,
        timestamp:timestamp
    )) }
    if kind == 0x303 { return Events.Event.text_input(Events.TextInputEvent(
        window:Window.Id(value:C.load<uint32>(address, 16 as uint)),
        text:copy_text(C.load<uint>(address, 24 as uint)),
        timestamp:timestamp
    )) }
    let key = Events.KeyEvent(
        window:Window.Id(value:C.load<uint32>(address, 16 as uint)),
        keyboard:Keyboard.KeyboardId(value:C.load<uint32>(address, 20 as uint)),
        key:key_from_scancode(C.load<int32>(address, 24 as uint)),
        keycode:C.load<uint32>(address, 28 as uint),
        raw:C.load<uint16>(address, 34 as uint),
        repeated:C.load<uint8>(address, 37 as uint) != 0,
        modifiers:modifiers(C.load<uint16>(address, 32 as uint)),
        timestamp:timestamp
    )
    if kind == 0x300 { return Events.Event.key_pressed(key) }
    return Events.Event.key_released(key)
}

func mouse_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    if kind == 0x404 || kind == 0x405 {
        let event = Events.MouseDeviceEvent(mouse:Pointer.MouseId(value:C.load<uint32>(address, 16 as uint)), timestamp:timestamp)
        if kind == 0x404 { return Events.Event.mouse_added(event) }
        return Events.Event.mouse_removed(event)
    }
    let window = Window.Id(value:C.load<uint32>(address, 16 as uint))
    let mouse = Pointer.MouseId(value:C.load<uint32>(address, 20 as uint))
    if kind == 0x400 { return Events.Event.mouse_moved(Events.MouseMotionEvent(
        window:window, mouse:mouse, buttons:C.load<uint32>(address, 24 as uint),
        position:Math.Vec2(load_float(address, 28), load_float(address, 32)),
        delta:Math.Vec2(load_float(address, 36), load_float(address, 40)), relative:relative_mouse_source(mouse), timestamp:timestamp
    )) }
    if kind == 0x403 { return Events.Event.mouse_wheel(Events.MouseWheelEvent(
        window:window, mouse:mouse,
        delta:Math.Vec2(load_float(address, 24), load_float(address, 28)),
        integer_delta:Math.Vec2(C.load<int32>(address, 44 as uint) as float, C.load<int32>(address, 48 as uint) as float),
        position:Math.Vec2(load_float(address, 36), load_float(address, 40)),
        flipped:C.load<int32>(address, 32 as uint) == 1, timestamp:timestamp
    )) }
    let button = Events.MouseButtonEvent(
        window:window, mouse:mouse, button:mouse_button(C.load<uint8>(address, 24 as uint)),
        down:kind == 0x401, clicks:C.load<uint8>(address, 26 as uint),
        position:Math.Vec2(load_float(address, 28), load_float(address, 32)), timestamp:timestamp
    )
    if kind == 0x401 { return Events.Event.mouse_button_pressed(button) }
    return Events.Event.mouse_button_released(button)
}

func joystick_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let id = Events.JoystickId(value:C.load<uint32>(address, 16 as uint))
    if kind == 0x600 { return Events.Event.joystick_axis_moved(Events.JoystickAxisEvent(joystick:id, axis:C.load<uint8>(address, 20 as uint), value:normalize_axis(C.load<int16>(address, 24 as uint)), timestamp:timestamp)) }
    if kind == 0x601 { return Events.Event.joystick_ball_moved(Events.JoystickBallEvent(joystick:id, ball:C.load<uint8>(address, 20 as uint), delta:Math.Vec2(C.load<int16>(address, 24 as uint) as float, C.load<int16>(address, 26 as uint) as float), timestamp:timestamp)) }
    if kind == 0x602 { return Events.Event.joystick_hat_moved(Events.JoystickHatEvent(joystick:id, hat:C.load<uint8>(address, 20 as uint), value:hat(C.load<uint8>(address, 21 as uint)), timestamp:timestamp)) }
    if kind == 0x603 || kind == 0x604 {
        let event = Events.JoystickButtonEvent(joystick:id, button:C.load<uint8>(address, 20 as uint), down:kind == 0x603, timestamp:timestamp)
        if kind == 0x603 { return Events.Event.joystick_button_pressed(event) }
        return Events.Event.joystick_button_released(event)
    }
    let device = Events.JoystickDeviceEvent(joystick:id, timestamp:timestamp)
    if kind == 0x605 { return Events.Event.joystick_added(device) }
    if kind == 0x606 { return Events.Event.joystick_removed(device) }
    if kind == 0x607 { return Events.Event.joystick_battery_updated(Events.JoystickBatteryEvent(joystick:id, state:power_state(C.load<int32>(address, 20 as uint)), percent:C.load<int32>(address, 24 as uint) as int, timestamp:timestamp)) }
    return Events.Event.joystick_update_complete(device)
}

func gamepad_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let id = Events.GamepadId(value:C.load<uint32>(address, 16 as uint))
    if kind == 0x650 { return Events.Event.gamepad_axis_moved(Events.GamepadAxisEvent(gamepad:id, axis:gamepad_axis(C.load<uint8>(address, 20 as uint)), value:normalize_axis(C.load<int16>(address, 24 as uint)), timestamp:timestamp)) }
    if kind == 0x651 || kind == 0x652 {
        let event = Events.GamepadButtonEvent(gamepad:id, button:gamepad_button(C.load<uint8>(address, 20 as uint)), down:kind == 0x651, timestamp:timestamp)
        if kind == 0x651 { return Events.Event.gamepad_button_pressed(event) }
        return Events.Event.gamepad_button_released(event)
    }
    let device = Events.GamepadDeviceEvent(gamepad:id, timestamp:timestamp)
    if kind == 0x653 { return Events.Event.gamepad_added(device) }
    if kind == 0x654 { return Events.Event.gamepad_removed(device) }
    if kind == 0x655 { return Events.Event.gamepad_remapped(device) }
    if kind >= 0x656 && kind <= 0x658 {
        let touch = Events.GamepadTouchEvent(gamepad:id, touchpad:C.load<int32>(address, 20 as uint) as int, finger:C.load<int32>(address, 24 as uint) as int, position:Math.Vec2(load_float(address, 28), load_float(address, 32)), pressure:load_float(address, 36), timestamp:timestamp)
        if kind == 0x656 { return Events.Event.gamepad_touchpad_pressed(touch) }
        if kind == 0x657 { return Events.Event.gamepad_touchpad_moved(touch) }
        return Events.Event.gamepad_touchpad_released(touch)
    }
    if kind == 0x659 { return Events.Event.gamepad_sensor_updated(Events.GamepadSensorEvent(gamepad:id, sensor:sensor_type(C.load<int32>(address, 20 as uint)), values:float_values(address, 24, 3), sensor_timestamp:Events.Timestamp(nanoseconds:C.load<uint>(address, 40 as uint)), timestamp:timestamp)) }
    if kind == 0x65a { return Events.Event.gamepad_update_complete(device) }
    return Events.Event.gamepad_steam_handle_updated(device)
}

func touch_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let event = Events.TouchEvent(
        touch:Events.TouchId(value:C.load<uint>(address, 16 as uint)), finger:Events.FingerId(value:C.load<uint>(address, 24 as uint)),
        window:Window.Id(value:C.load<uint32>(address, 52 as uint)),
        position:Math.Vec2(load_float(address, 32), load_float(address, 36)),
        delta:Math.Vec2(load_float(address, 40), load_float(address, 44)), pressure:load_float(address, 48), timestamp:timestamp
    )
    if kind == 0x700 { return Events.Event.finger_pressed(event) }
    if kind == 0x701 { return Events.Event.finger_released(event) }
    if kind == 0x702 { return Events.Event.finger_moved(event) }
    return Events.Event.finger_canceled(event)
}

func pinch_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let event = Events.PinchEvent(window:Window.Id(value:C.load<uint32>(address, 20 as uint)), scale:load_float(address, 16), timestamp:timestamp)
    if kind == 0x710 { return Events.Event.pinch_began(event) }
    if kind == 0x711 { return Events.Event.pinch_updated(event) }
    return Events.Event.pinch_ended(event)
}

func clipboard_event(address:uint, timestamp:Events.Timestamp) Events.Event {
    return Events.Event.clipboard_updated(Events.ClipboardEvent(
        owned:C.load<uint8>(address, 16 as uint) != 0,
        mime_types:copy_text_array(C.load<uint>(address, 24 as uint), C.load<int32>(address, 20 as uint) as int),
        timestamp:timestamp
    ))
}

func drop_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let event = Events.DropEvent(
        window:Window.Id(value:C.load<uint32>(address, 16 as uint)),
        position:Math.Vec2(load_float(address, 20), load_float(address, 24)),
        source:copy_text(C.load<uint>(address, 32 as uint)), data:copy_text(C.load<uint>(address, 40 as uint)), timestamp:timestamp
    )
    if kind == 0x1000 { return Events.Event.file_dropped(event) }
    if kind == 0x1001 { return Events.Event.text_dropped(event) }
    if kind == 0x1002 { return Events.Event.drop_began(event) }
    if kind == 0x1003 { return Events.Event.drop_completed(event) }
    return Events.Event.drop_position(event)
}

func audio_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let event = Events.AudioDeviceEvent(device:Events.AudioDeviceId(value:C.load<uint32>(address, 16 as uint)), recording:C.load<uint8>(address, 20 as uint) != 0, timestamp:timestamp)
    if kind == 0x1100 { return Events.Event.audio_device_added(event) }
    if kind == 0x1101 { return Events.Event.audio_device_removed(event) }
    return Events.Event.audio_device_format_changed(event)
}

func sensor_event(address:uint, timestamp:Events.Timestamp) Events.Event {
    let id = C.load<uint32>(address, 16 as uint)
    return Events.Event.sensor_updated(Events.SensorEvent(sensor:Events.SensorId(value:id), kind:sensor_type(sdl_get_sensor_type(id)), values:float_values(address, 20, 6), sensor_timestamp:Events.Timestamp(nanoseconds:C.load<uint>(address, 48 as uint)), timestamp:timestamp))
}

func pen_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let window = Window.Id(value:C.load<uint32>(address, 16 as uint))
    let pen = Events.PenId(value:C.load<uint32>(address, 20 as uint))
    if kind == 0x1300 || kind == 0x1301 {
        let proximity = Events.PenProximityEvent(pen:pen, window:window, timestamp:timestamp)
        if kind == 0x1300 { return Events.Event.pen_entered(proximity) }
        return Events.Event.pen_left(proximity)
    }
    let state = C.load<uint32>(address, 24 as uint)
    let position = Math.Vec2(load_float(address, 28), load_float(address, 32))
    let plain = Events.PenEvent(pen:pen, window:window, state:state, position:position, timestamp:timestamp)
    if kind == 0x1302 || kind == 0x1303 {
        let touch = Events.PenTouchEvent(pen:pen, window:window, state:state, position:position, eraser:C.load<uint8>(address, 36 as uint) != 0, down:kind == 0x1302, timestamp:timestamp)
        if kind == 0x1302 { return Events.Event.pen_pressed(touch) }
        return Events.Event.pen_released(touch)
    }
    if kind == 0x1304 || kind == 0x1305 {
        let button = Events.PenButtonEvent(pen:pen, window:window, state:state, position:position, button:C.load<uint8>(address, 36 as uint), down:kind == 0x1304, timestamp:timestamp)
        if kind == 0x1304 { return Events.Event.pen_button_pressed(button) }
        return Events.Event.pen_button_released(button)
    }
    if kind == 0x1306 { return Events.Event.pen_moved(plain) }
    return Events.Event.pen_axis_changed(Events.PenAxisEvent(pen:pen, window:window, state:state, position:position, axis:pen_axis(C.load<int32>(address, 36 as uint)), value:load_float(address, 40), timestamp:timestamp))
}

func camera_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let event = Events.CameraEvent(camera:Events.CameraId(value:C.load<uint32>(address, 16 as uint)), timestamp:timestamp)
    if kind == 0x1400 { return Events.Event.camera_device_added(event) }
    if kind == 0x1401 { return Events.Event.camera_device_removed(event) }
    if kind == 0x1402 { return Events.Event.camera_device_approved(event) }
    return Events.Event.camera_device_denied(event)
}

func render_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let event = Events.RenderEvent(window:Window.Id(value:C.load<uint32>(address, 16 as uint)), timestamp:timestamp)
    if kind == 0x2000 { return Events.Event.render_targets_reset(event) }
    if kind == 0x2001 { return Events.Event.render_device_reset(event) }
    return Events.Event.render_device_lost(event)
}

func custom_event(address:uint, kind:uint32, timestamp:Events.Timestamp) Events.Event {
    let value = C.load<uint32>(address, 16 as uint)
    var window:Window.Id? = null
    if value != 0 { window = Window.Id(value:value) }
    return Events.Event.custom(Events.CustomEvent(kind:kind, window:window, code:C.load<int32>(address, 20 as uint), timestamp:timestamp))
}

func display_orientation(value:int32) Display.Orientation {
    if value == 1 { return Display.Orientation.landscape }
    if value == 2 { return Display.Orientation.landscape_flipped }
    if value == 3 { return Display.Orientation.portrait }
    if value == 4 { return Display.Orientation.portrait_flipped }
    return Display.Orientation.unknown
}

func system_theme(value:int32) Events.SystemTheme {
    if value == 1 { return Events.SystemTheme.light }
    if value == 2 { return Events.SystemTheme.dark }
    return Events.SystemTheme.unknown
}

func load_float(address:uint, offset:int) float { return C.load<float32>(address, offset as uint) as float }

func float_values(address:uint, offset:int, count:int) float[] {
    var result:float[] = []
    var index = 0
    while index < count { result.append(load_float(address, offset + index * 4)); index++ }
    return result
}

func normalize_axis(value:int16) float {
    if value < 0 { return (value as float) / 32768.0 }
    return (value as float) / 32767.0
}

func relative_mouse_source(mouse:Pointer.MouseId) bool {
    return mouse.value != 0 && mouse.value < 0xffff_fffe
}

