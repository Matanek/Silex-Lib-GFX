func letter_key(value:int32) Keyboard.Key {
    if value == 4 { return Keyboard.Key.a }
    if value == 5 { return Keyboard.Key.b }
    if value == 6 { return Keyboard.Key.c }
    if value == 7 { return Keyboard.Key.d }
    if value == 8 { return Keyboard.Key.e }
