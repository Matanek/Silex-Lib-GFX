public struct Modifiers {
    let shift:bool
    let control:bool
    let alt:bool
    let system:bool
    let left_shift:bool
    let right_shift:bool
    let level5:bool
    let left_control:bool
    let right_control:bool
    let left_alt:bool
    let right_alt:bool
    let left_system:bool
    let right_system:bool
    let mode:bool
    let caps_lock:bool
    let num_lock:bool
    let scroll_lock:bool
}

public struct KeyboardId { let value:uint32 }
