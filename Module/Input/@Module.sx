    var result:Events.PenState[] = []
    for value in values { if value.pen != removed { result.append(value) } }
    return result
}

func empty_pen(id:Events.PenId, window:Window.Id, timestamp:Events.Timestamp) Events.PenState {
    return Events.PenState(
        pen:id, window:window, position:Math.Vec2(), input:0,
        in_proximity:true, down:false, eraser:false, buttons:0 as uint,
        buttons_pressed:0 as uint, buttons_released:0 as uint,
        pressure:0.0, tilt_x:0.0, tilt_y:0.0, distance:0.0, rotation:0.0,
        slider:0.0, tangential_pressure:0.0, timestamp:timestamp
    )
}

func pen_with_input(old:Events.PenState, window:Window.Id, input:uint32, position:Math.Vec2, eraser:bool, timestamp:Events.Timestamp) Events.PenState {
    let buttons = ((input >> 1) & 31) as uint
    let changed = buttons ^ old.buttons
    return Events.PenState(
        pen:old.pen, window:window, position:position, input:input,
        in_proximity:(input & 0x8000_0000) != 0, down:(input & 1) != 0,
        eraser:eraser || (input & 0x4000_0000) != 0, buttons:buttons,
        buttons_pressed:merge_button_bits(old.buttons_pressed, changed & buttons),
        buttons_released:merge_button_bits(old.buttons_released, changed & old.buttons),
        pressure:old.pressure, tilt_x:old.tilt_x, tilt_y:old.tilt_y, distance:old.distance,
        rotation:old.rotation, slider:old.slider, tangential_pressure:old.tangential_pressure,
        timestamp:timestamp
    )
}

func pen_with_axis(old:Events.PenState, axis:Events.PenAxis, value:float) Events.PenState {
    var pressure = old.pressure
    var tilt_x = old.tilt_x
    var tilt_y = old.tilt_y
    var distance = old.distance
    var rotation = old.rotation
    var slider = old.slider
    var tangential = old.tangential_pressure
    match axis {
        pressure => { pressure = value }
        tilt_x => { tilt_x = value }
        tilt_y => { tilt_y = value }
        distance => { distance = value }
        rotation => { rotation = value }
        slider => { slider = value }
        tangential_pressure => { tangential = value }
        unknown(code) => {}
    }
    return Events.PenState(
        pen:old.pen, window:old.window, position:old.position, input:old.input,
        in_proximity:old.in_proximity, down:old.down, eraser:old.eraser, buttons:old.buttons,
        buttons_pressed:old.buttons_pressed, buttons_released:old.buttons_released,
        pressure:pressure, tilt_x:tilt_x, tilt_y:tilt_y, distance:distance,
        rotation:rotation, slider:slider, tangential_pressure:tangential, timestamp:old.timestamp
    )
}

func clear_pen_transitions(old:Events.PenState) Events.PenState {
    return Events.PenState(
        pen:old.pen, window:old.window, position:old.position, input:old.input,
        in_proximity:old.in_proximity, down:old.down, eraser:old.eraser, buttons:old.buttons,
        buttons_pressed:0 as uint, buttons_released:0 as uint,
        pressure:old.pressure, tilt_x:old.tilt_x, tilt_y:old.tilt_y, distance:old.distance,
        rotation:old.rotation, slider:old.slider, tangential_pressure:old.tangential_pressure,
        timestamp:old.timestamp
    )
}

func merge_button_bits(current:uint, added:uint) uint {
    return current ^ (added & (current ^ 31 as uint))
}

func initialize_runtime() {
    if sdl_init_subsystem(0x0000_4020 as uint32) == 0 {
        panic("GFX.Input could not initialize the SDL platform subsystems")
    }
}

func shutdown_runtime() { sdl_quit_subsystem(0x0000_4020 as uint32) }

let sdl_init_subsystem = C.function<func(uint32) int32>(library:Boundary.SDL3, name:"SDL_InitSubSystem")
let sdl_quit_subsystem = C.function<func(uint32) void>(library:Boundary.SDL3, name:"SDL_QuitSubSystem")
