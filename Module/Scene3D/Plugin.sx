use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.ECS
use GFX.GPU
use GFX.Rendering
use GFX.Scene3D.Meshes
use GFX.Scene3D.Renderer
use GFX.Scene3D.ToneMapping
use GFX.Window

public struct Plugin:PluginProtocol {
    func id() str { return "GFX.Scene3D.Plugin" }

    func build(application:&Application) {
        application.add_plugin(ECS.Plugin())
        application.add_plugin(Rendering.Plugin())
        if !application.resources().has<Meshes>() { application.add_resource(Meshes()) }
        if !application.resources().has<ToneMapping>() { application.add_resource(ToneMapping.aces()) }
        application.add_resource(Renderer())
        {
            var resources = application.resources()
            var rendering = resources.get_mut<Rendering.Renderer>()
            rendering.add_pass("GFX.Scene3D", render_scene, depth:true)
        }
        application.add_system(Schedule.startup, start_scene)
        application.add_system(Schedule.render, update_viewport)
        application.add_system(Schedule.render, update_tone_mapping)
        application.add_system(Schedule.render, prepare_scene)
        application.add_system(Schedule.shutdown, stop_scene)
    }
}

func start_scene(device:@GPU.Device, surface:@GPU.Surface, renderer:&Renderer) {
    renderer.start(device, surface)
}

func update_viewport(window:@Window, renderer:&Renderer) {
    renderer.set_viewport(window.pixel_size())
}

func update_tone_mapping(tone_mapping:@ToneMapping, renderer:&Renderer) {
    renderer.set_tone_mapping(tone_mapping)
}

func prepare_scene(
    device:@GPU.Device,
    world:@ECS.World,
    meshes:@Meshes,
    renderer:&Renderer
) {
    renderer.prepare(device, world, meshes)
}

func render_scene(pass:@GPU.RenderPass, application:@Application) {
    var renderer = application.resources().get<Renderer>()
    renderer.draw(pass)
}

func stop_scene(application:Application) {
    var removed = application.resources().remove<Renderer>()
    assert(removed != null)
}
