public struct Shadow {
    var enabled:bool
    var near_plane:float
    var bias:float
    var normal_offset:float
    var softness:float

    public init(
        enabled:bool = true,
        near_plane:float = 0.05,
        bias:float = 0.0006,
        normal_offset:float = 0.00005,
        softness:float = 0.0
    ) {
        self.enabled = enabled
        self.near_plane = near_plane
        self.bias = bias
        self.normal_offset = normal_offset
        self.softness = softness
    }

    public static func sun() Shadow {
        return Shadow(near_plane:0.1, bias:0.00085, normal_offset:0.003)
    }

    public static func projector() Shadow {
        return Shadow(near_plane:0.05, bias:0.00085, normal_offset:0.003)
    }
}
